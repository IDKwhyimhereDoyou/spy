local function lowerCopy(list)
	local out = {}
	for i, word in ipairs(list) do
		out[i] = string.lower(word)
	end
	return out
end
MOVEMENT_KEYWORDS = lowerCopy(MOVEMENT_KEYWORDS)
ANTI_KEYWORDS = lowerCopy(ANTI_KEYWORDS)
ITEM_KEYWORDS = lowerCopy(ITEM_KEYWORDS)
MONEY_KEYWORDS = lowerCopy(MONEY_KEYWORDS)

