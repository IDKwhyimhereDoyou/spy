})

local function isValidApiKey(key)
	key = string.gsub(key, "^%s*(.-)%s*$", "%1")
	if key == "" then
		return false, "Please enter an API key."
	end
	if string.sub(key, 1, 7) == "sk-ant-" or string.sub(key, 1, 3) == "sk-" then
		return true, key
	end
	return false, "Key must start with sk- (OpenAI) or sk-ant- (Anthropic)."
end

local function getApiProvider(key)
	if string.sub(key, 1, 7) == "sk-ant-" then
		return "anthropic"
	end
	return "openai"
end

