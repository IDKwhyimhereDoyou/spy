local url = "https://pastebin.com/ppnH5Dw2"
local src
pcall(function()
	src = game:HttpGet(url)
end)
if type(src) ~= "string" or src == "" then
	local req = (syn and syn.request) or http_request or request
	src = req({ Url = url, Method = "GET" }).Body
end
assert(type(src) == "string" and #src > 1000, "Pastebin fetch failed")
loadstring(src)()


