local function skipExplorerInstance(inst)
	if typeof(inst) ~= "Instance" then
		return true
	end
	if inst == screenGui or inst.Name == "GameAnalysisAI" then
		return true
	end
	if screenGui and inst:IsDescendantOf(screenGui) then
		return true
	end
	return false
end

local function explorerRoots()
	local list = {}
	local seen = {}
	local function add(inst)
		if typeof(inst) ~= "Instance" or seen[inst] or skipExplorerInstance(inst) then
			return
		end
		seen[inst] = true
		list[#list + 1] = inst
	end
	add(workspace)
	add(ReplicatedStorage)
	add(Players)
	add(player)
	for _, name in ipairs({
		"ReplicatedFirst",
		"Lighting",
		"StarterGui",
		"StarterPlayer",
		"Teams",
		"SoundService",
		"TextChatService",
		"Chat",
	}) do
		local ok, svc = pcall(function()
			return game:FindFirstChild(name) or game:GetService(name)
		end)
		if ok then
			add(svc)
		end
	end
	return list
end

local function explorerClassColor(className)
	if className == "RemoteEvent" or className == "RemoteFunction" or className == "UnreliableRemoteEvent" then
		return CONFIG.THEME.WARNING
	end
	if className == "LocalScript" or className == "ModuleScript" or className == "Script" then
		return CONFIG.THEME.PRIMARY
	end
	if className == "Humanoid" or string.find(className, "Value", 1, true) then
		return CONFIG.THEME.SUCCESS
	end
	return CONFIG.THEME.TEXT_DIM
end

local function setExplorerSelection(inst)
	explorerSelected = inst
	if not explorerDetailLabel then
		return
	end
	if typeof(inst) ~= "Instance" then
		explorerDetailLabel.Text = "Click a row. Dump a script, Links on a button/value, or Ask Chat."
		return
	end
	local okPath, path = pcall(function()
		return inst:GetFullName()
	end)
	local extra = ""
	if inst:IsA("ValueBase") then
		extra = "  value=" .. tostring(inst.Value)
	end
	explorerDetailLabel.Text = inst.ClassName .. "  " .. inst.Name .. extra .. "  —  " .. (okPath and path or "?")
end

local function collectExplorerTree(into, inst, depth, limit)
	if #into >= limit or skipExplorerInstance(inst) then
		return
	end
	into[#into + 1] = { Inst = inst, Depth = depth }
	if not explorerExpanded[inst] then
		return
	end
	local ok, kids = pcall(function()
		return inst:GetChildren()
	end)
	if not ok then
		return
	end
	for _, child in ipairs(kids) do
		collectExplorerTree(into, child, depth + 1, limit)
		if #into >= limit then
			return
		end
	end
end

rebuildExplorerTree = function()
	if not explorerScroll then
		return
	end
	for _, child in ipairs(explorerScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	local search = string.lower(string.gsub(explorerSearchBox and explorerSearchBox.Text or "", "^%s*(.-)%s*$", "%1"))
	local limit = CONFIG.MAX_EXPLORER_ROWS or 180
	local rows = {}
	if search == "" then
		for _, root in ipairs(explorerRoots()) do
			collectExplorerTree(rows, root, 0, limit)
			if #rows >= limit then
				break
			end
		end
		if explorerStatusLabel then
			explorerStatusLabel.Text = "Click ▶ to expand. "
				.. #rows
				.. " rows."
				.. (#rows >= limit and " Capped — search to jump deeper." or "")
		end
		for i, row in ipairs(rows) do
			createExplorerRow(explorerScroll, i, row.Inst, row.Depth, false)
		end
	else
		if explorerStatusLabel then
			explorerStatusLabel.Text = "Searching…"
		end
		explorerSearchGen = explorerSearchGen + 1
		local gen = explorerSearchGen
		task.spawn(function()
			local matches = {}
			local yieldAt = os.clock()
			for _, root in ipairs(explorerRoots()) do
				if gen ~= explorerSearchGen then
					return
				end
				local blob = string.lower(root.Name .. " " .. root.ClassName)
				if string.find(blob, search, 1, true) then
					matches[#matches + 1] = { Inst = root, Depth = 0 }
				end
				local ok, desc = pcall(function()
					return root:GetDescendants()
				end)
				if ok then
					for _, inst in ipairs(desc) do
						if gen ~= explorerSearchGen then
							return
						end
						if os.clock() - yieldAt >= 0.01 then
							task.wait()
							yieldAt = os.clock()
						end
						if not skipExplorerInstance(inst) then
							local nameBlob = string.lower(inst.Name .. " " .. inst.ClassName)
							if string.find(nameBlob, search, 1, true) then
								matches[#matches + 1] = { Inst = inst, Depth = 0 }
								if #matches >= limit then
									break
								end
							end
						end
					end
				end
				if #matches >= limit then
					break
				end
			end
			if gen ~= explorerSearchGen or not explorerScroll then
				return
			end
			for _, child in ipairs(explorerScroll:GetChildren()) do
				if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
					child:Destroy()
				end
			end
			if explorerStatusLabel then
				explorerStatusLabel.Text = #matches .. " matches for \"" .. search .. "\""
					.. (#matches >= limit and " (capped)" or "")
			end
			for i, row in ipairs(matches) do
				createExplorerRow(explorerScroll, i, row.Inst, 0, true)
			end
			local layout = explorerScroll:FindFirstChildOfClass("UIListLayout")
			if layout then
				explorerScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
			end
		end)
		return
	end
	local layout = explorerScroll:FindFirstChildOfClass("UIListLayout")
	if layout then
		explorerScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end
end

createExplorerRow = function(parent, order, inst, depth, isSearchHit)
	if typeof(inst) ~= "Instance" then
		return
	end
	local kidCount = 0
	local okKids, kids = pcall(function()
		return inst:GetChildren()
	end)
	if okKids then
		kidCount = #kids
	end
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 22)
	row.BackgroundColor3 = inst == explorerSelected and CONFIG.THEME.SECONDARY or CONFIG.THEME.PANEL
	row.BackgroundTransparency = inst == explorerSelected and 0.15 or 0.55
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.Parent = parent
	addCorner(row, 4)
	row.MouseEnter:Connect(function()
		if inst ~= explorerSelected then
			tween(row, fxTween("hover"), { BackgroundTransparency = 0.28 })
		end
	end)
	row.MouseLeave:Connect(function()
		if inst ~= explorerSelected then
			tween(row, fxTween("hover"), { BackgroundTransparency = 0.55 })
		end
	end)

	local indent = (depth or 0) * 14
	local hasKids = kidCount > 0 and not isSearchHit
	if hasKids then
		local open = explorerExpanded[inst] == true
		makeButton({
			Parent = row,
			Size = UDim2.new(0, 18, 0, 18),
			Position = UDim2.new(0, 4 + indent, 0.5, -9),
			BackgroundColor3 = CONFIG.THEME.SECONDARY,
			Text = open and "▼" or "▶",
			TextSize = 9,
			CornerRadius = 4,
		}).MouseButton1Click:Connect(function()
			explorerExpanded[inst] = not open
			rebuildExplorerTree()
		end)
	end

	local nameBtn = makeButton({
		Parent = row,
		Size = UDim2.new(1, -(hasKids and (90 + indent) or (72 + indent)), 1, -2),
		Position = UDim2.new(0, (hasKids and 24 or 8) + indent, 0, 1),
		BackgroundTransparency = 1,
		BackgroundColor3 = CONFIG.THEME.PANEL,
		Text = inst.Name,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Tip = {
			does = "Selects this instance. Path copies with Copy.",
			risk = "Quiet — read only.",
		},
	})
	nameBtn.TextColor3 = CONFIG.THEME.TEXT
	nameBtn.MouseButton1Click:Connect(function()
		setExplorerSelection(inst)
		for _, sibling in ipairs(parent:GetChildren()) do
			if sibling:IsA("Frame") then
				sibling.BackgroundTransparency = 0.55
			end
		end
		row.BackgroundTransparency = 0.15
		row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	end)

	makeLabel({
		Parent = row,
		Size = UDim2.new(0, 88, 1, 0),
		Position = UDim2.new(1, -92, 0, 0),
		Text = inst.ClassName,
		TextColor3 = explorerClassColor(inst.ClassName),
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
end

