	dashboardPage = Instance.new("ScrollingFrame")
	dashboardPage.Name = "Dashboard"
	dashboardPage.BackgroundTransparency = 1
	dashboardPage.BorderSizePixel = 0
	dashboardPage.ScrollBarThickness = 4
	dashboardPage.ScrollBarImageTransparency = 0.35
	dashboardPage.CanvasSize = UDim2.new(0, 0, 0, 620)
	dashboardPage.Visible = false
	dashboardPage.Parent = contentHost

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = dashboardPage

	makeLabel({
		Parent = dashboardPage,
