local function truncateText(text, limit)
	limit = limit or CONFIG.MAX_RESPONSE_LENGTH
	if type(text) ~= "string" then
		text = tostring(text)
	end
	if #text > limit then
		return string.sub(text, 1, limit) .. "..."
	end
	return text
end

local function mergeArrays(...)
	local out = {}
	for i = 1, select("#", ...) do
		local list = select(i, ...)
		if type(list) == "table" then
			for _, item in ipairs(list) do
				table.insert(out, item)
			end
		end
	end
	return out
end

local function forEachInstance(list, fn, maxN)
	if type(list) ~= "table" or type(fn) ~= "function" then
		return
	end
	maxN = tonumber(maxN)
	local n = 0
	local function touch(value)
		if maxN and n >= maxN then
			return false
		end
		if typeof(value) == "Instance" then
			n = n + 1
			fn(value)
		end
		return not (maxN and n >= maxN)
	end
	local len = #list
	if len > 0 then
		for i = 1, len do
			if not touch(list[i]) then
				return
			end
		end
		return
	end
	local seen = {}
	for _, value in pairs(list) do
		if typeof(value) == "Instance" and not seen[value] then
			seen[value] = true
			if not touch(value) then
				return
			end
		end
	end
end

local ECONOMY_KEYWORDS = mergeArrays(MONEY_KEYWORDS, {
