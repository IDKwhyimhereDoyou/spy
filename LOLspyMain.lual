local function shutdownSession()
	stopLookPulse()
	pcall(function()
		if spyEnabled then
			setSpyEnabled(false)
		end
	end)
	pcall(stopRemoteWatch)
	pcall(stopIncomingSpy)
	for _, conn in ipairs(humWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	for _, conn in ipairs(statWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	humWatchConns = {}
	statWatchConns = {}
	if hotkeyConn then
		pcall(function()
			hotkeyConn:Disconnect()
		end)
		hotkeyConn = nil
	end
	waitingHotkeyId = nil
	toastHost = nil
	toastCount = 0
	if screenGui then
		local gui = screenGui
		screenGui = nil
		pcall(function()
			gui:Destroy()
		end)
	end
end

local function wipeOldGuis()
	local function wipe(parent)
		if not parent then
			return
		end
		for _, child in ipairs(parent:GetChildren()) do
			if child.Name == "GameAnalysisAI" and child:IsA("ScreenGui") then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end
	pcall(function()
		wipe(game:GetService("CoreGui"))
	end)
	wipe(playerGui)
	for _, name in ipairs({ "gethui", "gethiddenui", "get_hidden_gui", "gethiddenhui" }) do
		local fn = safeGlobal(name)
		if type(fn) == "function" then
			local ok, hui = pcall(fn)
			if ok then
				wipe(hui)
			end
		end
	end
end

local function createUI()
	local getgenvFn = safeGlobal("getgenv")
	local bag
	if type(getgenvFn) == "function" then
		local ok, env = pcall(getgenvFn)
		if ok and type(env) == "table" then
			bag = env
		end
	end
	if bag and type(bag.GAI_Cleanup) == "function" then
		pcall(bag.GAI_Cleanup)
	end
	wipeOldGuis()
	liveToggles = {}
	themeButtons = {}
	hotkeyButtons = {}
	toastHost = nil
	toastCount = 0
	sfxFolder = nil
	sfxPool = {}
	dashScanLabels = {}
	dashCaptureLabels = {}
	dashRefreshQueued = false
	valueRebuildQueued = false
	searchRebuildQueued = false
	activeSliderDrag = nil
	activeFrameDrag = nil
	loadPrefs()
	if THEMES[CONFIG.THEME_NAME] then
		CONFIG.THEME = THEMES[CONFIG.THEME_NAME]
	end
	toolsMinimized = CONFIG.SIDEBAR_FOLDED and true or false
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "GameAnalysisAI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = true
	screenGui.DisplayOrder = 2147483647
	local parented = parentScreenGui(screenGui)
	createApiKeyGate()
	createMainUI()
	if not parented and screenGui and not screenGui.Parent then
		error("Could not parent the GUI (no gethui, CoreGui, or PlayerGui).")
	end
	applyUiScale()
	if themeLook(CONFIG.THEME_NAME) then
		applyLookStyle(CONFIG.THEME_NAME)
	end
	refreshThemeButtons()
	local s = currentUiScale()
	tween(apiKeyGate, TWEEN_SLIDE, { Position = UDim2.new(0.5, -math.floor(240 * s), 0.5, -math.floor(150 * s)) })
	if bag then
		bag.GAI_Cleanup = shutdownSession
	end
end

local function getScopeForPath(path)
	if player.Character and string.find(path, player.Character:GetFullName(), 1, true) == 1 then
		return "Character"
	end
	if string.find(path, "Players." .. player.Name, 1, true) == 1 then
		return "Player"
	end
	return "Game"
end

local registeredPaths = {}

local function registerValueObject(obj, scopeOverride)
	if not obj:IsA("ValueBase") then
		return
	end
	local path = obj:GetFullName()
	if registeredPaths[path] then
		return
	end
	registeredPaths[path] = true
	table.insert(valueRegistry, {
		Name = obj.Name,
		ClassName = obj.ClassName,
		Path = path,
		Value = tostring(obj.Value),
		Scope = scopeOverride or getScopeForPath(path),
		Instance = obj,
		Ownership = ownershipByPath[path] or "unknown",
	})
end

local function registerAttribute(host, name, value, scopeOverride)
	if typeof(host) ~= "Instance" or type(name) ~= "string" or name == "" then
		return
	end
	local path = host:GetFullName() .. "@" .. name
	if registeredPaths[path] then
		return
	end
	registeredPaths[path] = true
	table.insert(valueRegistry, {
		Name = host.Name .. "." .. name,
		ClassName = "Attribute",
		Path = path,
		AttributeName = name,
		Value = tostring(value),
		Scope = scopeOverride or getScopeForPath(host:GetFullName()),
		Instance = host,
		Ownership = ownershipByPath[path] or "unknown",
	})
end

local function collectAttributesOn(host, scopeOverride)
	if typeof(host) ~= "Instance" then
		return
	end
	local ok, attrs = pcall(function()
		return host:GetAttributes()
	end)
	if not ok or type(attrs) ~= "table" then
		return
	end
	for name, value in pairs(attrs) do
		registerAttribute(host, name, value, scopeOverride)
	end
end

local function refreshCharacterScan()
	local kept = {}
	for _, entry in ipairs(valueRegistry) do
		if entry.Scope == "Character" then
			registeredPaths[entry.Path] = nil
		else
			kept[#kept + 1] = entry
		end
	end
	valueRegistry = kept
	local character = player.Character
	if not character then
		return
	end
	collectAttributesOn(character, "Character")
	local ok, desc = pcall(function()
		return character:GetDescendants()
	end)
	if ok then
		for _, obj in ipairs(desc) do
			if obj:IsA("ValueBase") then
				registerValueObject(obj, "Character")
			end
			collectAttributesOn(obj, "Character")
		end
	end
	watchHumanoidHistory()
	refreshHumanoidPanel()
	if activeMainTab == "Values" then
		rebuildValueExplorer()
	end
	if refreshDashboard and activeMainTab == "Dashboard" then
		refreshDashboard()
	end
end

local function scanPlayerState()
	local snapshot = {
		Name = player.Name,
		UserId = player.UserId,
		Leaderstats = {},
		Character = nil,
		BackpackTools = {},
	}

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		for _, child in ipairs(leaderstats:GetChildren()) do
			if child:IsA("ValueBase") then
				snapshot.Leaderstats[child.Name] = tostring(child.Value)
				registerValueObject(child, "Player")
			end
		end
	end

	for _, child in ipairs(player:GetChildren()) do
		if child:IsA("ValueBase") then
			registerValueObject(child, "Player")
		end
	end
	collectAttributesOn(player, "Player")

	local character = player.Character
	if character then
		local charData = {
			Name = character.Name,
			Path = character:GetFullName(),
			Values = {},
			Attributes = safeGetAttributes(character),
			Humanoid = nil,
		}

		local ok, desc = pcall(function()
			return character:GetDescendants()
		end)
		if ok then
			for _, child in ipairs(desc) do
			if child:IsA("ValueBase") then
				charData.Values[child.Name] = {
					ClassName = child.ClassName,
					Value = tostring(child.Value),
					Path = child:GetFullName(),
				}
				registerValueObject(child, "Character")
			end
			if child:IsA("Humanoid") then
				charData.Humanoid = {
					Health = child.Health,
					MaxHealth = child.MaxHealth,
					WalkSpeed = child.WalkSpeed,
					JumpPower = child.JumpPower,
					JumpHeight = child.JumpHeight,
					Path = child:GetFullName(),
				}
			end
			end
		end

		snapshot.Character = charData
		collectAttributesOn(character, "Character")
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") then
				collectAttributesOn(child, "Character")
			end
		end
	end

	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			table.insert(snapshot.BackpackTools, tool.Name)
			if tool:IsA("Tool") then
				collectAttributesOn(tool, "Player")
			end
		end
	end

	return snapshot
end

local function jsonSafeEntry(entry)
	return {
		Name = entry.Name,
		ClassName = entry.ClassName,
		Path = entry.Path,
		Disabled = entry.Disabled,
		Value = entry.Value,
		Why = entry.Why,
		DecompilePreview = entry.DecompilePreview,
		DecompileError = entry.DecompileError,
	}
end

scanGameStructure = function()
	if scanInProgress then
		return gameData
	end
	scanInProgress = true
	local ok, err = pcall(scanGameStructureUnsafe)
	scanInProgress = false
	if not ok then
		warn("GameAnalysisAI scan: " .. tostring(err))
		if addMessage then
			addMessage("Scan failed: " .. tostring(err), false)
			playThemeSound("error")
		end
	end
	return gameData
end

scanGameStructureUnsafe = function()
	valueRegistry = {}
	antiScriptRegistry = {}
	remoteRegistry = {}
	registeredPaths = {}
	stopRemoteWatch()
	lastBrief = ""
	remoteByPath = {}
	if not placeMemoryLoaded then
		loadPlaceMemory()
		placeMemoryLoaded = true
	end

	local scripts, values, remotes, movementRelated, modules, humanoids, antiCheat, itemRelated = {}, {}, {}, {}, {}, {}, {}, {}
	local antiByPath = {}
	local scanRoots = { workspace, ReplicatedStorage }
	local replicatedFirst = game:FindFirstChild("ReplicatedFirst")
	if replicatedFirst then
		table.insert(scanRoots, replicatedFirst)
	end
	for _, rootName in ipairs({ "StarterGui", "StarterPlayer", "Lighting" }) do
		local service = game:FindFirstChild(rootName)
		if service then
			table.insert(scanRoots, service)
		end
	end
	for _, childName in ipairs({ "Backpack", "StarterGear", "PlayerScripts", "leaderstats" }) do
		local child = player:FindFirstChild(childName)
		if child then
			table.insert(scanRoots, child)
		end
	end

	local seenPaths = {}
	local scanned = 0
	local remoteKeywords = mergeArrays(MOVEMENT_KEYWORDS, ANTI_KEYWORDS)
	local yieldAt = os.clock()
	local yieldSec = tonumber(CONFIG.SCAN_YIELD_SEC) or 0.01
	local function scanYield()
		scanned = scanned + 1
		local every = tonumber(CONFIG.SCAN_YIELD_EVERY) or 400
		if scanned % every == 0 and os.clock() - yieldAt >= yieldSec then
			task.wait()
			yieldAt = os.clock()
		end
	end

	local function rememberAnti(antiEntry)
		if antiByPath[antiEntry.Path] then
			local existing = antiByPath[antiEntry.Path]
			if antiEntry.Why and existing.Why and not string.find(existing.Why, antiEntry.Why, 1, true) then
				existing.Why = existing.Why .. "; " .. antiEntry.Why
			end
			return
		end
		antiByPath[antiEntry.Path] = antiEntry
		table.insert(antiCheat, jsonSafeEntry(antiEntry))
		table.insert(antiScriptRegistry, antiEntry)
	end

	for _, root in ipairs(scanRoots) do
		if root then
			local okDesc, descendants = pcall(function()
				return root:GetDescendants()
			end)
			if okDesc then
				for _, obj in ipairs(descendants) do
					scanYield()
					local className = obj.ClassName
					if SCAN_CLASSES[className] then
						local path = obj:GetFullName()
						if not seenPaths[path] then
							seenPaths[path] = true
							local blob = obj.Name .. " " .. path

							if className == "LocalScript" or className == "Script" then
								local entry = jsonSafeEntry({
									Name = obj.Name,
									ClassName = className,
									Path = path,
									Disabled = obj.Disabled,
								})
								table.insert(scripts, entry)

								if stringContainsKeyword(blob, MOVEMENT_KEYWORDS) then
									table.insert(movementRelated, { Type = "Script", Data = entry })
								end

								if stringContainsKeyword(blob, ANTI_KEYWORDS) then
									rememberAnti({
										Name = obj.Name,
										ClassName = className,
										Path = path,
										Disabled = obj.Disabled,
										Why = "name match",
										Instance = obj,
									})
								end
							elseif className == "ModuleScript" then
								local entry = jsonSafeEntry({ Name = obj.Name, ClassName = className, Path = path })
								table.insert(modules, entry)
								if stringContainsKeyword(blob, MOVEMENT_KEYWORDS) then
									table.insert(movementRelated, { Type = "ModuleScript", Data = entry })
								end
								if stringContainsKeyword(blob, ANTI_KEYWORDS) then
									rememberAnti({
										Name = obj.Name,
										ClassName = className,
										Path = path,
										Why = "name match",
										Instance = obj,
									})
								end
							elseif className == "RemoteEvent" or className == "RemoteFunction" or className == "UnreliableRemoteEvent" then
								local entry = jsonSafeEntry({ Name = obj.Name, ClassName = className, Path = path })
								table.insert(remotes, entry)
								local remoteEntry = {
									Name = obj.Name,
									ClassName = className,
									Path = path,
									Instance = obj,
									Hits = remoteHitCounts[path] or 0,
								}
								table.insert(remoteRegistry, remoteEntry)
								remoteByPath[path] = remoteEntry
								if stringContainsKeyword(blob, remoteKeywords) then
									table.insert(movementRelated, { Type = "Remote", Data = entry })
								end
								if stringContainsKeyword(blob, ITEM_KEYWORDS) or stringContainsKeyword(blob, MONEY_KEYWORDS) then
									table.insert(itemRelated, { Name = obj.Name, Path = path, ClassName = className })
								end
							elseif className == "Humanoid" then
								table.insert(humanoids, {
									Name = obj.Parent and obj.Parent.Name or "?",
									Path = path,
									WalkSpeed = obj.WalkSpeed,
									JumpPower = obj.JumpPower,
								})
							else
								local entry = jsonSafeEntry({
									Name = obj.Name,
									ClassName = className,
									Path = path,
									Value = tostring(obj.Value),
								})
								table.insert(values, entry)
								registerValueObject(obj)
								if stringContainsKeyword(blob, MOVEMENT_KEYWORDS) then
									table.insert(movementRelated, { Type = "Value", Data = entry })
								end
								if stringContainsKeyword(blob, MONEY_KEYWORDS) then
									table.insert(itemRelated, { Name = obj.Name, Path = path, ClassName = className, Value = entry.Value })
								end
							end
						end
					end
				end
			end
		end
	end

	local behavioral, connNote = scanBehavioralAnti()
	for _, item in ipairs(behavioral) do
		rememberAnti({
			Name = item.Name,
			ClassName = item.ClassName,
			Path = item.Path,
			Why = item.Why,
			Instance = item.Instance,
			DecompilePreview = item.DecompilePreview,
		})
	end

	for i, entry in ipairs(antiScriptRegistry) do
		if i > 8 then
			break
		end
		if entry.Instance and (not entry.DecompilePreview or entry.DecompilePreview == "") then
			local src = inspectScript(entry.Instance, CONFIG.MAX_DECOMPILE_CHARS, { gc = i <= 2 })
			if type(src) == "string" then
				entry.DecompilePreview = src
			end
		end
		if antiCheat[i] then
			antiCheat[i].DecompilePreview = entry.DecompilePreview
			antiCheat[i].Why = entry.Why
		end
	end

	gameData.structure = {
		GameName = game.Name,
		PlaceId = game.PlaceId,
		Player = scanPlayerState(),
		MovementRelated = movementRelated,
		AntiCheatScripts = antiCheat,
		Scripts = scripts,
		ModuleScripts = modules,
		Remotes = remotes,
		ItemRelated = itemRelated,
		Values = values,
		Humanoids = humanoids,
		ConnectionNote = connNote,
		ScanNotes = {
			"Ask chat how money or items work. It reads this scan; it cannot grant coins from the client.",
			"A Values Set is one local write to see if the server reverts. If it does, look at remotes.",
			"Dump pulls constants/env strings. Decompile is used only if this executor has it.",
		},
	}
	gameData.lastUpdated = tick()

	local nowKeys = {}
	local added = {}
	local function track(kind, item)
		local key = kind .. ":" .. tostring(item.Path or item.Name)
		nowKeys[key] = true
		if lastScanKeys[key] == nil and next(lastScanKeys) ~= nil then
			added[#added + 1] = item.Name or key
		end
	end
	for _, r in ipairs(remotes) do
		track("r", r)
	end
	for _, v in ipairs(values) do
		track("v", v)
	end
	lastScanKeys = nowKeys
	scanNewNames = added

	collectLoadedModules()
	watchHumanoidHistory()
	watchLeaderstats()
	rebuildValueExplorer()
	rebuildAntiPanel()
	rebuildRemotePanel()
	refreshHumanoidPanel()
	if rebuildCaptureList then
		rebuildCaptureList()
	end
	if refreshDashboard then
		refreshDashboard()
	end
	if spyEnabled then
		startIncomingSpy()
	end
	scheduleMemorySave()
	return gameData
end

local function lineList(prefix, items, n)
	if type(items) ~= "table" or #items == 0 then
		return prefix .. " none"
	end
	local parts = {}
	for i = 1, math.min(#items, n or 6) do
		local item = items[i]
		local name = item.Name or (item.Data and item.Data.Name) or "?"
		local extra = item.Why or item.Value or item.ClassName or (item.Data and item.Data.Path) or item.Path
		table.insert(parts, name .. (extra and (" (" .. tostring(extra) .. ")") or ""))
	end
	return prefix .. table.concat(parts, "; ")
end

local function collectEconomyHits(cap)
	cap = cap or 10
	local hits = {}
	local seen = {}
	local function add(kind, name, path, value)
		local key = kind .. ":" .. tostring(path or name)
		if seen[key] then
			return
		end
		seen[key] = true
		hits[#hits + 1] = { Kind = kind, Name = name, Path = path, Value = value }
	end
	local s = gameData.structure
	if s and s.Player and type(s.Player.Leaderstats) == "table" then
		for name, val in pairs(s.Player.Leaderstats) do
			add("leaderstat", name, "Players." .. player.Name .. ".leaderstats." .. name, val)
		end
	end
	local function consider(kind, name, path, value)
		if #hits >= cap then
			return
		end
		if stringContainsKeyword(tostring(name) .. " " .. tostring(path or ""), ECONOMY_KEYWORDS) then
			add(kind, name, path, value)
		end
	end
	for _, entry in ipairs(remoteRegistry) do
		consider("remote", entry.Name, entry.Path)
		if #hits >= cap then
			break
		end
	end
	for _, entry in ipairs(valueRegistry) do
		consider("value", entry.Name, entry.Path, entry.Value)
		if #hits >= cap then
			break
		end
	end
	return hits
end

local function queryLooksLikeEconomy(query)
	return stringContainsKeyword(query, ECONOMY_KEYWORDS)
end

-- Auto-dump on money/shop questions, not on a bare "give" in unrelated chat.
local function queryWantsEconomyDump(query)
	if stringContainsKeyword(query, MONEY_KEYWORDS) then
		return true
	end
	return stringContainsKeyword(query, {
		"shop", "store", "buy", "purchase", "grant", "award", "payout",
		"currency", "leaderstats", "paycheck",
	})
end

local CHAT_STOPWORDS = {
	how = true, does = true, what = true, where = true, when = true, which = true, why = true,
	the = true, this = true, that = true, these = true, those = true, there = true,
	game = true, please = true, tell = true, explain = true, about = true, just = true,
	like = true, from = true, with = true, have = true, here = true, they = true,
	them = true, then = true, than = true, into = true, your = true, myself = true,
	want = true, need = true, make = true, find = true, look = true, some = true,
	something = true, anything = true, instance = true, class = true, path = true,
	hello = true, thanks = true, thank = true, okay = true, yeah = true,
}

local function queryHuntNeedles(query)
	local needles = {}
	local seen = {}
	for word in string.gmatch(string.lower(tostring(query or "")), "[%a%d_]+") do
		if #word >= 4 and not CHAT_STOPWORDS[word] and not seen[word] then
			seen[word] = true
			needles[#needles + 1] = word
		end
	end
	return needles
end

local function queryWantsScriptHunt(query)
	if queryWantsEconomyDump(query) then
		return true
	end
	local needles = queryHuntNeedles(query)
	if #needles == 0 then
		return false
	end
	local q = string.lower(query)
	if string.find(q, "how", 1, true) or string.find(q, "what", 1, true) or string.find(q, "where", 1, true) or string.find(q, "explain", 1, true) then
		return true
	end
	return #query >= 18
end

buildGameBrief = function()
	local s = gameData.structure
	if not s then
		return "No scan yet."
	end
	local lines = {
		"Game: " .. tostring(s.GameName),
		"Job: explain how THIS game handles money, items, and remotes from the client scan. Do not invent FireServer args. Do not recommend Hold, fly, WalkSpeed writes, or disabling anti-cheat.",
	}

	local stats = s.Player and s.Player.Leaderstats
	if type(stats) == "table" then
		local bits = {}
		for name, val in pairs(stats) do
			bits[#bits + 1] = tostring(name) .. "=" .. tostring(val)
		end
		if #bits > 0 then
			table.insert(lines, "Leaderstats: " .. table.concat(bits, ", "))
		end
	end

	local economy = collectEconomyHits(8)
	if #economy > 0 then
		local bits = {}
		for i = 1, #economy do
			local h = economy[i]
			local bit = h.Kind .. " " .. tostring(h.Name)
			if h.Value ~= nil then
				bit = bit .. "=" .. tostring(h.Value)
			end
			bits[#bits + 1] = bit .. " @" .. tostring(h.Path)
		end
		table.insert(lines, "Money/shop hits: " .. table.concat(bits, "; "))
	else
		table.insert(lines, "Money/shop hits: none by name. Spy while you earn or buy, then ask again.")
	end

	if #scanNewNames > 0 then
		table.insert(lines, "New since last scan: " .. table.concat(scanNewNames, ", "))
	end

	local hum = s.Player and s.Player.Character and s.Player.Character.Humanoid
	if hum then
		table.insert(lines, string.format("Humanoid WalkSpeed=%s JumpPower=%s", tostring(hum.WalkSpeed), tostring(hum.JumpPower)))
	end

	local owned = {}
	for _, v in ipairs(valueRegistry) do
		if v.Ownership == "client" or v.Ownership == "server" then
			table.insert(owned, v.Name .. "=" .. tostring(v.Ownership))
		end
	end
	if #owned > 0 then
		table.insert(lines, "Tested values: " .. table.concat(owned, ", "))
	end

	if lastProbeResult ~= "" and lastProbeResult ~= "running" then
		table.insert(lines, "Last probe: " .. lastProbeResult)
	end
	local hot = hotRemoteLine()
	if hot then
		table.insert(lines, hot)
	end

	table.insert(lines, lineList("Movement: ", s.MovementRelated, 6))
	table.insert(lines, lineList("Item remotes: ", s.ItemRelated, 8))
	table.insert(lines, lineList("Remotes (named): ", s.Remotes, 8))
	table.insert(lines, lineList("Anti suspects: ", s.AntiCheatScripts, 6))
	if #loadedModuleNames > 0 then
		table.insert(lines, "Modules: " .. table.concat(loadedModuleNames, " | "))
	end
	for i = 1, math.min(4, #captureLog) do
		local cap = captureLog[i]
		table.insert(lines, "Capture: " .. truncateText(cap.Summary, 180))
		if cap.Pair then
			table.insert(lines, "  Pair: " .. cap.Pair)
		end
		if cap.StatDelta then
			table.insert(lines, "  Stats: " .. cap.StatDelta)
		end
		if cap.IdBlob ~= "" then
			table.insert(lines, "  IDs: " .. truncateText(cap.IdBlob, 160))
		end
	end
	local held = collectHeldItems()
	if #held > 0 then
		local bits = {}
		for i = 1, math.min(#held, 6) do
			table.insert(bits, held[i].Name .. (#held[i].Ids > 0 and (" " .. held[i].Ids[1]) or ""))
		end
		table.insert(lines, "Held items: " .. table.concat(bits, " | "))
	end
	if s.ConnectionNote then
		table.insert(lines, "Connections: " .. s.ConnectionNote)
	end

	local brief = table.concat(lines, "\n")
	if #brief > CONFIG.MAX_API_CONTEXT_CHARS then
		brief = string.sub(brief, 1, CONFIG.MAX_API_CONTEXT_CHARS)
	end
	return brief
end

local function buildContextForQuery(query)
	if not gameData.structure then
		scanGameStructure()
	end
	if lastBrief == "" then
		lastBrief = buildGameBrief()
	end

	local keywords = expandQueryKeywords(query)
	local extra = {}
	local function consider(label, list)
		local hits = 0
		for _, item in ipairs(list or {}) do
			local blob = string.lower(tostring(item.Name) .. " " .. tostring(item.Path or ""))
			for _, keyword in ipairs(keywords) do
				if #keyword >= 3 and string.find(blob, keyword, 1, true) then
					table.insert(extra, label .. ": " .. tostring(item.Name) .. " @ " .. tostring(item.Path))
					hits = hits + 1
					break
				end
			end
			if hits >= 5 then
				break
			end
		end
	end
	consider("script", gameData.structure.Scripts)
	consider("value", gameData.structure.Values)
	consider("remote", gameData.structure.Remotes)
	consider("item-remote", gameData.structure.ItemRelated)

	if #recentStatDeltas > 0 then
		local bits = {}
		for i = 1, math.min(4, #recentStatDeltas) do
			local d = recentStatDeltas[i]
			bits[#bits + 1] = tostring(d.Name) .. " " .. tostring(d.From) .. "→" .. tostring(d.To)
		end
		table.insert(extra, "recent value changes: " .. table.concat(bits, "; "))
	end

	if queryLooksLikeEconomy(query) then
		for _, hit in ipairs(collectEconomyHits(12)) do
			local line = "economy " .. hit.Kind .. ": " .. tostring(hit.Name)
			if hit.Value ~= nil then
				line = line .. " = " .. tostring(hit.Value)
			end
			table.insert(extra, line .. " @ " .. tostring(hit.Path))
		end
		if #sourceIndex > 0 and #lastSourceHits == 0 then
			fillSourceHitsFromNeedles({ "cash", "coin", "money", "currency", "shop", "buy", "award", "grant" }, 8)
			for _, hit in ipairs(lastSourceHits) do
				table.insert(extra, "source " .. hit.Path .. ": " .. (hit.Snippet or ""))
			end
		end
	end

	for i = 1, math.min(3, #captureLog) do
		local cap = captureLog[i]
		table.insert(extra, "capture: " .. truncateText(cap.Summary, 160))
		if cap.Pair then
			table.insert(extra, "pair: " .. cap.Pair)
		end
		if cap.StatDelta then
			table.insert(extra, "stats: " .. cap.StatDelta)
		end
		if cap.IdBlob ~= "" then
			table.insert(extra, "ids: " .. truncateText(cap.IdBlob, 160))
		end
	end
	for _, hit in ipairs(lastSourceHits) do
		table.insert(extra, "source " .. hit.Path .. ": " .. (hit.Snippet or ""))
	end

	if #extra == 0 then
		return lastBrief
	end
	return lastBrief .. "\nMatches:\n" .. table.concat(extra, "\n")
end

scanPlayerGui = function()
	if scanUiInProgress then
		return "Scan UI already running."
	end
	if not playerGui then
		playerGui = player:FindFirstChild("PlayerGui")
		if not playerGui then
			return "Scan UI failed: PlayerGui not ready."
		end
	end
	scanUiInProgress = true
	if remotesHint then
		remotesHint.Text = "Scanning PlayerGui (skips this window)..."
	end
	local addedRemotes, addedValues, addedScripts, scanned = 0, 0, 0, 0
	local yieldAt = os.clock()
	local yieldSec = tonumber(CONFIG.SCAN_YIELD_SEC) or 0.01
	local okKids, kids = pcall(function()
		return playerGui:GetChildren()
	end)
	if not okKids then
		scanUiInProgress = false
		return "Scan UI failed: cannot read PlayerGui."
	end

	local function consider(obj)
		scanned = scanned + 1
		if os.clock() - yieldAt >= yieldSec then
			task.wait()
			yieldAt = os.clock()
		end
		local className = obj.ClassName
		if not SCAN_CLASSES[className] then
			return
		end
		local path = obj:GetFullName()
		if className == "RemoteEvent" or className == "RemoteFunction" or className == "UnreliableRemoteEvent" then
			if not remoteByPath[path] then
				local entry = {
					Name = obj.Name,
					ClassName = className,
					Path = path,
					Instance = obj,
					Hits = remoteHitCounts[path] or 0,
				}
				table.insert(remoteRegistry, entry)
				remoteByPath[path] = entry
				if gameData.structure and gameData.structure.Remotes then
					table.insert(gameData.structure.Remotes, {
						Name = obj.Name,
						ClassName = className,
						Path = path,
					})
				end
				addedRemotes = addedRemotes + 1
			end
		elseif obj:IsA("ValueBase") then
			local before = #valueRegistry
			registerValueObject(obj, "Player")
			if #valueRegistry > before then
				addedValues = addedValues + 1
			end
		elseif className == "LocalScript" or className == "Script" or className == "ModuleScript" then
			addedScripts = addedScripts + 1
			local blob = string.lower(obj.Name .. " " .. path)
			if stringContainsKeyword(blob, ANTI_KEYWORDS) then
				table.insert(antiScriptRegistry, {
					Name = obj.Name,
					ClassName = className,
					Path = path,
					Disabled = obj.Disabled,
					Why = "PlayerGui name match",
					Instance = obj,
				})
			end
		end
	end

	for _, gui in ipairs(kids) do
		if gui ~= screenGui and gui.Name ~= "GameAnalysisAI" then
			consider(gui)
			local okDesc, descendants = pcall(function()
				return gui:GetDescendants()
			end)
			if okDesc then
				for _, obj in ipairs(descendants) do
					consider(obj)
				end
			end
		end
	end

	lastBrief = ""
	rebuildValueExplorer()
	rebuildAntiPanel()
	rebuildRemotePanel()
	if spyEnabled then
		startIncomingSpy()
	end
	local summary = "Scan UI: +"
		.. addedRemotes
		.. " remotes, +"
		.. addedValues
		.. " values, "
		.. addedScripts
		.. " scripts in PlayerGui."
	if remotesHint then
		remotesHint.Text = summary
	end
	scanUiInProgress = false
	return summary
end

local function answerFromLocal(query)
	local lines = { "API is down. Local notes only — no model." }
	if lastBrief ~= "" then
		table.insert(lines, lastBrief)
	elseif gameData.structure then
		table.insert(lines, buildGameBrief())
	else
		table.insert(lines, "No scan yet.")
	end
	local q = string.lower(query or "")
	local hits = 0
	for _, cap in ipairs(captureLog) do
		if hits >= 6 then
			break
		end
		if q == "" or string.find(string.lower(cap.Summary .. " " .. (cap.IdBlob or "")), q, 1, true) then
			table.insert(lines, "Capture: " .. truncateText(cap.Summary, 160))
			hits = hits + 1
		end
	end
	if #valueHistory > 0 then
		table.insert(lines, "Recent value changes:")
		for i = 1, math.min(5, #valueHistory) do
			local h = valueHistory[i]
			table.insert(lines, h.Path .. " " .. h.From .. " → " .. h.To .. " (" .. h.Why .. ")")
		end
	end
	return table.concat(lines, "\n")
end

local SYSTEM_PROMPT = [[You help a player understand THIS Roblox game from a client-side scan (leaderstats, values, remotes, captures, dumped client script strings, value-change log, Explorer dumps).

Answer THEIR question first. Use whatever matches: remotes, values, dumped scripts, GUI handlers, recent value changes. Do not assume every game has coins.

You can only read scripts that exist on THIS client: LocalScripts, replicated ModuleScripts, and strings from getconstants/getsenv/decompile. Server Scripts in ServerScriptService / ServerStorage usually do not replicate. If the dump has no matching code, say that part is likely server-only.

If they ask about money/shop:
1. Currency: name leaderstats/values that look like Coins/Cash/Gems and their current numbers. A local Set only changes what this client sees. If the server replicates the number back, you cannot grant money from the client.
2. Client scripts: cite the Path of dumped scripts whose strings mention cash/shop/award/FireServer. Quote a short snippet. Explain the client flow (UI or LocalScript → remote). If a remote is named, cite its path and tell them to turn Spy on and earn/buy once to see real args. Do not invent FireServer arguments or UUIDs.
3. Remotes: name shop/buy/award/give remotes with paths. Cite captures if present.
4. If the dump and scan have no money/shop names, say so: grant is likely server-only, and they should Spy while they earn or buy, then ask again.

For any other topic: cite paths, quote dump/Links snippets, and say Spy while they do the action if args are unknown. Never invent FireServer arguments or UUIDs.
Never recommend Hold, fly, WalkSpeed/JumpPower writes, noclip, or disabling anti-cheat.

Short. Cite paths. Be direct that the server owns important stats in most games.]]

local SYSTEM_PROMPT_TOOLS = SYSTEM_PROMPT .. [[

The player turned tools on. You may call only: probe, spy, index_source, search_source, scan_ui.
How/what questions already dump client scripts before this message. Use search_source only if you need a different keyword. Spy while they do the action if there are no captures yet.
Never FireServer, Replay, Hold, Set, or fly. At most two tool rounds.
]]

local AI_TOOL_SPECS = {
	{
		name = "probe",
		description = "Read-only snapshot of WalkSpeed/JumpPower/JumpHeight, listeners if available, otherwise scripts whose strings mention those properties. Does not write Humanoid properties.",
		parameters = { type = "object", properties = {} },
	},
	{
		name = "spy",
		description = "Turn remote capture on or off. Hooks FireServer if this executor can; otherwise listens to incoming OnClientEvent. Does not fire remotes.",
		parameters = {
			type = "object",
			properties = {
				enabled = { type = "boolean", description = "true to turn spy on, false to pause" },
			},
		},
	},
	{
		name = "index_source",
		description = "Dump searchable strings from a limited set of client scripts (getconstants/getsenv, or decompile if present). Does not fire remotes.",
		parameters = { type = "object", properties = {} },
	},
	{
		name = "search_source",
		description = "Search dumped script strings for an item id or remote name. Dump first if empty.",
		parameters = {
			type = "object",
			properties = {
				query = { type = "string", description = "Text to search in dumped script strings" },
			},
			required = { "query" },
		},
	},
	{
		name = "scan_ui",
		description = "Opt-in scan of PlayerGui for remotes, values, and scripts. Skips this tool's own window. Can be slow or noisy.",
		parameters = { type = "object", properties = {} },
	},
}

local function openaiToolList()
	local tools = {}
	for _, spec in ipairs(AI_TOOL_SPECS) do
		table.insert(tools, {
			type = "function",
			["function"] = {
				name = spec.name,
				description = spec.description,
				parameters = spec.parameters,
			},
		})
	end
	return tools
end

local function anthropicToolList()
	local tools = {}
	for _, spec in ipairs(AI_TOOL_SPECS) do
		table.insert(tools, {
			name = spec.name,
			description = spec.description,
			input_schema = spec.parameters,
		})
	end
	return tools
end

local function waitWhile(pred, seconds)
	local t0 = tick()
	while pred() and tick() - t0 < seconds do
		task.wait(0.15)
	end
end

local function sourceLooksLikeEconomyDump()
	for _, doc in ipairs(sourceIndex) do
		if stringContainsKeyword(doc.Lower or "", ECONOMY_KEYWORDS) then
			return true
		end
	end
	return false
end

local function ensureClientScriptDump(opts)
	opts = opts or {}
	if indexInProgress then
		waitWhile(function()
			return indexInProgress
		end, 30)
	end
	local hunt = opts.focus == "economy"
	if #sourceIndex > 0 and (not hunt or sourceLooksLikeEconomyDump()) then
		return
	end
	if indexInProgress then
		return
	end
	indexSources(opts.query or "", {
		silent = opts.silent ~= false,
		focus = opts.focus,
		extraHints = opts.extraHints,
		maxDocs = hunt and CONFIG.MAX_SOURCE_DOCS_HUNT or CONFIG.MAX_SOURCE_DOCS,
		maxCandidates = hunt and (CONFIG.MAX_SOURCE_CANDIDATES_HUNT * 2) or CONFIG.MAX_SOURCE_CANDIDATES,
	})
	waitWhile(function()
		return indexInProgress
	end, 35)
end

local ALLOWED_AI_TOOLS = {
	probe = true,
	spy = true,
	index_source = true,
	search_source = true,
	scan_ui = true,
}

local function executeAiTool(name, input)
	input = type(input) == "table" and input or {}
	if not ALLOWED_AI_TOOLS[name] then
		return "Refused: that tool is not allowed."
	end
	if name == "probe" then
		lastProbeResult = "running"
		runProbe()
		waitWhile(function()
			return lastProbeResult == "running"
		end, 2)
		if lastProbeResult == "" or lastProbeResult == "running" then
			return "Probe finished with no result."
		end
		return lastProbeResult
	end
	if name == "spy" then
		local on = input.enabled
		if on == nil then
			on = true
		end
		setSpyEnabled(on, on and "Spy on (AI)." or "Spy paused (AI).")
		if on and spyInstalled then
			return "Spy is ON. Outgoing FireServer and incoming remotes will show in Remotes."
		end
		if on then
			return "Listening to incoming remotes (OnClientEvent). This executor cannot hook FireServer, so outgoing calls will not show."
		end
		return "Spy/Listen is OFF."
	end
	if name == "index_source" then
		if #sourceIndex > 0 and not indexInProgress and sourceLooksLikeEconomyDump() then
			return "Already dumped " .. #sourceIndex .. " scripts. Use search_source."
		end
		indexSources("", { silent = true, focus = "economy" })
		waitWhile(function()
			return indexInProgress
		end, 30)
		if indexInProgress then
			return "Still dumping script strings. Ask again in a few seconds."
		end
		if #sourceIndex == 0 then
			return "Dump found no searchable strings. This executor may lack getconstants, getsenv, and decompile. Server Scripts usually do not replicate to the client."
		end
		return "Dumped " .. #sourceIndex .. " client scripts with searchable strings. ServerScriptService is usually not readable from the client."
	end
	if name == "search_source" then
		local q = tostring(input.query or "")
		if q == "" then
			return "Need a query string."
		end
		runSourceSearch(q)
		waitWhile(function()
			return indexInProgress
		end, 20)
		if indexInProgress then
			return "Still dumping script strings. Ask again in a few seconds."
		end
		if #sourceIndex > 0 and #lastSourceHits == 0 then
			runSourceSearch(q)
		end
		if #lastSourceHits == 0 then
			return "No dump hits for \"" .. q .. "\"."
		end
		local parts = {}
		for _, hit in ipairs(lastSourceHits) do
			table.insert(parts, hit.Path .. ": " .. truncateText(hit.Snippet or "", 220))
		end
		return table.concat(parts, "\n")
	end
	if name == "scan_ui" then
		return scanPlayerGui()
	end
	return "Refused."
end

local function parseToolArguments(raw)
	if type(raw) == "table" then
		return raw
	end
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(decoded) == "table" then
		return decoded
	end
	return {}
end

local function makeApiHeaders(provider)
	if provider == "anthropic" then
		return {
			["Content-Type"] = "application/json",
			["content-type"] = "application/json",
			["x-api-key"] = apiKey,
			["anthropic-version"] = "2023-06-01",
		}
	end
	return {
		["Content-Type"] = "application/json",
		["content-type"] = "application/json",
		Authorization = "Bearer " .. apiKey,
		authorization = "Bearer " .. apiKey,
	}
end

local function decodeApiBody(raw)
	if type(raw) == "table" then
		return raw
	end
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function apiErrorText(response)
	if not response then
		return "request failed"
	end
	local data = decodeApiBody(response.Body)
	if type(data) == "table" then
		local err = data.error
		if type(err) == "table" and type(err.message) == "string" and err.message ~= "" then
			return err.message
		end
		if type(data.message) == "string" and data.message ~= "" then
			return data.message
		end
	end
	local status = response.StatusMessage or "request failed"
	if response.StatusCode and response.StatusCode > 0 then
		status = status .. " (" .. tostring(response.StatusCode) .. ")"
	end
	if type(response.Body) == "string" and response.Body ~= "" then
		status = status .. " " .. truncateText(response.Body, 240)
	end
	return status
end

local function processQueryWithAPI(query)
	if not isAuthenticated or apiKey == "" then
		return "API key required."
	end

	local contextJson = buildContextForQuery(query)
	local payloadNote = string.format("[sent %d chars of game context]", #contextJson)
	local provider = getApiProvider(apiKey)
	local systemText = aiToolsEnabled and SYSTEM_PROMPT_TOOLS or SYSTEM_PROMPT
	local userText = "Scan:\n" .. contextJson .. "\n\nQuestion: " .. query

	local function postChat(body)
		local headers = makeApiHeaders(provider)
		local okBody, encoded = pcall(function()
			return HttpService:JSONEncode(body)
		end)
		if not okBody then
			return nil, "Failed to encode API request.\n\n" .. answerFromLocal(query)
		end
		local response, lastErr
		for attempt = 1, 3 do
			local res, err = httpRequest({
				Url = provider == "anthropic" and CONFIG.ANTHROPIC_ENDPOINT or CONFIG.API_ENDPOINT,
				Method = "POST",
				Headers = headers,
				Body = encoded,
			})
			response = res
			if res and res.Success then
				break
			end
			lastErr = err or apiErrorText(res)
			local code = res and res.StatusCode
			local retry = (not res) or code == 429 or code == 500 or code == 502 or code == 503
			if not retry or attempt == 3 then
				break
			end
			task.wait(0.5 * attempt)
		end
		if not response or not response.Success then
			return nil, "API failed after retries: " .. tostring(lastErr or "request failed") .. "\n\n" .. answerFromLocal(query)
		end
		local data = decodeApiBody(response.Body)
		if not data then
			return nil, "Failed to parse API response.\n\n" .. answerFromLocal(query)
		end
		if type(data.error) == "table" then
			return nil, "API error: " .. apiErrorText(response) .. "\n\n" .. answerFromLocal(query)
		end
		return data, nil
	end

	if provider == "anthropic" then
		local messages = {
			{ role = "user", content = userText },
		}
		local toolRounds = 0
		while true do
			local body = {
				model = CONFIG.ANTHROPIC_MODEL,
				max_tokens = 2000,
				system = systemText,
				messages = messages,
			}
			if aiToolsEnabled then
				body.tools = anthropicToolList()
			end
			local data, err = postChat(body)
			if not data then
				return err
			end
			local content = data.content
			if type(content) ~= "table" then
				return "Error parsing Anthropic response.\n\n" .. answerFromLocal(query)
			end
			local toolUses = {}
			local texts = {}
			for _, block in ipairs(content) do
				if block.type == "tool_use" then
					table.insert(toolUses, block)
				elseif block.type == "text" and type(block.text) == "string" then
					table.insert(texts, block.text)
				end
			end
			if #toolUses == 0 or not aiToolsEnabled or toolRounds >= 2 then
				local text = table.concat(texts, "\n")
				if text == "" then
					text = "No text from model."
				end
				return text .. "\n\n" .. payloadNote
			end
			toolRounds = toolRounds + 1
			table.insert(messages, { role = "assistant", content = content })
			local results = {}
			for _, block in ipairs(toolUses) do
				local result = executeAiTool(block.name, block.input)
				table.insert(results, {
					type = "tool_result",
					tool_use_id = block.id,
					content = result,
				})
			end
			table.insert(messages, { role = "user", content = results })
			lastBrief = ""
			contextJson = buildContextForQuery(query)
		end
	end

	local messages = {
		{ role = "system", content = systemText },
		{ role = "user", content = userText },
	}
	local toolRounds = 0
	while true do
		local body = {
			model = CONFIG.OPENAI_MODEL,
			max_tokens = 2000,
			messages = messages,
		}
		if aiToolsEnabled then
			body.tools = openaiToolList()
		end
		local data, err = postChat(body)
		if not data then
			return err
		end
		local msg = data.choices and data.choices[1] and data.choices[1].message
		if not msg then
			return "Error parsing OpenAI response.\n\n" .. answerFromLocal(query)
		end
		local calls = msg.tool_calls
		if type(calls) ~= "table" or #calls == 0 or not aiToolsEnabled or toolRounds >= 2 then
			local text = msg.content
			if type(text) ~= "string" or text == "" then
				text = "No text from model."
			end
			return text .. "\n\n" .. payloadNote
		end
		toolRounds = toolRounds + 1
		table.insert(messages, {
			role = "assistant",
			content = msg.content or "",
			tool_calls = calls,
		})
		for _, call in ipairs(calls) do
			local fn = call["function"] or {}
			local result = executeAiTool(fn.name, parseToolArguments(fn.arguments))
			table.insert(messages, {
				role = "tool",
				tool_call_id = call.id,
				content = result,
			})
		end
		lastBrief = ""
		contextJson = buildContextForQuery(query)
	end
end

handleQuery = function()
	if not isAuthenticated or isProcessing then
		return
	end
	local query = string.gsub(inputBox.Text, "^%s*(.-)%s*$", "%1")
	if query == "" then
		return
	end
	if switchMainTab then
		switchMainTab("Chat")
	end
	inputBox.Text = ""
	addMessage(query, true)
	isProcessing = true
	sendButton.Text = "..."
	task.spawn(function()
		if scanInProgress then
			waitWhile(function()
				return scanInProgress
			end, 20)
		end
		if not gameData.structure then
			scanGameStructure()
		end
		if queryWantsScriptHunt(query) then
			local needles = queryHuntNeedles(query)
			local economy = queryWantsEconomyDump(query)
			if economy then
				addMessage("Reading client scripts for money/shop (LocalScripts and modules this client can see — not ServerScriptService)...", false)
			else
				addMessage("Reading client scripts for words in your question (this client only — not ServerScriptService)...", false)
			end
			ensureClientScriptDump({
				silent = true,
				focus = economy and "economy" or nil,
				query = query,
				extraHints = needles,
			})
			if fillSourceHitsFromNeedles then
				if economy then
					fillSourceHitsFromNeedles(mergeArrays(ECONOMY_SOURCE_NEEDLES, needles), 10)
				elseif #needles > 0 then
					fillSourceHitsFromNeedles(needles, 10)
				end
			end
			if #sourceIndex == 0 then
				addMessage("No client script strings to search. This executor may lack getconstants/getsenv/decompile, or that logic lives only on the server.", false)
			elseif #lastSourceHits == 0 then
				addMessage("Dumped " .. #sourceIndex .. " client scripts; none matched those words. Spy while you do the action, then ask again.", false)
			end
		end
		local ok, response = pcall(processQueryWithAPI, query)
		if ok then
			addMessage(response, false)
		else
			addMessage("Chat failed: " .. tostring(response) .. "\n\n" .. answerFromLocal(query), false)
			playThemeSound("error")
		end
		isProcessing = false
		if sendButton then
			sendButton.Text = "→"
		end
	end)
end

local function unlockApp()
	isAuthenticated = true
	tween(apiKeyGate, TWEEN_SOFT, { Position = UDim2.new(0.5, -240, 0.5, -200) })
	task.delay(0.18, function()
		if apiKeyGate then
			apiKeyGate.Visible = false
		end
	end)
	mainFrame.Visible = true
	mainFrame.Size = UDim2.new(0, CONFIG.WINDOW_SIZE.X.Offset, 0, 48)
	if sidebarFrame then
		sidebarFrame.Visible = true
	end
	if contentHost then
		contentHost.Visible = true
	end
	if topBar then
		topBar.Visible = true
	end
	sessionStarted = tick()
	local startTab = CONFIG.LAST_TAB
	if not pageForTab(startTab) or startTab == "Settings" then
		startTab = "Dashboard"
	end
	switchMainTab(startTab)
	applyUiScale()
	tween(mainFrame, TWEEN_SLIDE, {
		Size = CONFIG.WINDOW_SIZE,
		Position = mainFrame.Position,
	})
	task.delay(0.05, function()
		applyUiScale()
		layoutPanels(true)
		if refreshDashboard then
			refreshDashboard()
		end
	end)
	addMessage("Connected (" .. getApiProvider(apiKey) .. "). Scanning game...", false)
	task.spawn(function()
		scanGameStructure()
		addMessage(
			"Scan done. Ask Chat how something works — money, a shop button, a remote, a value. It reads client scripts and values. It cannot read ServerScriptService, and it cannot grant coins if the server owns them.",
			false
		)
	end)
end

local function tryContinueWithApiKey()
	local valid, result = isValidApiKey(gateKeyInput.Text)
	if not valid then
		gateStatusLabel.Text = result
		gateStatusLabel.TextColor3 = CONFIG.THEME.ERROR
		return
	end
	apiKey = result
	gateContinueButton.Text = "Checking..."
	task.spawn(function()
		local testOk, testResult = pcall(function()
			local provider = getApiProvider(apiKey)
			local body = provider == "anthropic"
					and HttpService:JSONEncode({
						model = CONFIG.ANTHROPIC_MODEL,
						max_tokens = 32,
						messages = { { role = "user", content = "OK" } },
					})
				or HttpService:JSONEncode({
					model = CONFIG.OPENAI_MODEL,
					max_tokens = 32,
					messages = { { role = "user", content = "OK" } },
				})
			local resp, err = httpRequest({
				Url = provider == "anthropic" and CONFIG.ANTHROPIC_ENDPOINT or CONFIG.API_ENDPOINT,
				Method = "POST",
				Headers = makeApiHeaders(provider),
				Body = body,
			})
			if not resp then
				error(err or "request failed")
			end
			if not resp.Success then
				error(apiErrorText(resp))
			end
			local data = decodeApiBody(resp.Body)
			if type(data) == "table" and type(data.error) == "table" then
				error(apiErrorText(resp))
			end
		end)
		gateContinueButton.Text = "Continue"
		if not testOk then
			gateStatusLabel.Text = "Key test failed: " .. tostring(testResult)
			gateStatusLabel.TextColor3 = CONFIG.THEME.ERROR
			playThemeSound("error")
			return
		end
		settingsKeyInput.Text = apiKey
		unlockApp()
	end)
end

local function toggleMinimize()
	isMinimized = not isMinimized
	hideTip()
	cancelHotkeyWait()
	playThemeSound("switch")
	if toastHost then
		toastHost.Visible = not isMinimized
	end
	if isMinimized then
		if helpFrame and helpFrame.Visible then
			hideModal(helpFrame, 440, 340)
		end
		tween(topBar, TWEEN_SLIDE, {
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.new(1, 0, 0, 48),
		})
		tween(mainFrame, TWEEN_SLIDE, { Size = CONFIG.MINIMIZED_SIZE })
		task.delay(0.12, function()
			if isMinimized then
				if sidebarFrame then
					sidebarFrame.Visible = false
				end
				if contentHost then
					contentHost.Visible = false
				end
			end
		end)
	else
		if sidebarFrame then
			sidebarFrame.Visible = true
		end
		if contentHost then
			contentHost.Visible = true
		end
		switchMainTab(activeMainTab or "Dashboard")
		tween(mainFrame, TWEEN_SLIDE, { Size = CONFIG.WINDOW_SIZE })
		layoutPanels(true)
		applyUiScale()
	end
end

local function connectEvents()
	gateContinueButton.MouseButton1Click:Connect(tryContinueWithApiKey)
	gateKeyInput.FocusLost:Connect(function(enter)
		if enter then
			tryContinueWithApiKey()
		end
	end)
	sendButton.MouseButton1Click:Connect(handleQuery)
	inputBox.FocusLost:Connect(function(enter)
		if enter then
			handleQuery()
		end
	end)
	settingsButton.MouseButton1Click:Connect(function()
		switchMainTab("Settings")
	end)
	settingsSaveButton.MouseButton1Click:Connect(function()
		local valid, result = isValidApiKey(settingsKeyInput.Text)
		if valid then
			apiKey = result
			addMessage("API key updated.", false)
			if refreshDashboard then
				refreshDashboard()
			end
		else
			addMessage(result, false)
		end
	end)
	local closeSettings = settingsFrame:FindFirstChild("CloseSettingsButton", true)
	if closeSettings then
		closeSettings.MouseButton1Click:Connect(function()
			switchMainTab("Dashboard")
		end)
	end
	local rescanBtn = settingsFrame:FindFirstChild("RescanButton", true)
	if rescanBtn then
		rescanBtn.MouseButton1Click:Connect(function()
			addMessage("Rescanning...", false)
			task.spawn(function()
				scanGameStructure()
				if not screenGui or not screenGui.Parent then
					return
				end
				if refreshDashboard then
					refreshDashboard()
				end
				addMessage("Rescan complete.", false)
				playThemeSound("success")
			end)
		end)
	end
	closeButton.MouseButton1Click:Connect(function()
		shutdownSession()
	end)
	minimizeButton.MouseButton1Click:Connect(toggleMinimize)

	hotkeyConn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local code = input.KeyCode
		if waitingHotkeyId then
			if code == Enum.KeyCode.Escape then
				cancelHotkeyWait()
				return
			end
			if code == Enum.KeyCode.Backspace or code == Enum.KeyCode.Delete then
				setHotkey(waitingHotkeyId, "None")
				waitingHotkeyId = nil
				savePrefs()
				return
			end
			setHotkey(waitingHotkeyId, code.Name)
			waitingHotkeyId = nil
			savePrefs()
			playThemeSound("click")
			return
		end
		if typingInBox() then
			return
		end
		if not isAuthenticated then
			return
		end
		local matched
		for _, spec in ipairs(HOTKEY_SPECS) do
			if hotkeyCode(spec.id) == code then
				matched = spec.id
				break
			end
		end
		if not matched then
			return
		end
		if matched == "toggleGui" then
			toggleMinimize()
		elseif matched == "toggleSpy" then
			if spyEnabled then
				setSpyEnabled(false, "Spy paused (hotkey).")
			else
				setSpyEnabled(true, "Spy on (hotkey).")
			end
		elseif matched == "scan" then
			addMessage("Rescanning...", false)
			task.spawn(function()
				scanGameStructure()
				if refreshDashboard then
					refreshDashboard()
				end
				addMessage("Rescan complete.", false)
				playThemeSound("success")
			end)
		elseif matched == "probe" then
			runProbe()
		elseif matched == "dump" then
			indexSources("")
			if switchMainTab then
				switchMainTab("Remotes")
			end
		elseif matched == "copyBrief" then
			copyBrief()
		end
	end)

	player.CharacterAdded:Connect(function()
		task.wait(1)
		if not screenGui or not screenGui.Parent then
			return
		end
		refreshCharacterScan()
	end)
end

local function showBootError(err)
	local text = "Game Analysis AI failed to start:\n" .. tostring(err)
	pcall(function()
		warn(text)
		print(text)
	end)
	local sg = Instance.new("ScreenGui")
	sg.Name = "GameAnalysisAI_Error"
	pcall(function()
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.DisplayOrder = 2147483647
		sg.Enabled = true
	end)
	parentScreenGui(sg)
	local box = Instance.new("TextLabel")
	box.Size = UDim2.new(0, 520, 0, 180)
	box.Position = UDim2.new(0.5, -260, 0.5, -90)
	box.BackgroundColor3 = Color3.fromRGB(28, 18, 22)
	box.TextColor3 = Color3.fromRGB(255, 196, 196)
	box.Font = Enum.Font.SourceSans
	box.TextSize = 18
	box.TextWrapped = true
	box.Text = text
	box.Parent = sg
	pcall(function()
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = box
	end)
end

local bootOk, bootErr = pcall(createUI)
if not bootOk then
	showBootError(bootErr)
else
	local evOk, evErr = pcall(connectEvents)
	if not evOk then
		showBootError(evErr)
	end
	pcall(function()
		print("GameAnalysisAI: loaded. You should see the API key window.")
	end)
end

task.spawn(function()
	while screenGui and screenGui.Parent do
		if uptimeLabel and mainFrame and mainFrame.Visible and not isMinimized then
			uptimeLabel.Text = "Uptime: " .. formatUptime()
		end
		task.wait(1)
	end
end)

if bootOk and gateStatusLabel then
	if not getHttpRequest() then
		gateStatusLabel.Text = "This executor has no request() — chat will fail in-game. Need request, http_request, or syn.request."
		gateStatusLabel.TextColor3 = CONFIG.THEME.WARNING
	end
	local savedKey = getSavedApiKey()
	if savedKey and gateKeyInput then
		gateKeyInput.Text = savedKey
		if getHttpRequest() then
			gateStatusLabel.Text = "Key found in executor env (GAI_API_KEY). Click Continue."
			gateStatusLabel.TextColor3 = CONFIG.THEME.SUCCESS
		end
	end
end

