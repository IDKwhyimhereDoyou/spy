addCorner = function(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = parent
	return corner
end

local TWEEN_SOFT = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TWEEN_SNAP = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_SLIDE = TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local runningTweens = {}
local sfxFolder
local sfxPool = {}
local lastSoundAt = {}

local function fxTween(kind)
	local fx = currentFx()
	local m = motionAmount()
	if m <= 0.02 then
		return TweenInfo.new(0.01, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	end
	local timeScale = 0.45 + 0.55 * m
	if kind == "hover" then
		return TweenInfo.new((fx.hoverTime or 0.16) * timeScale, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end
	if kind == "slide" then
		return TweenInfo.new((fx.slideTime or 0.28) * timeScale, fx.slideEase or Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	end
	return TWEEN_SOFT
end

local function ensureSfxFolder()
	if sfxFolder and sfxFolder.Parent then
		return sfxFolder
	end
	sfxFolder = Instance.new("Folder")
	sfxFolder.Name = "GAI_Sfx"
	sfxFolder.Parent = screenGui or SoundService
	sfxPool = {}
	return sfxFolder
end

local function playThemeSound(kind)
	if CONFIG.SOUNDS == false then
		return
	end
	local volMul = tonumber(CONFIG.SOUND_VOLUME) or 0.7
	if volMul <= 0.01 then
		return
	end
	local fx = currentFx()
	local spec = fx.sounds and fx.sounds[kind]
	if not spec then
		if kind == "error" then
			spec = { clip = "ping", speed = 0.58, vol = 0.3 }
		elseif kind == "open" then
			spec = fx.sounds and fx.sounds.switch or { clip = "switch", speed = 1, vol = 0.28 }
		else
			return
		end
	end
	local now = os.clock()
	local gap = kind == "hover" and 0.12 or 0.055
	if lastSoundAt[kind] and (now - lastSoundAt[kind]) < gap then
		return
	end
	lastSoundAt[kind] = now
	local clips = SOUND_CLIPS[spec.clip] or SOUND_CLIPS.button
	local folder = ensureSfxFolder()
	local sound
	for _, s in ipairs(sfxPool) do
		if s.Parent and not s.IsPlaying then
			sound = s
			break
		end
	end
	if not sound then
		if #sfxPool >= 8 then
			return
		end
		sound = Instance.new("Sound")
		sound.Name = "GAI_Sfx"
		sound.Parent = folder
		table.insert(sfxPool, sound)
	end
	if volMul < 0 then
		volMul = 0
	end
	if volMul > 1 then
		volMul = 1
	end
	local volume = (spec.vol or 0.25) * volMul
	sound.Volume = volume
	sound.PlaybackSpeed = math.max(0.5, math.min(4, spec.speed or 1))
	sound.TimePosition = 0
	local id = clips
	if type(clips) == "table" then
		id = clips[1]
	end
	if type(id) == "string" and id ~= "" then
		sound.SoundId = id
	end
	pcall(function()
		sound:Play()
	end)
end

local tween
local function playThemeIntro()
	if not mainFrame or isMinimized then
		return
	end
	playThemeSound("switch")
	if motionAmount() <= 0.02 then
		return
	end
	local fx = currentFx()
	local base = tonumber(CONFIG.UI_SCALE) or 1
	if base < 0.7 then
		base = 0.7
	end
	if base > 1.4 then
		base = 1.4
	end
	local scale = mainFrame:FindFirstChild("GAI_UserScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "GAI_UserScale"
		scale.Parent = mainFrame
	end
	mainFrame.Rotation = 0
	local punch = 0.03 * motionAmount()
	local frameStroke = mainFrame:FindFirstChildOfClass("UIStroke")
	if frameStroke then
		local rest = frameStroke.Transparency
		frameStroke.Transparency = math.max(0, rest - 0.22)
		tween(frameStroke, TWEEN_SOFT, { Transparency = rest })
	end
	if fx.intro == "glitch" then
		scale.Scale = base * (1 + punch * 1.6)
		tween(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = base * (1 - punch * 0.6) })
		task.delay(0.09, function()
			if scale.Parent and CONFIG.THEME_NAME == "Cyberpunk" then
				tween(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base })
			end
		end)
	elseif fx.intro == "bloom" then
		scale.Scale = base * (1 + punch * 1.5)
		tween(scale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base })
	elseif fx.intro == "fade" then
		scale.Scale = base * (1 - punch * 0.5)
		tween(scale, TweenInfo.new(0.28, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Scale = base })
	else
		scale.Scale = base * (1 - punch)
		tween(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base })
	end
end

tween = function(inst, info, props)
	if typeof(inst) ~= "Instance" or type(props) ~= "table" then
		return nil
	end
	local prev = runningTweens[inst]
	if prev then
		pcall(function()
			prev:Cancel()
		end)
	end
	local t = TweenService:Create(inst, info or TWEEN_SOFT, props)
	runningTweens[inst] = t
	t:Play()
	t.Completed:Connect(function()
		if runningTweens[inst] == t then
			runningTweens[inst] = nil
		end
	end)
	return t
end

local function hoverTint(c)
	local lum = (c.R + c.G + c.B) / 3
	if lum > 0.72 then
		return Color3.new(c.R * 0.93, c.G * 0.93, c.B * 0.93)
	end
	return Color3.new(math.min(1, c.R + 0.07), math.min(1, c.G + 0.07), math.min(1, c.B + 0.07))
end

local function addStroke(parent, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = CONFIG.THEME.STROKE or CONFIG.THEME.SECONDARY
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

local function styleCard(frame, radius)
	addCorner(frame, radius or 8)
	addStroke(frame, 1, 0.62)
	return frame
end

local function bindFocusStroke(gui)
	local stroke = addStroke(gui, 1, 0.55)
	if gui:IsA("TextBox") then
		gui.Focused:Connect(function()
			tween(stroke, TWEEN_SNAP, {
				Transparency = 0.08,
				Thickness = 1.6,
				Color = CONFIG.THEME.PRIMARY,
			})
		end)
		gui.FocusLost:Connect(function()
			tween(stroke, TWEEN_SNAP, {
				Transparency = 0.55,
				Thickness = 1,
				Color = CONFIG.THEME.STROKE or CONFIG.THEME.SECONDARY,
			})
		end)
	end
	return stroke
end

local function slideReveal(gui, dy)
	if not gui or not gui.Visible then
		return
	end
	local m = motionAmount()
	if m <= 0.02 then
		return
	end
	local fx = currentFx()
	gui.Rotation = 0
	local pos = gui.Position
	if fx.motion == "glitch" then
		gui.Position = UDim2.new(pos.X.Scale, pos.X.Offset + math.floor(10 * m), pos.Y.Scale, pos.Y.Offset)
		tween(gui, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos })
		return
	end
	if fx.motion == "cascade" then
		gui.Position = UDim2.new(pos.X.Scale, pos.X.Offset - math.floor(22 * m), pos.Y.Scale, pos.Y.Offset)
		tween(gui, fxTween("slide"), { Position = pos })
		return
	end
	dy = (dy or fx.slideDy or 10) * m
	gui.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + dy)
	tween(gui, fxTween("slide"), { Position = pos })
end

local function showModal(frame, width, height)
	if not frame then
		return
	end
	playThemeSound("open")
	if overlayDim then
		overlayDim.Visible = true
		overlayDim.BackgroundTransparency = 1
		tween(overlayDim, TWEEN_SOFT, { BackgroundTransparency = 0.48 })
	end
	frame.Visible = true
	frame.Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2 + 28)
	tween(frame, TWEEN_SLIDE, { Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2) })
end

local function hideModal(frame, width, height)
	if not frame then
		return
	end
	tween(frame, TWEEN_SOFT, { Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2 + 18) })
	task.delay(0.2, function()
		if frame and frame.Parent then
			frame.Visible = false
		end
	end)
	local otherOpen = helpFrame and helpFrame.Visible and helpFrame ~= frame
	if overlayDim and not otherOpen then
		local t = tween(overlayDim, TWEEN_SOFT, { BackgroundTransparency = 1 })
		if t then
			t.Completed:Connect(function()
				if overlayDim and overlayDim.BackgroundTransparency > 0.9 then
					overlayDim.Visible = false
				end
			end)
		end
	end
end

local function hideTip()
	if not tipGui or not tipGui.Visible then
		return
	end
	local seq = tipSeq
	tween(tipGui, TWEEN_SNAP, { BackgroundTransparency = 1 })
	if tipDoesLabel then
		tween(tipDoesLabel, TWEEN_SNAP, { TextTransparency = 1 })
	end
	if tipRiskLabel then
		tween(tipRiskLabel, TWEEN_SNAP, { TextTransparency = 1 })
	end
	task.delay(0.12, function()
		if tipGui and seq == tipSeq then
			tipGui.Visible = false
		end
	end)
end

local function showTip(host, does, risk)
	if not screenGui or not host then
		return
	end
	if not tipGui or not tipGui.Parent then
		tipGui = Instance.new("Frame")
		tipGui.Name = "HoverTip"
		tipGui.AutomaticSize = Enum.AutomaticSize.Y
		tipGui.Size = UDim2.new(0, 280, 0, 0)
		tipGui.BackgroundColor3 = CONFIG.THEME.BACKGROUND
		tipGui.BorderSizePixel = 0
		tipGui.Visible = false
		tipGui.ZIndex = 100
		tipGui.Active = false
		tipGui.Parent = screenGui
		addCorner(tipGui, 8)
		addStroke(tipGui, 1, 0.4)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 8)
		pad.PaddingBottom = UDim.new(0, 8)
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		pad.Parent = tipGui
		local list = Instance.new("UIListLayout")
		list.Padding = UDim.new(0, 4)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = tipGui
		tipDoesLabel = Instance.new("TextLabel")
		tipDoesLabel.BackgroundTransparency = 1
		tipDoesLabel.Font = Enum.Font.Gotham
		tipDoesLabel.TextSize = 12
		tipDoesLabel.TextColor3 = CONFIG.THEME.TEXT
		tipDoesLabel.TextXAlignment = Enum.TextXAlignment.Left
		tipDoesLabel.TextWrapped = true
		tipDoesLabel.AutomaticSize = Enum.AutomaticSize.Y
		tipDoesLabel.Size = UDim2.new(1, 0, 0, 0)
		tipDoesLabel.ZIndex = 101
		tipDoesLabel.LayoutOrder = 1
		tipDoesLabel.Parent = tipGui
		tipRiskLabel = Instance.new("TextLabel")
		tipRiskLabel.BackgroundTransparency = 1
		tipRiskLabel.Font = Enum.Font.Gotham
		tipRiskLabel.TextSize = 11
		tipRiskLabel.TextColor3 = CONFIG.THEME.WARNING
		tipRiskLabel.TextXAlignment = Enum.TextXAlignment.Left
		tipRiskLabel.TextWrapped = true
		tipRiskLabel.AutomaticSize = Enum.AutomaticSize.Y
		tipRiskLabel.Size = UDim2.new(1, 0, 0, 0)
		tipRiskLabel.ZIndex = 101
		tipRiskLabel.LayoutOrder = 2
		tipRiskLabel.Parent = tipGui
	end
	tipDoesLabel.Text = does or ""
	tipRiskLabel.Text = risk or ""
	tipRiskLabel.Visible = risk ~= nil and risk ~= ""
	tipGui.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	tipDoesLabel.TextColor3 = CONFIG.THEME.TEXT
	tipRiskLabel.TextColor3 = CONFIG.THEME.WARNING
	local abs = host.AbsolutePosition
	local size = host.AbsoluteSize
	local parentAbs = screenGui.AbsolutePosition
	local x = abs.X - parentAbs.X
	local y = abs.Y - parentAbs.Y + size.Y + 6
	local view = screenGui.AbsoluteSize
	if x + 280 > view.X then
		x = math.max(4, view.X - 288)
	end
	if y + 80 > view.Y then
		y = math.max(4, abs.Y - parentAbs.Y - 86)
	end
	tipGui.Position = UDim2.fromOffset(x, y)
	tipGui.BackgroundTransparency = 1
	tipDoesLabel.TextTransparency = 1
	tipRiskLabel.TextTransparency = 1
	local pop = tipGui:FindFirstChild("GAI_TipScale")
	if not pop then
		pop = Instance.new("UIScale")
		pop.Name = "GAI_TipScale"
		pop.Parent = tipGui
	end
	pop.Scale = 0.94
	tipGui.Visible = true
	tween(tipGui, TWEEN_SNAP, { BackgroundTransparency = 0 })
	tween(tipDoesLabel, TWEEN_SNAP, { TextTransparency = 0 })
	tween(tipRiskLabel, TWEEN_SNAP, { TextTransparency = 0 })
	tween(pop, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
end

attachTip = function(gui, spec)
	if not gui or type(spec) ~= "table" then
		return
	end
	local does = spec.does or ""
	local risk = spec.risk or ""
	gui.MouseEnter:Connect(function()
		tipSeq = tipSeq + 1
		local seq = tipSeq
		task.delay(0.16, function()
			if seq ~= tipSeq then
				return
			end
			showTip(gui, does, risk)
		end)
	end)
	gui.MouseLeave:Connect(function()
		tipSeq = tipSeq + 1
		hideTip()
	end)
end

local function bindSharedInput()
	if sharedInputBound then
		return
	end
	sharedInputBound = true
	UserInputService.InputChanged:Connect(function(input)
		local move = input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		if not move then
			return
		end
		if activeSliderDrag then
			activeSliderDrag(input.Position.X)
			return
		end
		local drag = activeFrameDrag
		if not drag then
			return
		end
		if not drag.target or not drag.target.Parent then
			activeFrameDrag = nil
			return
		end
		local deltaX = input.Position.X - drag.start.X
		local deltaY = input.Position.Y - drag.start.Y
		drag.target.Position = UDim2.new(
			drag.pos.X.Scale,
			drag.pos.X.Offset + deltaX,
			drag.pos.Y.Scale,
			drag.pos.Y.Offset + deltaY
		)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			activeSliderDrag = nil
			activeFrameDrag = nil
		end
	end)
end

local function makeLabel(props)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextColor3 = CONFIG.THEME.TEXT
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Tip" then
			label[k] = v
		end
	end
	label.Parent = props.Parent
	if props.Tip then
		attachTip(label, props.Tip)
	end
	return label
end

local function makeButton(props)
	local button = Instance.new("TextButton")
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.TextColor3 = CONFIG.THEME.TEXT
	button.TextSize = 13
	button.AutoButtonColor = false
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "CornerRadius" and k ~= "Tip" then
			button[k] = v
		end
	end
	button.Parent = props.Parent
	addCorner(button, props.CornerRadius or 8)
	local btnScale = Instance.new("UIScale")
	btnScale.Name = "GAI_BtnScale"
	btnScale.Parent = button
	local btnStroke
	if (props.BackgroundTransparency or 0) < 0.85 then
		btnStroke = addStroke(button, 1, 0.78)
	end
	local hoverBase
	local function colorClose(a, b)
		return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.05
	end
	button.MouseEnter:Connect(function()
		hoverBase = button.BackgroundColor3
		tween(button, fxTween("hover"), { BackgroundColor3 = hoverTint(hoverBase) })
		tween(btnScale, fxTween("hover"), { Scale = scaledHover() })
		if btnStroke then
			tween(btnStroke, fxTween("hover"), {
				Transparency = 0.32,
				Color = CONFIG.THEME.PRIMARY,
			})
		end
		if button.BackgroundTransparency < 0.9 then
			playThemeSound("hover")
		end
	end)
	button.MouseLeave:Connect(function()
		local base = hoverBase
		hoverBase = nil
		tween(btnScale, fxTween("hover"), { Scale = 1 })
		if btnStroke then
			tween(btnStroke, fxTween("hover"), {
				Transparency = 0.78,
				Color = CONFIG.THEME.STROKE or CONFIG.THEME.SECONDARY,
			})
		end
		if not base then
			return
		end
		local cur = button.BackgroundColor3
		if colorClose(cur, hoverTint(base)) or colorClose(cur, base) then
			tween(button, fxTween("hover"), { BackgroundColor3 = base })
		end
	end)
	local pressTrans
	button.MouseButton1Down:Connect(function()
		pressTrans = button.BackgroundTransparency
		if pressTrans < 0.9 then
			tween(button, fxTween("hover"), { BackgroundTransparency = math.min(0.2, pressTrans + 0.08) })
		end
		tween(btnScale, fxTween("hover"), { Scale = scaledClick() })
		if pressTrans < 0.9 then
			playThemeSound("click")
		end
	end)
	button.MouseButton1Up:Connect(function()
		if pressTrans ~= nil and pressTrans < 0.9 then
			tween(button, fxTween("hover"), { BackgroundTransparency = pressTrans })
		end
		tween(btnScale, fxTween("hover"), { Scale = hoverBase and scaledHover() or 1 })
	end)
	if props.Tip then
		attachTip(button, props.Tip)
	end
	return button
end

local function makeToggle(props)
	local on = props.Value and true or false
	local row = Instance.new("Frame")
	row.Name = props.Name or "ToggleRow"
	row.Size = props.Size or UDim2.new(0, 240, 0, 28)
	row.Position = props.Position or UDim2.new(0, 0, 0, 0)
	row.BackgroundTransparency = 1
	row.Parent = props.Parent

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -54, 1, 0),
		Text = props.Text or "Toggle",
		TextSize = props.TextSize or 12,
		Tip = props.Tip,
	})

	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.Size = UDim2.new(0, 44, 0, 22)
	track.Position = UDim2.new(1, -44, 0.5, -11)
	track.BackgroundColor3 = on and (CONFIG.THEME[props.OnColorName or "SUCCESS"] or CONFIG.THEME.SUCCESS) or CONFIG.THEME.SECONDARY
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = row
	addCorner(track, 11)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.Position = UDim2.new(0, on and 24 or 2, 0.5, 0)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = track
	addCorner(knob, 9)
	local knobScale = Instance.new("UIScale")
	knobScale.Name = "GAI_KnobScale"
	knobScale.Parent = knob

	local function paint()
		if not track.Parent then
			return
		end
		local onColor = CONFIG.THEME[props.OnColorName or "SUCCESS"] or CONFIG.THEME.SUCCESS
		track.BackgroundColor3 = on and onColor or CONFIG.THEME.SECONDARY
		tween(knob, fxTween("hover"), { Position = UDim2.new(0, on and 24 or 2, 0.5, 0) })
		knobScale.Scale = 0.86
		tween(knobScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	end

	local function set(value, silent)
		on = value and true or false
		paint()
		if not silent and props.OnChanged then
			props.OnChanged(on)
		end
	end

	track.MouseEnter:Connect(function()
		playThemeSound("hover")
	end)
	track.MouseButton1Click:Connect(function()
		playThemeSound("click")
		set(not on)
	end)
	if props.Tip then
		attachTip(track, props.Tip)
	end
	local widget = { Root = row, Set = set, Get = function()
		return on
	end, Track = track, Paint = paint }
	table.insert(liveToggles, widget)
	return widget
end

local function makeSlider(props)
	local minV = props.Min or 0
	local maxV = props.Max or 1
	local value = tonumber(props.Value) or minV
	local row = Instance.new("Frame")
	row.Name = props.Name or "SliderRow"
	row.Size = props.Size or UDim2.new(1, -20, 0, 38)
	row.Position = props.Position or UDim2.new(0, 0, 0, 0)
	row.BackgroundTransparency = 1
	row.Parent = props.Parent

	makeLabel({
		Parent = row,
		Size = UDim2.new(0.7, 0, 0, 16),
		Text = props.Text or "Slider",
		TextSize = 12,
		Tip = props.Tip,
	})

	local valueLabel = makeLabel({
		Parent = row,
		Size = UDim2.new(0.3, 0, 0, 16),
		Position = UDim2.new(0.7, 0, 0, 0),
		Text = "",
		TextSize = 11,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.Size = UDim2.new(1, 0, 0, 10)
	track.Position = UDim2.new(0, 0, 0, 22)
	track.BackgroundColor3 = CONFIG.THEME.SECONDARY
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = row
	addCorner(track, 5)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = CONFIG.THEME.PRIMARY
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 5)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = CONFIG.THEME.TEXT
	knob.BorderSizePixel = 0
	knob.ZIndex = 2
	knob.Parent = track
	addCorner(knob, 8)

	local function formatValue(v)
		if props.Format then
			return props.Format(v)
		end
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end

	local function paint()
		local span = maxV - minV
		local a = 0
		if span ~= 0 then
			a = (value - minV) / span
		end
		if a < 0 then
			a = 0
		end
		if a > 1 then
			a = 1
		end
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = formatValue(value)
	end

	local function setFromX(x)
		local absX = track.AbsolutePosition.X
		local width = track.AbsoluteSize.X
		local a = 0
		if width > 0 then
			a = (x - absX) / width
		end
		if a < 0 then
			a = 0
		end
		if a > 1 then
			a = 1
		end
		value = minV + a * (maxV - minV)
		paint()
		if props.OnChanged then
			props.OnChanged(value)
		end
	end

	bindSharedInput()
	track.MouseButton1Down:Connect(function()
		activeSliderDrag = setFromX
		playThemeSound("click")
		setFromX(UserInputService:GetMouseLocation().X)
	end)
	paint()
	return { Root = row, Get = function()
		return value
	end, Set = function(v)
		value = tonumber(v) or value
		paint()
	end }
end

local toastHost
local toastCount = 0
local lastToastKey = ""
local lastToastAt = 0

local function ensureToastHost()
	local parent = mainFrame or screenGui
	if toastHost and toastHost.Parent == parent then
		toastHost.Visible = not isMinimized
		return (not isMinimized) and toastHost or nil
	end
	if toastHost then
		pcall(function()
			toastHost:Destroy()
		end)
		toastHost = nil
	end
	if not parent then
		return nil
	end
	toastHost = Instance.new("Frame")
	toastHost.Name = "GAI_Toasts"
	toastHost.Size = UDim2.new(0, 280, 0, 220)
	toastHost.BackgroundTransparency = 1
	toastHost.ZIndex = 80
	toastHost.ClipsDescendants = false
	if parent == mainFrame then
		toastHost.AnchorPoint = Vector2.new(1, 0)
		toastHost.Position = UDim2.new(1, -10, 0, 50)
	else
		toastHost.Position = UDim2.new(1, -316, 0, 12)
	end
	toastHost.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Parent = toastHost
	toastHost.Visible = not isMinimized
	return toastHost
end

showToast = function(title, body, kind)
	if CONFIG.TOASTS == false or isMinimized then
		return
	end
	local host = ensureToastHost()
	if not host then
		return
	end
	local key = tostring(title) .. "\0" .. tostring(body)
	local now = tick()
	if key == lastToastKey and (now - lastToastAt) < 0.45 then
		return
	end
	lastToastKey = key
	lastToastAt = now
	if toastCount >= 3 then
		local oldest
		for _, child in ipairs(host:GetChildren()) do
			if child:IsA("Frame") then
				oldest = child
				break
			end
		end
		if oldest then
			toastCount = math.max(0, toastCount - 1)
			oldest:Destroy()
		end
	end
	toastCount = toastCount + 1
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 52)
	card.BackgroundColor3 = CONFIG.THEME.PANEL
	card.BorderSizePixel = 0
	card.ZIndex = 81
	card.BackgroundTransparency = 1
	card.Parent = host
	addCorner(card, 8)
	addStroke(card, 1, 0.35)
	local pop = Instance.new("UIScale")
	pop.Name = "GAI_ToastScale"
	pop.Scale = 0.88
	pop.Parent = card
	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 4, 1, -8)
	accent.Position = UDim2.new(0, 4, 0, 4)
	accent.BorderSizePixel = 0
	accent.BackgroundColor3 = kind == "value" and CONFIG.THEME.ERROR
		or (kind == "remote" and CONFIG.THEME.WARNING or CONFIG.THEME.PRIMARY)
	accent.ZIndex = 82
	accent.Parent = card
	addCorner(accent, 2)
	makeLabel({
		Parent = card,
		Size = UDim2.new(1, -18, 0, 16),
		Position = UDim2.new(0, 14, 0, 4),
		Text = truncateText(title or "Notice", 42),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
	})
	makeLabel({
		Parent = card,
		Size = UDim2.new(1, -18, 0, 28),
		Position = UDim2.new(0, 14, 0, 20),
		Text = truncateText(body or "", 90),
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})
	tween(card, fxTween("hover"), { BackgroundTransparency = 0 })
	tween(pop, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	playThemeSound("success")
	task.delay(2.8, function()
		if card and card.Parent then
			tween(card, TWEEN_SOFT, { BackgroundTransparency = 1 })
			tween(pop, TWEEN_SOFT, { Scale = 0.9 })
			for _, child in ipairs(card:GetChildren()) do
				if child:IsA("TextLabel") then
					tween(child, TWEEN_SOFT, { TextTransparency = 1 })
				end
			end
			task.delay(0.22, function()
				if card and card.Parent then
					card:Destroy()
				end
				toastCount = math.max(0, toastCount - 1)
			end)
		end
	end)
end

local function currentUiScale()
	local s = tonumber(CONFIG.UI_SCALE) or 1
	if s < 0.7 then
		s = 0.7
	end
	if s > 1.4 then
		s = 1.4
	end
	return s
end

local function attachUserScale(inst, scale)
	if not inst then
		return nil
	end
	local sc = inst:FindFirstChild("GAI_UserScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Name = "GAI_UserScale"
		sc.Parent = inst
	end
	sc.Scale = scale
	return sc
end

applyUiScale = function()
	local s = currentUiScale()
	CONFIG.UI_SCALE = s
	attachUserScale(mainFrame, s)
	attachUserScale(apiKeyGate, s)
	attachUserScale(helpFrame, s)
	if mainFrame and not isMinimized then
		local w = CONFIG.WINDOW_SIZE.X.Offset
		local h = CONFIG.WINDOW_SIZE.Y.Offset
		mainFrame.Position = UDim2.new(0.5, -math.floor(w * s / 2), 0.5, -math.floor(h * s / 2))
	end
	if apiKeyGate and apiKeyGate.Visible then
		apiKeyGate.Position = UDim2.new(0.5, -math.floor(240 * s), 0.5, -math.floor(150 * s))
	end
end

local function hotkeyName(id)
	local map = CONFIG.HOTKEYS
	if type(map) ~= "table" then
		return nil
	end
	local name = map[id]
	if type(name) ~= "string" or name == "" or name == "None" then
		return nil
	end
	return name
end

local function hotkeyCode(id)
	local name = hotkeyName(id)
	if not name then
		return nil
	end
	local ok, code = pcall(function()
		return Enum.KeyCode[name]
	end)
	if ok and typeof(code) == "EnumItem" then
		return code
	end
	return nil
end

local function setHotkey(id, name)
	CONFIG.HOTKEYS = CONFIG.HOTKEYS or {}
	if name and name ~= "" then
		for otherId, otherName in pairs(CONFIG.HOTKEYS) do
			if otherId ~= id and otherName == name then
				CONFIG.HOTKEYS[otherId] = "None"
				local otherBtn = hotkeyButtons[otherId]
				if otherBtn then
					otherBtn.Text = "None"
				end
			end
		end
		CONFIG.HOTKEYS[id] = name
	else
		CONFIG.HOTKEYS[id] = "None"
	end
	local btn = hotkeyButtons[id]
	if btn then
		btn.Text = CONFIG.HOTKEYS[id]
		btn.BackgroundColor3 = CONFIG.THEME.PRIMARY
	end
end

local function refreshHotkeyButtons()
	for _, spec in ipairs(HOTKEY_SPECS) do
		local btn = hotkeyButtons[spec.id]
		if btn then
			btn.Text = hotkeyName(spec.id) or "None"
			btn.BackgroundColor3 = CONFIG.THEME.PRIMARY
		end
	end
end

local function refreshThemeButtons()
	for key, btn in pairs(themeButtons) do
		if btn and btn.Parent then
			local active = key == CONFIG.THEME_NAME
			btn.BackgroundColor3 = active and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY
		end
	end
end

local function cancelHotkeyWait()
	if waitingHotkeyId and hotkeyButtons[waitingHotkeyId] then
		hotkeyButtons[waitingHotkeyId].Text = hotkeyName(waitingHotkeyId) or "None"
		hotkeyButtons[waitingHotkeyId].BackgroundColor3 = CONFIG.THEME.PRIMARY
	end
	waitingHotkeyId = nil
end

local function typingInBox()
	local box = UserInputService:GetFocusedTextBox()
	return box ~= nil
end

local function prefsBag()
	local getgenvFn = safeGlobal("getgenv")
	if type(getgenvFn) == "function" then
		local ok, env = pcall(getgenvFn)
		if ok and type(env) == "table" then
			env.GAI_Prefs = env.GAI_Prefs or {}
			return env.GAI_Prefs
		end
	end
	_G.GAI_Prefs = _G.GAI_Prefs or {}
	return _G.GAI_Prefs
end

local function loadPrefs()
	local data = prefsBag()
	if type(data) ~= "table" then
		return
	end
	if type(data.HOTKEYS) == "table" then
		CONFIG.HOTKEYS = CONFIG.HOTKEYS or {}
		for _, spec in ipairs(HOTKEY_SPECS) do
			if type(data.HOTKEYS[spec.id]) == "string" then
				CONFIG.HOTKEYS[spec.id] = data.HOTKEYS[spec.id]
			end
		end
	end
	if type(data.UI_SCALE) == "number" then
		local s = data.UI_SCALE
		if s < 0.7 then
			s = 0.7
		end
		if s > 1.4 then
			s = 1.4
		end
		CONFIG.UI_SCALE = s
	end
	if data.TOASTS ~= nil then
		CONFIG.TOASTS = data.TOASTS and true or false
	end
	if type(data.THEME_NAME) == "string" and THEMES[data.THEME_NAME] then
		CONFIG.THEME_NAME = data.THEME_NAME
		CONFIG.THEME = THEMES[data.THEME_NAME]
	end
	if data.SOUNDS ~= nil then
		CONFIG.SOUNDS = data.SOUNDS and true or false
	end
	if type(data.SOUND_VOLUME) == "number" then
		local v = data.SOUND_VOLUME
		if v < 0 then
			v = 0
		end
		if v > 1 then
			v = 1
		end
		CONFIG.SOUND_VOLUME = v
	end
	if type(data.MOTION) == "number" then
		local m = data.MOTION
		if m < 0 then
			m = 0
		end
		if m > 1 then
			m = 1
		end
		CONFIG.MOTION = m
	end
	if data.SPY_AUTO_OFF ~= nil then
		CONFIG.SPY_AUTO_OFF = data.SPY_AUTO_OFF and true or false
	end
	if type(data.LAST_TAB) == "string" and data.LAST_TAB ~= "" then
		CONFIG.LAST_TAB = data.LAST_TAB
	end
	if data.SIDEBAR_FOLDED ~= nil then
		CONFIG.SIDEBAR_FOLDED = data.SIDEBAR_FOLDED and true or false
	end
end

local function savePrefs()
	local bag = prefsBag()
	bag.HOTKEYS = CONFIG.HOTKEYS
	bag.UI_SCALE = CONFIG.UI_SCALE
	bag.TOASTS = CONFIG.TOASTS
	bag.THEME_NAME = CONFIG.THEME_NAME
	bag.SOUNDS = CONFIG.SOUNDS
	bag.SOUND_VOLUME = CONFIG.SOUND_VOLUME
	bag.MOTION = CONFIG.MOTION
	bag.SPY_AUTO_OFF = CONFIG.SPY_AUTO_OFF
	bag.LAST_TAB = CONFIG.LAST_TAB
	bag.SIDEBAR_FOLDED = CONFIG.SIDEBAR_FOLDED
end

local function resolvePath(path)
	local current = game
	for segment in string.gmatch(path, "[^%.]+") do
		local nextInst = current:FindFirstChild(segment)
		if not nextInst and current == game then
			local ok, svc = pcall(function()
				return game:GetService(segment)
			end)
			if ok and svc then
				nextInst = svc
			end
		end
		if not nextInst then
			return nil
		end
		current = nextInst
	end
	return current
end

-- Short tokens need word boundaries so "ac" does not match "Character"
local function stringContainsKeyword(text, keywords)
	text = string.lower(tostring(text))
	for _, keyword in ipairs(keywords) do
		if #keyword <= 3 then
			if string.find(text, "%f[%a]" .. keyword .. "%f[%A]") then
				return true
			end
		elseif string.find(text, keyword, 1, true) then
			return true
		end
	end
	return false
end

local function expandQueryKeywords(query)
	local seen = {}
	local keywords = {}

	local function add(word)
		word = string.lower(word)
		if #word < 3 or seen[word] then
			return
		end
		seen[word] = true
		table.insert(keywords, word)
		for _, aliases in pairs(TOPIC_ALIASES) do
			local inGroup = false
			for _, alias in ipairs(aliases) do
				if alias == word or string.find(word, alias, 1, true) or string.find(alias, word, 1, true) then
					inGroup = true
					break
				end
			end
			if inGroup then
				for _, alias in ipairs(aliases) do
					if not seen[alias] then
						seen[alias] = true
						table.insert(keywords, alias)
					end
				end
			end
		end
	end

	for word in string.gmatch(string.lower(query), "[%a_]+") do
		add(word)
	end
	return keywords
end

local globalCache = {}
local decompileCache = {}
local dumpCache = {}
local remoteByPath = {}
local lastCapKey = ""
local lastCapAt = 0

local function safeGlobal(name)
	local cached = globalCache[name]
	if cached ~= nil then
		if cached == false then
			return nil
		end
		return cached
	end
	local function take(ok, val)
		if ok and val ~= nil then
			globalCache[name] = val
			return val
		end
		return nil
	end
	local found = take(pcall(function()
		return getgenv()[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		return getfenv()[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		return getfenv(0)[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		return getfenv(1)[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		return getrenv()[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		return _G[name]
	end))
	if found ~= nil then
		return found
	end
	found = take(pcall(function()
		local syn = getgenv().syn
		return type(syn) == "table" and syn[name] or nil
	end))
	if found ~= nil then
		return found
	end
	globalCache[name] = false
	return nil
end

local function getHttpRequest()
	for _, name in ipairs({ "request", "http_request", "httpRequest" }) do
		local fn = safeGlobal(name)
		if type(fn) == "function" then
			return fn
		end
	end
	for _, name in ipairs({ "syn", "http", "fluxus", "krnl" }) do
		local bag = safeGlobal(name)
		if type(bag) == "table" and type(bag.request) == "function" then
			return bag.request
		end
	end
	return nil
end

local function httpRequest(opts)
	local req = getHttpRequest()
	if type(req) == "function" then
		local method = opts.Method or "POST"
		local ok, res = pcall(req, {
			Url = opts.Url,
			url = opts.Url,
			Method = method,
			method = method,
			Headers = opts.Headers,
			headers = opts.Headers,
			Body = opts.Body,
			body = opts.Body,
		})
		if not ok or type(res) ~= "table" then
			return nil, tostring(res)
		end
		local status = tonumber(res.StatusCode or res.Status or res.status_code or res.status) or 0
		local body = res.Body or res.body or res.Text or res.text or ""
		if type(body) == "table" then
			local okJson, encoded = pcall(function()
				return HttpService:JSONEncode(body)
			end)
			body = okJson and encoded or ""
		end
		local success = res.Success
		if success == nil then
			success = res.success
		end
		if success == nil then
			success = status >= 200 and status < 300
		end
		return {
			Success = success and true or false,
			StatusCode = status,
			StatusMessage = res.StatusMessage or res.status_message or res.Status or tostring(status),
			Body = body,
		}
	end
	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = opts.Url,
			Method = opts.Method or "POST",
			Headers = opts.Headers,
			Body = opts.Body,
		})
	end)
	if not ok then
		return nil, "No executor request() and HttpService failed: " .. tostring(res)
	end
	return res
end

local function parentScreenGui(gui)
	pcall(function()
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 2147483647
		gui.Enabled = true
	end)
	local function tryParent(target)
		if not target then
			return false
		end
		local ok = pcall(function()
			gui.Parent = target
		end)
		return ok and gui.Parent ~= nil
	end
	if not playerGui then
		playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
	end
	local syn = safeGlobal("syn")
	if type(syn) == "table" and type(syn.protect_gui) == "function" then
		pcall(syn.protect_gui, gui)
	end
	local hid = safeGlobal("hidegui") or safeGlobal("protect_gui")
	if type(hid) == "function" then
		pcall(hid, gui)
	end
	for _, name in ipairs({ "gethui", "gethiddenui", "get_hidden_gui", "gethiddenhui" }) do
		local gethui = safeGlobal(name)
		if type(gethui) == "function" then
			local ok, hui = pcall(gethui)
			if ok and tryParent(hui) then
				return true
			end
		end
	end
	local coreGui
	pcall(function()
		coreGui = game:GetService("CoreGui")
		local cloneref = safeGlobal("cloneref")
		if type(cloneref) == "function" then
			coreGui = cloneref(coreGui)
		end
	end)
	if tryParent(coreGui) then
		return true
	end
	if tryParent(playerGui) then
		return true
	end
	local t0 = tick()
	while tick() - t0 < 6 do
		playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
		if tryParent(playerGui) then
			return true
		end
		task.wait(0.15)
	end
	pcall(function()
		warn("GameAnalysisAI: could not parent the window (no gethui/CoreGui/PlayerGui).")
	end)
	return false
end

local function getSavedApiKey()
	local envVal = safeGlobal("GAI_API_KEY") or safeGlobal("OPENAI_API_KEY")
	if type(envVal) == "string" and envVal ~= "" then
		return envVal
	end
	local getgenvFn = safeGlobal("getgenv")
	if type(getgenvFn) == "function" then
		local ok, env = pcall(getgenvFn)
		if ok and type(env) == "table" then
			local key = env.GAI_API_KEY or env.OPENAI_API_KEY
			if type(key) == "string" and key ~= "" then
				return key
			end
		end
	end
	return nil
end

local function colorKey(c)
	return string.format("%.3f,%.3f,%.3f", c.R, c.G, c.B)
end

local function copyPath(path)
	local clip = safeGlobal("setclipboard") or safeGlobal("toclipboard")
	if type(clip) == "function" then
		pcall(clip, path)
		addMessage("Copied: " .. path, false)
	else
		addMessage("Path: " .. path, false)
	end
end

local LOOK_DECOR = {
	GAI_LookGradient = true,
	GAI_LookSky = true,
	GAI_LookGloss = true,
	GAI_LookStar = true,
	GAI_LookGlow = true,
	GAI_LookNebula = true,
	GAI_LookBubble = true,
	GAI_LookScanline = true,
	GAI_LookPetal = true,
	GAI_LookRain = true,
	GAI_LookSun = true,
	GAI_LookSnow = true,
	GAI_LookCrystal = true,
}

local LOOK_GLASS = {
	aero = { main = 0.06, btn = 0.1, frame = 0.16, strokeT = 0.32, strokeW = 1.2 },
	galaxy = { main = 0.1, btn = 0.18, frame = 0.26, strokeT = 0.18, strokeW = 1.45 },
	cyber = { main = 0.08, btn = 0.14, frame = 0.22, strokeT = 0.12, strokeW = 1.55 },
	sakura = { main = 0.05, btn = 0.08, frame = 0.12, strokeT = 0.4, strokeW = 1.15 },
	matrix = { main = 0.12, btn = 0.2, frame = 0.28, strokeT = 0.22, strokeW = 1.25 },
	sunset = { main = 0.08, btn = 0.14, frame = 0.2, strokeT = 0.28, strokeW = 1.25 },
	frost = { main = 0.05, btn = 0.1, frame = 0.14, strokeT = 0.35, strokeW = 1.2 },
}

local LOOK_SKIP_CLASS = {
	UICorner = true,
	UIListLayout = true,
	UIGridLayout = true,
	UIPadding = true,
	UIScale = true,
	UIGradient = true,
	UIStroke = true,
	UIAspectRatioConstraint = true,
	TextLabel = true,
	TextBox = true,
	ScrollingFrame = true,
	ImageLabel = true,
	ImageButton = true,
	Folder = true,
	Sound = true,
	ScreenGui = true,
}

local function isLookDecor(inst)
	return inst and LOOK_DECOR[inst.Name] == true
end

local function stopLookPulse()
	if lookPulseConn then
		lookPulseConn:Disconnect()
		lookPulseConn = nil
	end
	if lookAddedConn then
		lookAddedConn:Disconnect()
		lookAddedConn = nil
	end
end

local LOOK_PULSE_STEP = 1 / 24
local function bindLookPulse(update)
	local acc = 0
	lookPulseConn = RunService.Heartbeat:Connect(function(dt)
		if isMinimized or not mainFrame or not mainFrame.Visible then
			acc = 0
			return
		end
		local amp = motionAmount()
		if amp <= 0.02 then
			return
		end
		acc = acc + dt
		if acc < LOOK_PULSE_STEP then
			return
		end
		local step = acc
		acc = 0
		update(step, amp, os.clock())
	end)
end

local function isTinyChrome(inst)
	if not inst:IsA("GuiObject") then
		return true
	end
	local y = inst.Size.Y
	local x = inst.Size.X
	if y.Scale == 0 and y.Offset > 0 and y.Offset <= 6 then
		return true
	end
	if x.Scale == 0 and x.Offset > 0 and x.Offset <= 4 then
		return true
	end
	return false
end

local function shouldSkipLookGlass(inst)
	if not inst or not inst:IsA("GuiObject") then
		return true
	end
	if isLookDecor(inst) then
		return true
	end
	if inst.Parent and isLookDecor(inst.Parent) then
		return true
	end
	if inst == overlayDim or inst.Name == "TabUnderline" or inst.Name == "GAI_Toasts" then
		return true
	end
	local walk = inst.Parent
	while walk and walk ~= screenGui do
		if isLookDecor(walk) or walk.Name == "GAI_Toasts" or walk.Name == "OverlayDim" then
			return true
		end
		walk = walk.Parent
	end
	if inst:IsA("TextBox") or inst:IsA("ScrollingFrame") or inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		return true
	end
	if inst:IsA("TextLabel") then
		return true
	end
	if isTinyChrome(inst) then
		return true
	end
	return false
end

local function restoreLookBase(root)
	local function restoreOne(inst)
		if inst:IsA("GuiObject") then
			local base = inst:GetAttribute("GAI_BaseTrans")
			if base ~= nil then
				inst.BackgroundTransparency = base
			end
		end
		if inst:IsA("UIStroke") and inst.Name ~= "GAI_LookGlow" then
			local th = inst:GetAttribute("GAI_BaseStroke")
			local tr = inst:GetAttribute("GAI_BaseStrokeTrans")
			if th ~= nil then
				inst.Thickness = th
			end
			if tr ~= nil then
				inst.Transparency = tr
			end
		end
	end
	restoreOne(root)
	for _, d in ipairs(root:GetDescendants()) do
		restoreOne(d)
	end
end

local function stripLookDecor(root)
	local doomed = {}
	local function consider(inst)
		if isLookDecor(inst) then
			table.insert(doomed, inst)
		end
	end
	consider(root)
	for _, d in ipairs(root:GetDescendants()) do
		consider(d)
	end
	for _, inst in ipairs(doomed) do
		if inst.Parent then
			inst:Destroy()
		end
	end
end

local function addLookGradient(parent, colorSeq, rot, transSeq)
	if not parent then
		return nil
	end
	local g = Instance.new("UIGradient")
	g.Name = "GAI_LookGradient"
	g.Color = colorSeq
	g.Rotation = rot or 90
	if transSeq then
		g.Transparency = transSeq
	end
	g.Parent = parent
	return g
end

local function decorateLookInstance(inst)
	if not inst or LOOK_SKIP_CLASS[inst.ClassName] then
		return
	end
	local look = themeLook()
	local glass = look and LOOK_GLASS[look]
	if not glass then
		return
	end
	if shouldSkipLookGlass(inst) then
		return
	end
	if not inst:IsA("Frame") and not inst:IsA("TextButton") then
		return
	end
	if inst.BackgroundTransparency >= 1 then
		return
	end
	if inst:GetAttribute("GAI_BaseTrans") == nil then
		inst:SetAttribute("GAI_BaseTrans", inst.BackgroundTransparency)
	end
	local base = inst:GetAttribute("GAI_BaseTrans")
	if inst == mainFrame then
		inst.BackgroundTransparency = math.max(base, glass.main)
	elseif inst:IsA("TextButton") then
		inst.BackgroundTransparency = math.max(base, glass.btn)
	else
		inst.BackgroundTransparency = math.max(base, glass.frame)
	end
	if not inst:FindFirstChild("GAI_LookGradient") then
		if look == "aero" or look == "sakura" or look == "frost" then
			if inst:IsA("TextButton") then
				addLookGradient(
					inst,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(0.45, inst.BackgroundColor3),
						ColorSequenceKeypoint.new(1, inst.BackgroundColor3),
					}),
					90,
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.28),
						NumberSequenceKeypoint.new(1, 0.72),
					})
				)
			else
				addLookGradient(
					inst,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(1, inst.BackgroundColor3),
					}),
					90,
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.38),
						NumberSequenceKeypoint.new(1, 0.76),
					})
				)
			end
		elseif look == "galaxy" or look == "cyber" or look == "sunset" then
			local top = look == "cyber" and Color3.fromRGB(255, 60, 200)
				or (look == "sunset" and Color3.fromRGB(255, 160, 80) or Color3.fromRGB(210, 140, 255))
			local bot = look == "cyber" and Color3.fromRGB(0, 255, 220)
				or (look == "sunset" and Color3.fromRGB(255, 70, 120) or Color3.fromRGB(0, 210, 255))
			if inst:IsA("TextButton") then
				addLookGradient(
					inst,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, top),
						ColorSequenceKeypoint.new(0.5, inst.BackgroundColor3),
						ColorSequenceKeypoint.new(1, bot),
					}),
					128,
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.45),
						NumberSequenceKeypoint.new(1, 0.7),
					})
				)
			elseif inst == mainFrame or inst == sidebarFrame or inst.Name == "Sidebar" then
				addLookGradient(
					inst,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, top),
						ColorSequenceKeypoint.new(0.55, inst.BackgroundColor3),
						ColorSequenceKeypoint.new(1, bot),
					}),
					118
				)
			end
		elseif look == "matrix" then
			if inst:IsA("TextButton") or inst == mainFrame or inst == sidebarFrame or inst.Name == "Sidebar" then
				addLookGradient(
					inst,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 255, 90)),
						ColorSequenceKeypoint.new(1, inst.BackgroundColor3),
					}),
					180,
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.55),
						NumberSequenceKeypoint.new(1, 0.82),
					})
				)
			end
		end
	end
	for _, child in ipairs(inst:GetChildren()) do
		if child:IsA("UIStroke") and child.Name ~= "GAI_LookGlow" then
			if child:GetAttribute("GAI_BaseStroke") == nil then
				child:SetAttribute("GAI_BaseStroke", child.Thickness)
				child:SetAttribute("GAI_BaseStrokeTrans", child.Transparency)
			end
			child.Thickness = math.max(child:GetAttribute("GAI_BaseStroke") or 1, glass.strokeW)
			child.Transparency = glass.strokeT
		end
	end
end

local function applyLookStyle(name)
	if not screenGui then
		return
	end
	stopLookPulse()
	restoreLookBase(screenGui)
	stripLookDecor(screenGui)
	local look = themeLook(name)
	if not look then
		return
	end
	if mainFrame then
		local sky = Instance.new("Frame")
		sky.Name = "GAI_LookSky"
		sky.Size = UDim2.fromScale(1, 1)
		local skyColors = {
			aero = Color3.fromRGB(118, 198, 238),
			galaxy = Color3.fromRGB(8, 2, 28),
			cyber = Color3.fromRGB(12, 0, 20),
			sakura = Color3.fromRGB(255, 214, 228),
			matrix = Color3.fromRGB(0, 12, 2),
			sunset = Color3.fromRGB(48, 14, 40),
			frost = Color3.fromRGB(198, 228, 246),
		}
		sky.BackgroundColor3 = skyColors[look] or Color3.fromRGB(8, 2, 28)
		sky.BorderSizePixel = 0
		sky.ZIndex = 0
		sky.Active = false
		sky.Parent = mainFrame
		local skyCorner = Instance.new("UICorner")
		skyCorner.CornerRadius = UDim.new(0, 12)
		skyCorner.Parent = sky
		if look == "aero" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(92, 178, 236)),
					ColorSequenceKeypoint.new(0.42, Color3.fromRGB(186, 228, 250)),
					ColorSequenceKeypoint.new(0.68, Color3.fromRGB(156, 214, 164)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(86, 176, 96)),
				}),
				90
			)
			local bubbles = {
				{ 0.1, 0.14, 96 },
				{ 0.78, 0.08, 72 },
				{ 0.88, 0.48, 54 },
				{ 0.16, 0.7, 118 },
				{ 0.58, 0.78, 40 },
				{ 0.42, 0.06, 28 },
				{ 0.7, 0.28, 36 },
			}
			local aeroBubbles = {}
			for _, b in ipairs(bubbles) do
				local bubble = Instance.new("Frame")
				bubble.Name = "GAI_LookBubble"
				bubble.AnchorPoint = Vector2.new(0.5, 0.5)
				bubble.Position = UDim2.new(b[1], 0, b[2], 0)
				bubble.Size = UDim2.fromOffset(b[3], b[3])
				bubble.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				bubble.BackgroundTransparency = 0.78
				bubble.BorderSizePixel = 0
				bubble.ZIndex = 0
				bubble.Parent = sky
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = bubble
				addLookGradient(
					bubble,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 220, 255)),
					}),
					-40,
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.15),
						NumberSequenceKeypoint.new(1, 0.7),
					})
				)
				table.insert(aeroBubbles, bubble)
			end
			bindLookPulse(function(_, amp, t)
				for i, bubble in ipairs(aeroBubbles) do
					if bubble.Parent then
						local spec = bubbles[i]
						bubble.Position = UDim2.new(
							spec[1] + 0.012 * amp * math.sin(t * 0.7 + i),
							0,
							spec[2] + 0.018 * amp * math.sin(t * 0.9 + i * 0.6),
							0
						)
					end
				end
			end)
		elseif look == "galaxy" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 4, 72)),
					ColorSequenceKeypoint.new(0.35, Color3.fromRGB(64, 12, 120)),
					ColorSequenceKeypoint.new(0.7, Color3.fromRGB(8, 18, 64)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(2, 0, 12)),
				}),
				132
			)
			local nebulae = {
				{ 0.62, -0.08, 0.7, 0.62, Color3.fromRGB(150, 48, 255), 0.78, 40 },
				{ -0.12, 0.42, 0.58, 0.55, Color3.fromRGB(0, 160, 255), 0.84, -20 },
				{ 0.28, 0.58, 0.5, 0.42, Color3.fromRGB(255, 40, 140), 0.88, 80 },
			}
			for _, n in ipairs(nebulae) do
				local blob = Instance.new("Frame")
				blob.Name = "GAI_LookNebula"
				blob.Position = UDim2.new(n[1], 0, n[2], 0)
				blob.Size = UDim2.new(n[3], 0, n[4], 0)
				blob.BackgroundColor3 = n[5]
				blob.BackgroundTransparency = n[6]
				blob.BorderSizePixel = 0
				blob.ZIndex = 0
				blob.Parent = sky
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = blob
				addLookGradient(
					blob,
					ColorSequence.new({
						ColorSequenceKeypoint.new(0, n[5]),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 0, 24)),
					}),
					n[7],
					NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.2),
						NumberSequenceKeypoint.new(1, 1),
					})
				)
			end
			local stars = {
				{ 0.06, 0.1, 2, Color3.fromRGB(255, 255, 255) },
				{ 0.18, 0.2, 1, Color3.fromRGB(190, 230, 255) },
				{ 0.28, 0.08, 2, Color3.fromRGB(255, 210, 255) },
				{ 0.41, 0.16, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.55, 0.06, 2, Color3.fromRGB(0, 230, 255) },
				{ 0.68, 0.18, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.82, 0.1, 2, Color3.fromRGB(210, 160, 255) },
				{ 0.92, 0.22, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.12, 0.38, 1, Color3.fromRGB(0, 230, 255) },
				{ 0.33, 0.44, 2, Color3.fromRGB(255, 255, 255) },
				{ 0.48, 0.32, 1, Color3.fromRGB(255, 180, 255) },
				{ 0.61, 0.4, 2, Color3.fromRGB(190, 230, 255) },
				{ 0.77, 0.36, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.9, 0.48, 2, Color3.fromRGB(0, 230, 255) },
				{ 0.08, 0.62, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.22, 0.72, 2, Color3.fromRGB(210, 160, 255) },
				{ 0.39, 0.66, 1, Color3.fromRGB(255, 255, 255) },
				{ 0.52, 0.78, 2, Color3.fromRGB(0, 230, 255) },
				{ 0.7, 0.64, 1, Color3.fromRGB(255, 210, 255) },
				{ 0.84, 0.74, 2, Color3.fromRGB(255, 255, 255) },
				{ 0.15, 0.88, 1, Color3.fromRGB(190, 230, 255) },
				{ 0.46, 0.9, 2, Color3.fromRGB(255, 255, 255) },
				{ 0.73, 0.86, 1, Color3.fromRGB(0, 230, 255) },
				{ 0.95, 0.82, 2, Color3.fromRGB(210, 160, 255) },
			}
			local starDots = {}
			for _, s in ipairs(stars) do
				local star = Instance.new("Frame")
				star.Name = "GAI_LookStar"
				star.AnchorPoint = Vector2.new(0.5, 0.5)
				star.Position = UDim2.new(s[1], 0, s[2], 0)
				star.Size = UDim2.fromOffset(s[3], s[3])
				star.BackgroundColor3 = s[4]
				star.BackgroundTransparency = 0.2
				star.BorderSizePixel = 0
				star.ZIndex = 0
				star.Parent = sky
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = star
				table.insert(starDots, star)
			end
			local glow = Instance.new("UIStroke")
			glow.Name = "GAI_LookGlow"
			glow.Color = CONFIG.THEME.ACCENT
			glow.Thickness = 2.4
			glow.Transparency = 0.32
			glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			glow.Parent = mainFrame
			bindLookPulse(function(_, amp, t)
				if glow.Parent then
					glow.Transparency = 0.32 + amp * (0.1 * math.sin(t * 1.5))
					glow.Color = Color3.fromRGB(
						math.floor(40 + 80 * amp * (0.5 + 0.5 * math.sin(t * 0.7))),
						math.floor(140 + 90 * amp * (0.5 + 0.5 * math.sin(t * 0.9 + 1))),
						255
					)
				end
				for i, star in ipairs(starDots) do
					if star.Parent then
						star.BackgroundTransparency = 0.2 + amp * 0.55 * (0.5 + 0.5 * math.sin(t * 2.1 + i * 0.65))
					end
				end
			end)
		elseif look == "cyber" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 0, 48)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(18, 0, 28)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 20, 32)),
				}),
				118
			)
			local scan = Instance.new("Frame")
			scan.Name = "GAI_LookScanline"
			scan.Size = UDim2.new(1, 0, 0, 4)
			scan.BackgroundColor3 = Color3.fromRGB(0, 255, 220)
			scan.BackgroundTransparency = 0.55
			scan.BorderSizePixel = 0
			scan.ZIndex = 0
			scan.Parent = sky
			local glow = Instance.new("UIStroke")
			glow.Name = "GAI_LookGlow"
			glow.Color = Color3.fromRGB(255, 40, 180)
			glow.Thickness = 2.2
			glow.Transparency = 0.28
			glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			glow.Parent = mainFrame
			bindLookPulse(function(_, amp, t)
				local y = (t * 0.22 * math.max(0.15, amp)) % 1.12 - 0.06
				scan.Position = UDim2.new(0, 0, y, 0)
				scan.BackgroundTransparency = 0.45 + 0.25 * amp * math.abs(math.sin(t * 8))
				if glow.Parent then
					glow.Color = math.sin(t * 6) > 0 and Color3.fromRGB(255, 40, 180) or Color3.fromRGB(0, 255, 220)
					glow.Transparency = 0.28 + amp * 0.2 * (0.5 + 0.5 * math.sin(t * 9))
				end
				sky.BackgroundTransparency = (amp > 0.2 and math.sin(t * 17) > 0.92) and 0.12 or 0
			end)
		elseif look == "sakura" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 214, 230)),
					ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 236, 242)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 188, 210)),
				}),
				90
			)
			local petals = {}
			for i = 1, 12 do
				local petal = Instance.new("Frame")
				petal.Name = "GAI_LookPetal"
				petal.AnchorPoint = Vector2.new(0.5, 0.5)
				petal.Size = UDim2.fromOffset(9 + (i % 3) * 3, 7 + (i % 2) * 2)
				petal.Position = UDim2.new((i * 0.08) % 1, 0, (i * 0.13) % 1, 0)
				petal.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(255, 150, 186) or Color3.fromRGB(255, 196, 214)
				petal.BackgroundTransparency = 0.28
				petal.BorderSizePixel = 0
				petal.Rotation = i * 18
				petal.ZIndex = 0
				petal.Parent = sky
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = petal
				petals[i] = { inst = petal, x = (i * 0.08) % 1, y = (i * 0.13) % 1, spin = 12 + i }
			end
			bindLookPulse(function(dt, amp, t)
				dt = dt * amp
				for _, p in ipairs(petals) do
					if p.inst.Parent then
						p.y = p.y + dt * 0.08
						p.x = p.x + dt * 0.03 * math.sin(t + p.spin)
						if p.y > 1.08 then
							p.y = -0.06
							p.x = math.random()
						end
						p.inst.Position = UDim2.new(p.x, 0, p.y, 0)
						p.inst.Rotation = p.inst.Rotation + dt * p.spin
					end
				end
			end)
		elseif look == "matrix" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 24, 4)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 6, 0)),
				}),
				90
			)
			local rain = {}
			for i = 1, 16 do
				local streak = Instance.new("Frame")
				streak.Name = "GAI_LookRain"
				streak.Size = UDim2.new(0, 2, 0, 36 + (i % 6) * 16)
				streak.Position = UDim2.new(0.04 + (i - 1) * 0.06, 0, -0.2, 0)
				streak.BackgroundColor3 = Color3.fromRGB(48, 255, 96)
				streak.BackgroundTransparency = 0.35 + (i % 4) * 0.1
				streak.BorderSizePixel = 0
				streak.ZIndex = 0
				streak.Parent = sky
				rain[i] = { inst = streak, y = -0.2 - (i % 5) * 0.12, speed = 0.18 + (i % 4) * 0.07 }
			end
			bindLookPulse(function(dt, amp)
				dt = dt * amp
				for _, r in ipairs(rain) do
					if r.inst.Parent then
						r.y = r.y + dt * r.speed
						if r.y > 1.15 then
							r.y = -0.25
						end
						r.inst.Position = UDim2.new(r.inst.Position.X.Scale, 0, r.y, 0)
					end
				end
			end)
		elseif look == "sunset" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 30, 90)),
					ColorSequenceKeypoint.new(0.45, Color3.fromRGB(180, 70, 80)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 140, 70)),
				}),
				90
			)
			local sun = Instance.new("Frame")
			sun.Name = "GAI_LookSun"
			sun.AnchorPoint = Vector2.new(0.5, 0.5)
			sun.Position = UDim2.new(0.78, 0, 0.22, 0)
			sun.Size = UDim2.fromOffset(90, 90)
			sun.BackgroundColor3 = Color3.fromRGB(255, 170, 70)
			sun.BackgroundTransparency = 0.28
			sun.BorderSizePixel = 0
			sun.ZIndex = 0
			sun.Parent = sky
			local sunCorner = Instance.new("UICorner")
			sunCorner.CornerRadius = UDim.new(1, 0)
			sunCorner.Parent = sun
			bindLookPulse(function(_, amp, t)
				local pulse = 90 + 10 * amp * math.sin(t * 0.8)
				sun.Size = UDim2.fromOffset(pulse, pulse)
				sun.BackgroundTransparency = 0.28 + 0.12 * amp * (0.5 + 0.5 * math.sin(t * 0.9))
			end)
		elseif look == "frost" then
			addLookGradient(
				sky,
				ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(210, 236, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 210, 235)),
				}),
				90
			)
			local snow = {}
			for i = 1, 18 do
				local flake = Instance.new("Frame")
				flake.Name = "GAI_LookSnow"
				flake.AnchorPoint = Vector2.new(0.5, 0.5)
				flake.Size = UDim2.fromOffset(2 + (i % 3), 2 + (i % 3))
				flake.Position = UDim2.new((i * 0.055) % 1, 0, (i * 0.11) % 1, 0)
				flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				flake.BackgroundTransparency = 0.15
				flake.BorderSizePixel = 0
				flake.ZIndex = 0
				flake.Parent = sky
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = flake
				snow[i] = { inst = flake, x = (i * 0.055) % 1, y = (i * 0.11) % 1, speed = 0.05 + (i % 4) * 0.02 }
			end
			bindLookPulse(function(dt, amp, t)
				dt = dt * amp
				for i, s in ipairs(snow) do
					if s.inst.Parent then
						s.y = s.y + dt * s.speed
						s.x = s.x + dt * 0.03 * math.sin(t + i)
						if s.y > 1.06 then
							s.y = -0.04
						end
						s.inst.Position = UDim2.new(s.x, 0, s.y, 0)
						s.inst.BackgroundTransparency = 0.15 + 0.35 * amp * (0.5 + 0.5 * math.sin(t * 3 + i))
					end
				end
			end)
		end
	end
	decorateLookInstance(screenGui)
	for _, d in ipairs(screenGui:GetDescendants()) do
		if not LOOK_SKIP_CLASS[d.ClassName] then
			decorateLookInstance(d)
		end
	end
	local lookDecorQueue = {}
	local lookDecorQueued = false
	lookAddedConn = screenGui.DescendantAdded:Connect(function(d)
		if LOOK_SKIP_CLASS[d.ClassName] then
			return
		end
		if isLookDecor(d) or (d.Parent and isLookDecor(d.Parent)) then
			return
		end
		lookDecorQueue[#lookDecorQueue + 1] = d
		if lookDecorQueued then
			return
		end
		lookDecorQueued = true
		task.defer(function()
			lookDecorQueued = false
			local batch = lookDecorQueue
			lookDecorQueue = {}
			if not themeLook() then
				return
			end
			for i = 1, #batch do
				local inst = batch[i]
				if inst and inst.Parent then
					decorateLookInstance(inst)
				end
			end
		end)
	end)
end

local function applyTheme(name)
	local nextTheme = THEMES[name]
	if not nextTheme or not screenGui then
		return
	end
	stopLookPulse()
	restoreLookBase(screenGui)
	stripLookDecor(screenGui)
	local old = CONFIG.THEME
	local remap = {}
	for key, color in pairs(old) do
		remap[colorKey(color)] = nextTheme[key]
	end
	local function paint(inst)
		if inst:IsA("GuiObject") and inst.BackgroundTransparency < 1 then
			local mapped = remap[colorKey(inst.BackgroundColor3)]
			if mapped then
				inst.BackgroundColor3 = mapped
			end
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			local mapped = remap[colorKey(inst.TextColor3)]
			if mapped then
				inst.TextColor3 = mapped
			end
		end
		if inst:IsA("TextBox") then
			local mapped = remap[colorKey(inst.PlaceholderColor3)]
			if mapped then
				inst.PlaceholderColor3 = mapped
			end
		end
		if inst:IsA("ScrollingFrame") then
			local mapped = remap[colorKey(inst.ScrollBarImageColor3)]
			if mapped then
				inst.ScrollBarImageColor3 = mapped
			end
		end
		if inst:IsA("UIStroke") then
			local mapped = remap[colorKey(inst.Color)]
			if mapped then
				inst.Color = mapped
			end
		end
	end
	paint(screenGui)
	for _, d in ipairs(screenGui:GetDescendants()) do
		paint(d)
	end
	CONFIG.THEME = nextTheme
	CONFIG.THEME_NAME = name
	applyLookStyle(name)
	playThemeIntro()
	savePrefs()
	refreshThemeButtons()
	refreshHotkeyButtons()
	refreshSpyButtons()
	for _, item in ipairs(liveToggles) do
		if item.Paint then
			pcall(item.Paint)
		end
	end
	task.delay(0.42, function()
		if CONFIG.THEME_NAME == name then
			applyUiScale()
		end
	end)
end

local GUID_PATTERN = "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x"

local function looksLikeGuid(text)
	text = tostring(text)
	if string.match(text, "^" .. GUID_PATTERN .. "$") then
		return true
	end
	if #text == 32 and string.match(text, "^%x+$") then
		return true
	end
	return false
end

local function classifyId(key, text)
	key = string.lower(tostring(key or ""))
	text = tostring(text)
	if looksLikeGuid(text) then
		return "instance-uuid"
	end
	local keyLooksId = key == "id"
		or string.find(key, "id", 1, true)
		or string.find(key, "guid", 1, true)
		or string.find(key, "uuid", 1, true)
		or string.find(key, "serial", 1, true)
		or string.find(key, "catalog", 1, true)
		or string.find(key, "template", 1, true)
		or string.find(key, "unique", 1, true)
	if not keyLooksId and key ~= "" then
		return nil
	end
	if tonumber(text) then
		return "catalog/type-id"
	end
	if #text >= 3 then
		return "item-key"
	end
	return nil
end

local function snapshotValue(value, key, depth, seen)
	depth = depth or 0
	local t = typeof(value)
	if t == "Instance" then
		local ok, path = pcall(function()
			return value:GetFullName()
		end)
		return {
			kind = "Instance",
			text = ok and path or tostring(value),
			live = value,
			idTag = classifyId(key, value.Name),
		}
	end
	if t == "table" then
		if depth > 4 then
			return { kind = "table", text = "{...}", children = {} }
		end
		seen = seen or {}
		if seen[value] then
			return { kind = "table", text = "{cycle}", children = {} }
		end
		seen[value] = true
		local children = {}
		local count = 0
		for i, v in ipairs(value) do
			count = count + 1
			if count > 24 then
				break
			end
			table.insert(children, {
				key = tostring(i),
				value = snapshotValue(v, i, depth + 1, seen),
			})
		end
		for k, v in pairs(value) do
			if type(k) ~= "number" or k < 1 or k > #value or math.floor(k) ~= k then
				count = count + 1
				if count > 24 then
					break
				end
				table.insert(children, {
					key = tostring(k),
					value = snapshotValue(v, k, depth + 1, seen),
				})
			end
		end
		return { kind = "table", text = "{table}", children = children }
	end
	if t == "string" or t == "number" or t == "boolean" then
		local text = t == "string" and value or tostring(value)
		return {
			kind = t,
			text = text,
			raw = value,
			idTag = classifyId(key, text),
		}
	end
	return { kind = t, text = tostring(value), raw = tostring(value) }
end

local function collectIdTags(snap, prefix, out)
	out = out or {}
	prefix = prefix or "arg"
	if not snap then
		return out
	end
	if snap.idTag then
		table.insert(out, prefix .. "=" .. tostring(snap.text) .. " (" .. snap.idTag .. ")")
	end
	if snap.kind == "table" then
		for _, child in ipairs(snap.children or {}) do
			collectIdTags(child.value, prefix .. "." .. child.key, out)
		end
	end
	return out
end

local function valueFromSnap(snap)
	if not snap then
		return nil
	end
	if snap.kind == "table" then
		local t = {}
		for _, child in ipairs(snap.children or {}) do
			local key = tonumber(child.key)
			if key and tostring(key) == child.key then
				t[key] = valueFromSnap(child.value)
			else
				t[child.key] = valueFromSnap(child.value)
			end
		end
		return t
	end
	local text = snap.editText
	if text == nil then
		if snap.kind == "Instance" then
			if snap.live and snap.live.Parent then
				return snap.live
			end
			return resolvePath(snap.text)
		end
		return snap.raw
	end
	if snap.kind == "number" then
		return tonumber(text) or 0
	end
	if snap.kind == "boolean" then
		local lower = string.lower(text)
		return lower == "true" or lower == "1"
	end
	if snap.kind == "Instance" then
		return resolvePath(text) or snap.live
	end
	return text
end

local function summarizeArgs(snaps)
	local parts = {}
	for i, snap in ipairs(snaps) do
		if snap.kind == "table" then
			table.insert(parts, "arg" .. i .. "={table}")
		else
			table.insert(parts, truncateText(tostring(snap.text), 40))
		end
	end
	return table.concat(parts, ", ")
end

local function flattenSnap(snap, prefix, out)
	out = out or {}
	if not snap then
		return out
	end
	if snap.kind == "table" then
		for _, child in ipairs(snap.children or {}) do
			flattenSnap(child.value, prefix .. "." .. tostring(child.key), out)
		end
	else
		out[prefix] = tostring(snap.text or "")
	end
	return out
end

local function flattenCapture(cap)
	local out = {}
	for i, snap in ipairs(cap.ArgSnaps or {}) do
		flattenSnap(snap, "arg" .. i, out)
	end
	return out
end

local function previousCaptureSamePath(cap)
	local seen = false
	for _, other in ipairs(captureLog) do
		if other == cap then
			seen = true
		elseif seen and other.Path == cap.Path and other.Method == cap.Method then
			return other
		end
	end
	return nil
end

local function diffCaptureArgs(newer, older)
	local a = flattenCapture(newer)
	local b = flattenCapture(older)
	local keys = {}
	local seen = {}
	for k in pairs(a) do
		seen[k] = true
		table.insert(keys, k)
	end
	for k in pairs(b) do
		if not seen[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys)
	local lines = {}
	for _, k in ipairs(keys) do
		local av, bv = a[k], b[k]
		if av ~= bv then
			if av == nil then
				table.insert(lines, k .. ": (gone) was " .. tostring(bv))
			elseif bv == nil then
				table.insert(lines, k .. ": " .. tostring(av) .. " (new)")
			else
				table.insert(lines, k .. ": " .. tostring(bv) .. " → " .. tostring(av))
			end
		end
	end
	if #lines == 0 then
		return "No arg changes vs " .. (older.Time or "previous")
	end
	return table.concat(lines, "\n")
end

local function stopIncomingSpy()
	for _, conn in ipairs(incomingSpyConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	incomingSpyConns = {}
end

local NOISY_REMOTE_PATTERN = "ping|tick|heartbeat|camera|mouse|replicate|cframe|position|input"

local function isNoisyRemote(name)
	return string.find(string.lower(tostring(name)), NOISY_REMOTE_PATTERN) ~= nil
end

local function captureMatches(cap, q)
	if captureMethodFilter == "Out" then
		if cap.Method ~= "FireServer" and cap.Method ~= "InvokeServer" then
			return false
		end
	elseif captureMethodFilter == "In" then
		if cap.Method ~= "OnClientEvent" then
			return false
		end
	end
	if not q or q == "" then
		return true
	end
	local blob = string.lower(cap.Summary .. " " .. (cap.IdBlob or "") .. " " .. (cap.From or ""))
	return string.find(blob, q, 1, true) ~= nil
end

local function capturesVisible()
	return remotesView == "Captures"
		and remotesShell
		and remotesShell.Visible
		and remotesCaptures
		and remotesCaptures.Visible
end

local function hotRemoteLine()
	local list = {}
	for path, n in pairs(remoteHitCounts) do
		local name = string.match(path, "[^%.]+$") or path
		table.insert(list, { name = name, n = n })
	end
	table.sort(list, function(a, b)
		return a.n > b.n
	end)
	if #list == 0 then
		return nil
	end
	local parts = {}
	for i = 1, math.min(3, #list) do
		table.insert(parts, list[i].name .. " ×" .. list[i].n)
	end
	return "Hot: " .. table.concat(parts, " · ")
end

refreshRemotesIdleHint = function()
	if not remotesHint or indexInProgress then
		return
	end
	if remotesSearchBox and remotesSearchBox.Text ~= "" then
		return
	end
	if #lastSourceHits > 0 then
		return
	end
	local hot = hotRemoteLine()
	remotesHint.Text = (hot and (hot .. "  ") or "")
		.. "Hover any button for what it does and how loud it is."
end

local function collectRecentStatDelta(now)
	local bits = {}
	for _, d in ipairs(recentStatDeltas) do
		if now - d.Tick <= 0.7 then
			table.insert(bits, d.Name .. " " .. d.From .. "→" .. d.To)
		end
	end
	if #bits == 0 then
		return nil
	end
	return table.concat(bits, ", ")
end

local function noteValueDelta(name, path, from, to)
	table.insert(recentStatDeltas, 1, {
		Name = name,
		Path = path,
		From = from,
		To = to,
		Tick = tick(),
	})
	while #recentStatDeltas > 16 do
		table.remove(recentStatDeltas)
	end
	if valueFilterLabel then
		local countText = valueFilterLabel.Text
		local prefix = string.match(countText, "^Showing %d+ values %([^%)]+%)") or countText
		if prefix == "" or not string.find(prefix, "Showing", 1, true) then
			prefix = "Values"
		end
		valueFilterLabel.Text = prefix .. "  Last: " .. tostring(name) .. " " .. tostring(from) .. "→" .. tostring(to)
	end
end

local function watchLeaderstats()
	for _, conn in ipairs(statWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	statWatchConns = {}
	lastStats = {}
	local bound = 0
	local function bind(obj, label)
		if typeof(obj) ~= "Instance" or bound >= 80 then
			return
		end
		local okVal, isValue = pcall(function()
			return obj:IsA("ValueBase")
		end)
		if not okVal or not isValue then
			return
		end
		local okPath, path = pcall(function()
			return obj:GetFullName()
		end)
		path = (okPath and path) or (label or obj.Name)
		if lastStats[path] ~= nil then
			return
		end
		lastStats[path] = tostring(obj.Value)
		bound = bound + 1
		local conn = obj.Changed:Connect(function()
			local nowVal = tostring(obj.Value)
			local prev = lastStats[path] or "?"
			if nowVal == prev then
				return
			end
			lastStats[path] = nowVal
			noteValueDelta(obj.Name, path, prev, nowVal)
		end)
		table.insert(statWatchConns, conn)
	end
	local folder = player:FindFirstChild("leaderstats")
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			bind(child, "leaderstats")
		end
		table.insert(
			statWatchConns,
			folder.ChildAdded:Connect(function(child)
				bind(child, "leaderstats")
			end)
		)
	end
	for _, entry in ipairs(valueRegistry) do
		bind(entry.Instance, entry.Path)
		if bound >= 80 then
			break
		end
	end
	pcall(function()
		for name, value in pairs(player:GetAttributes()) do
			local key = "attr:" .. tostring(name)
			lastStats[key] = tostring(value)
			table.insert(
				statWatchConns,
				player:GetAttributeChangedSignal(name):Connect(function()
					local nowVal = tostring(player:GetAttribute(name))
					local prev = lastStats[key] or "?"
					if nowVal == prev then
						return
					end
					lastStats[key] = nowVal
					noteValueDelta(name, "attribute " .. name, prev, nowVal)
				end)
			)
		end
	end)
end

local function dropOldestCapture()
	local dropped = table.remove(captureLog)
	if dropped and dropped.Row then
		pcall(function()
			dropped.Row:Destroy()
		end)
		dropped.Row = nil
	end
end

local function recordCapture(remote, method, args, argCount, fromScript)
	local name = typeof(remote) == "Instance" and remote.Name or "?"
	if method == "OnClientEvent" and isNoisyRemote(name) then
		return
	end
	local now = tick()
	if now - captureBurstAt >= 1 then
		captureBurst = 0
		captureBurstAt = now
	end
	captureBurst = captureBurst + 1
	if captureBurst > CONFIG.MAX_CAPTURES_PER_SEC then
		return
	end
	local path
	if typeof(remote) == "Instance" then
		local okPath, full = pcall(function()
			return remote:GetFullName()
		end)
		path = (okPath and type(full) == "string" and full) or remote.Name
	else
		path = tostring(remote)
	end
	local snaps = {}
	for i = 1, argCount or #args do
		table.insert(snaps, snapshotValue(args[i], "arg" .. i, 0, {}))
	end
	local ids = {}
	for i, snap in ipairs(snaps) do
		collectIdTags(snap, "arg" .. i, ids)
	end
	local summary = method .. "  " .. path .. "  " .. summarizeArgs(snaps)
	local dedupeKey = method .. "\0" .. path .. "\0" .. summary
	if dedupeKey == lastCapKey and (now - lastCapAt) < 0.05 then
		return
	end
	lastCapKey = dedupeKey
	lastCapAt = now
	local cap = {
		Method = method,
		Path = path,
		Name = typeof(remote) == "Instance" and remote.Name or "?",
		Remote = typeof(remote) == "Instance" and remote or nil,
		ArgSnaps = snaps,
		ArgCount = argCount or #args,
		Ids = ids,
		IdBlob = table.concat(ids, " | "),
		Summary = summary,
		From = fromScript,
		Time = os.date("%H:%M:%S"),
		Tick = now,
	}
	table.insert(captureLog, 1, cap)
	if method == "OnClientEvent" then
		for i = 2, math.min(#captureLog, 8) do
			local other = captureLog[i]
			if
				(other.Method == "FireServer" or other.Method == "InvokeServer")
				and other.Tick
				and (now - other.Tick) <= 0.55
			then
				cap.Pair = other.Name .. " → this (" .. string.format("%.2fs", now - other.Tick) .. ")"
				other.Reply = cap.Name
				break
			end
		end
	end
	cap.StatDelta = collectRecentStatDelta(now)
	remoteHitCounts[path] = (remoteHitCounts[path] or 0) + 1
	while #captureLog > CONFIG.MAX_CAPTURES do
		dropOldestCapture()
	end
	table.insert(lastOutgoingLogs, 1, summary)
	if #lastOutgoingLogs > 8 then
		table.remove(lastOutgoingLogs)
	end
	if typeof(remote) == "Instance" then
		local mapped = remoteByPath[path]
		if mapped then
			mapped.LastOut = summary
			mapped.Hits = remoteHitCounts[path]
		end
		if starredPaths[path] or (mapped and mapped.Watching) then
			showToast(
				(method == "OnClientEvent" and "Incoming " or "Outgoing ") .. name,
				truncateText(summary, 80),
				"remote"
			)
		end
	end
	task.defer(function()
		pcall(function()
			if pushCaptureRow then
				pushCaptureRow(cap)
			end
			scheduleMemorySave()
			if refreshRemotesIdleHint then
				refreshRemotesIdleHint()
			end
			if refreshDashboard and activeMainTab == "Dashboard" and not dashRefreshQueued then
				dashRefreshQueued = true
				task.delay(0.18, function()
					dashRefreshQueued = false
					if refreshDashboard and activeMainTab == "Dashboard" then
						refreshDashboard()
					end
				end)
			end
		end)
	end)
end

local function recordOutgoing(remote, method, args)
	local n = 0
	if type(args.n) == "number" then
		n = args.n
	else
		n = #args
	end
	local fromName = nil
	local getcallingscript = safeGlobal("getcallingscript")
	if type(getcallingscript) == "function" then
		local ok, src = pcall(getcallingscript)
		if ok and typeof(src) == "Instance" then
			fromName = src.Name .. "  " .. src:GetFullName()
		end
	end
	recordCapture(remote, method, args, n, fromName)
end

local function replayCapture(cap)
	if cap.Method ~= "FireServer" and cap.Method ~= "InvokeServer" then
		addMessage("OnClientEvent is inbound. You can search it, not replay it.", false)
		return
	end
	local remote = cap.Remote
	if typeof(remote) ~= "Instance" or not remote.Parent then
		remote = resolvePath(cap.Path)
	end
	if not remote then
		addMessage("Remote is gone: " .. cap.Path, false)
		return
	end
	local args = {}
	for i = 1, cap.ArgCount or #cap.ArgSnaps do
		args[i] = valueFromSnap(cap.ArgSnaps[i])
	end
	if cap.Method == "FireServer" then
		if not remote:IsA("RemoteEvent") and not remote:IsA("UnreliableRemoteEvent") then
			addMessage("Not a RemoteEvent.", false)
			return
		end
		local ok, err = pcall(function()
			remote:FireServer(unpack(args, 1, cap.ArgCount or #args))
		end)
		if ok then
			addMessage("Replayed FireServer " .. remote.Name, false)
		else
			addMessage("FireServer failed: " .. tostring(err), false)
		end
		return
	end
	if not remote:IsA("RemoteFunction") then
		addMessage("Not a RemoteFunction.", false)
		return
	end
	local ok, result = pcall(function()
		return remote:InvokeServer(unpack(args, 1, cap.ArgCount or #args))
	end)
	if ok then
		addMessage("InvokeServer returned: " .. truncateText(tostring(result), 240), false)
	else
		addMessage("InvokeServer error: " .. tostring(result), false)
	end
end

local function collectHeldItems()
	local items = {}
	local function consider(container, scope)
		if not container then
			return
		end
		local okKids, kids = pcall(function()
			return container:GetChildren()
		end)
		if not okKids then
			return
		end
		for _, child in ipairs(kids) do
			if child:IsA("Tool") or child:IsA("Folder") or child:IsA("Model") then
				local attrs = safeGetAttributes(child)
				local values = {}
				local okDesc, descendants = pcall(function()
					return child:GetDescendants()
				end)
				if okDesc then
					for _, sub in ipairs(descendants) do
						if sub:IsA("ValueBase") and #values < 8 then
							table.insert(values, sub.Name .. "=" .. tostring(sub.Value))
						end
					end
				end
				local idBits = {}
				for name, value in pairs(attrs) do
					local tag = classifyId(name, value)
					if tag then
						table.insert(idBits, name .. "=" .. value .. " (" .. tag .. ")")
					end
				end
				if child:IsA("Tool") or #idBits > 0 or #values > 0 then
					table.insert(items, {
						Name = child.Name,
						Path = child:GetFullName(),
						Scope = scope,
						Attrs = attrs,
						Values = values,
						Ids = idBits,
					})
				end
				if #items >= 20 then
					return
				end
			end
		end
	end
	consider(player:FindFirstChild("Backpack"), "Backpack")
	consider(player.Character, "Character")
	local extra = player:FindFirstChild("leaderstats")
		or player:FindFirstChild("Inventory")
		or player:FindFirstChild("Items")
	if extra then
		consider(extra, extra.Name)
	end
	return items
end

local function extractSnippet(source, needle)
	if type(source) ~= "string" or source == "" or type(needle) ~= "string" or needle == "" then
		return nil
	end
	local lower = string.lower(source)
	local start = string.find(lower, string.lower(needle), 1, true)
	if not start then
		return nil
	end
	local from = math.max(1, start - 80)
	local to = math.min(#source, start + #needle + 280)
	local snippet = string.sub(source, from, to)
	snippet = string.gsub(snippet, "[\r\n]+", " ")
	return truncateText(snippet, CONFIG.MAX_SNIPPET_CHARS)
end

local SOURCE_NAME_HINTS = mergeArrays(ITEM_KEYWORDS, MOVEMENT_KEYWORDS, ANTI_KEYWORDS, ECONOMY_KEYWORDS, {
	"remote", "net", "knit", "network", "data", "replica", "profile",
})

local ECONOMY_SOURCE_NEEDLES = {
	"cash", "coin", "coins", "money", "currency", "shop", "store", "buy",
	"purchase", "award", "grant", "give", "leaderstats", "gem", "token",
	"wallet", "balance", "paycheck", "payout",
}

local function startIncomingSpy()
	stopIncomingSpy()
	local hooked = 0
	for _, entry in ipairs(remoteRegistry) do
		local inst = entry.Instance
		if inst and inst.Parent and (inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent")) and not isNoisyRemote(inst.Name) then
			local ok, conn = pcall(function()
				return inst.OnClientEvent:Connect(function(...)
					local n = select("#", ...)
					local args = {}
					for a = 1, n do
						args[a] = select(a, ...)
					end
					recordCapture(inst, "OnClientEvent", args, n, "server → you")
				end)
			end)
			if ok and conn then
				table.insert(incomingSpyConns, conn)
				hooked = hooked + 1
				if hooked >= 80 then
					break
				end
			end
		end
	end
end

local function wrapExecutorClosure(fn)
	local newcclosure = safeGlobal("newcclosure")
	if type(newcclosure) == "function" then
		local ok, wrapped = pcall(newcclosure, fn)
		if ok and type(wrapped) == "function" then
			return wrapped
		end
	end
	return fn
end

local function getHookFunction()
	local fn = safeGlobal("hookfunction")
		or safeGlobal("hookfunc")
		or safeGlobal("replaceclosure")
		or safeGlobal("detour")
	if type(fn) == "function" then
		return fn
	end
	return nil
end

local function callerIsUs()
	local checkcaller = safeGlobal("checkcaller")
	if type(checkcaller) ~= "function" then
		return false
	end
	local ok, flag = pcall(checkcaller)
	return ok and flag and true or false
end

local function logOutgoingCall(self, pretty, ...)
	if not spyEnabled or typeof(self) ~= "Instance" then
		return
	end
	if callerIsUs() then
		return
	end
	local className = self.ClassName
	if pretty == "FireServer" then
		if className ~= "RemoteEvent" and className ~= "UnreliableRemoteEvent" then
			return
		end
	elseif pretty == "InvokeServer" then
		if className ~= "RemoteFunction" then
			return
		end
	end
	local n = select("#", ...)
	local packed = { n = n }
	for i = 1, n do
		packed[i] = select(i, ...)
	end
	local remote = self
	task.defer(function()
		pcall(recordOutgoing, remote, pretty, packed)
	end)
end

local function hookSharedMethod(className, methodName)
	local hookfunction = getHookFunction()
	if type(hookfunction) ~= "function" then
		return nil, nil
	end
	local okDummy, dummy = pcall(Instance.new, className)
	if not okDummy or typeof(dummy) ~= "Instance" then
		return nil, nil
	end
	local okMethod, method = pcall(function()
		return dummy[methodName]
	end)
	pcall(function()
		dummy:Destroy()
	end)
	if not okMethod or type(method) ~= "function" then
		return nil, nil
	end
	return method, hookfunction
end

local function installNamecallHook()
	local getncm = safeGlobal("getnamecallmethod") or safeGlobal("get_namecall_method")
	local handler = function(self, ...)
		if type(getncm) == "function" then
			local okMethod, method = pcall(getncm)
			if okMethod then
				local lower = string.lower(tostring(method or ""))
				if lower == "fireserver" then
					logOutgoingCall(self, "FireServer", ...)
				elseif lower == "invokeserver" then
					logOutgoingCall(self, "InvokeServer", ...)
				end
			end
		end
		if type(originalNamecall) == "function" then
			return originalNamecall(self, ...)
		end
	end
	local wrapped = wrapExecutorClosure(handler)
	local hook = safeGlobal("hookmetamethod")
	if type(hook) == "function" then
		local ok, old = pcall(hook, game, "__namecall", wrapped)
		if ok and type(old) == "function" then
			originalNamecall = old
			return true
		end
	end
	local getraw = safeGlobal("getrawmetatable")
	if type(getraw) ~= "function" then
		return false
	end
	local okMt, mt = pcall(getraw, game)
	if not okMt or type(mt) ~= "table" then
		return false
	end
	local okOld, old = pcall(function()
		return rawget(mt, "__namecall") or mt.__namecall
	end)
	if not okOld or type(old) ~= "function" then
		return false
	end
	originalNamecall = old
	local setro = safeGlobal("setreadonly")
	local makeWriteable = safeGlobal("make_writeable")
	local makeReadonly = safeGlobal("make_readonly")
	if type(setro) == "function" then
		pcall(setro, mt, false)
	elseif type(makeWriteable) == "function" then
		pcall(makeWriteable, mt)
	end
	local okSet = pcall(function()
		mt.__namecall = wrapped
	end)
	if type(setro) == "function" then
		pcall(setro, mt, true)
	elseif type(makeReadonly) == "function" then
		pcall(makeReadonly, mt)
	end
	return okSet
end

local function installOutgoingSpy()
	if spyInstalled then
		return true, nil
	end
	local hooked = {}

	local fireMethod, hookfunction = hookSharedMethod("RemoteEvent", "FireServer")
	if fireMethod and hookfunction then
		local box = { old = nil }
		local ok, hookedFn = pcall(function()
			box.old = hookfunction(
				fireMethod,
				wrapExecutorClosure(function(self, ...)
					logOutgoingCall(self, "FireServer", ...)
					return box.old(self, ...)
				end)
			)
			return box.old
		end)
		if ok and type(hookedFn) == "function" then
			originalFireServer = hookedFn
			table.insert(hooked, "FireServer")
		end
	end

	local invokeMethod, hookInvoke = hookSharedMethod("RemoteFunction", "InvokeServer")
	if invokeMethod and hookInvoke then
		local box = { old = nil }
		local ok, hookedFn = pcall(function()
			box.old = hookInvoke(
				invokeMethod,
				wrapExecutorClosure(function(self, ...)
					logOutgoingCall(self, "InvokeServer", ...)
					return box.old(self, ...)
				end)
			)
			return box.old
		end)
		if ok and type(hookedFn) == "function" then
			originalInvokeServer = hookedFn
			table.insert(hooked, "InvokeServer")
		end
	end

	local unreliableMethod, hookUnreliable = hookSharedMethod("UnreliableRemoteEvent", "FireServer")
	if unreliableMethod and hookUnreliable then
		local box = { old = nil }
		local ok, hookedFn = pcall(function()
			box.old = hookUnreliable(
				unreliableMethod,
				wrapExecutorClosure(function(self, ...)
					logOutgoingCall(self, "FireServer", ...)
					return box.old(self, ...)
				end)
			)
			return box.old
		end)
		if ok and type(hookedFn) == "function" then
			originalUnreliableFire = hookedFn
			table.insert(hooked, "UnreliableFire")
		end
	end

	if installNamecallHook() then
		table.insert(hooked, "namecall")
	end

	if #hooked == 0 then
		return false, "This executor cannot hook FireServer (needs hookfunction or hookmetamethod). Spy cannot capture outgoing remotes."
	end
	spyInstalled = true
	spyHookNotes = table.concat(hooked, " + ")
	return true, nil
end

refreshSpyButtons = function()
	local text = "Spy"
	local color = CONFIG.THEME.PRIMARY
	if spyEnabled then
		if spyInstalled then
			text = "Spy ON"
		else
			text = "Listen ON"
		end
		color = CONFIG.THEME.WARNING
	end
	if spyToolsButton then
		spyToolsButton.Text = text
		spyToolsButton.BackgroundColor3 = color
	end
	if remotesSpyButton then
		remotesSpyButton.Text = text
		remotesSpyButton.BackgroundColor3 = color
	end
end

local function setSpyEnabled(on, note)
	spyAutoGen = spyAutoGen + 1
	local gen = spyAutoGen
	if on then
		local ok = installOutgoingSpy()
		spyEnabled = true
		startIncomingSpy()
		if not ok then
			spyHookNotes = "incoming listen only"
			if addMessage and not note then
				addMessage(
					"This executor cannot hook FireServer. Listening to incoming remotes instead (OnClientEvent). Outgoing FireServer will not show.",
					false
				)
			end
		end
		if CONFIG.SPY_AUTO_OFF then
			local sec = tonumber(CONFIG.SPY_AUTO_OFF_SEC) or 20
			task.delay(sec, function()
				if gen == spyAutoGen and spyEnabled then
					setSpyEnabled(false, "Spy auto-paused after " .. tostring(sec) .. "s (Settings).")
					showToast("Spy paused", "Auto-paused after " .. tostring(sec) .. "s. Turn it back on if you still need it.", "info")
				end
			end)
		end
	else
		spyEnabled = false
		stopIncomingSpy()
	end
	refreshSpyButtons()
	if note and addMessage then
		if on and spyHookNotes ~= "" then
			addMessage(note .. " [" .. spyHookNotes .. "]", false)
		else
			addMessage(note, false)
		end
	end
	return true
end

local function collectLoadedModules()
	loadedModuleNames = {}
	local fn = safeGlobal("getloadedmodules")
	if type(fn) ~= "function" then
		return
	end
	local ok, mods = pcall(fn)
	if not ok or type(mods) ~= "table" then
		return
	end
	forEachInstance(mods, function(mod)
		if #loadedModuleNames >= 20 then
			return
		end
		table.insert(loadedModuleNames, mod.Name .. "  " .. mod:GetFullName())
	end)
end

local DUMP_SKIP = {
	["and"] = true,
	["or"] = true,
	["not"] = true,
	["local"] = true,
	["function"] = true,
	["end"] = true,
	["then"] = true,
	["else"] = true,
	["elseif"] = true,
	["for"] = true,
	["while"] = true,
	["do"] = true,
	["repeat"] = true,
	["until"] = true,
	["return"] = true,
	["in"] = true,
	["nil"] = true,
	["true"] = true,
	["false"] = true,
	self = true,
	game = true,
	script = true,
	workspace = true,
	print = true,
	wait = true,
	pairs = true,
	ipairs = true,
	tostring = true,
	tonumber = true,
	type = true,
	pcall = true,
	require = true,
}

local function dumpApi(name, ...)
	local fn = safeGlobal(name)
	if type(fn) == "function" then
		local ok, result = pcall(fn, ...)
		if ok then
			return result
		end
	end
	local dbg = safeGlobal("debug")
	if type(dbg) == "table" and type(dbg[name]) == "function" then
		local ok, result = pcall(dbg[name], ...)
		if ok then
			return result
		end
	end
	return nil
end

local function pushDumpString(into, seen, value)
	if typeof(value) == "Instance" then
		pushDumpString(into, seen, value.ClassName .. ":" .. value.Name)
		pcall(function()
			pushDumpString(into, seen, value:GetFullName())
		end)
		return
	end
	if type(value) == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return
		end
		if value % 1 ~= 0 or math.abs(value) < 10 then
			return
		end
		value = tostring(math.floor(value))
	elseif type(value) ~= "string" then
		return
	end
	value = string.gsub(value, "%c+", " ")
	value = string.gsub(value, "^%s+", "")
	value = string.gsub(value, "%s+$", "")
	if #value < 3 or #value > 180 then
		return
	end
	local key = string.lower(value)
	if DUMP_SKIP[key] or seen[key] then
		return
	end
	seen[key] = true
	table.insert(into, value)
end

local function collectFromFunction(fn, into, seen, depth)
	if type(fn) ~= "function" or depth > 2 or #into >= 120 then
		return
	end
	local consts = dumpApi("getconstants", fn)
	if type(consts) == "table" then
		for _, value in pairs(consts) do
			pushDumpString(into, seen, value)
		end
	else
		for i = 1, 64 do
			local value = dumpApi("getconstant", fn, i)
			if value == nil then
				break
			end
			pushDumpString(into, seen, value)
		end
	end
	local ups = dumpApi("getupvalues", fn)
	if type(ups) == "table" then
		for _, value in pairs(ups) do
			pushDumpString(into, seen, value)
			if type(value) == "function" and depth < 2 then
				collectFromFunction(value, into, seen, depth + 1)
			end
		end
	else
		for i = 1, 24 do
			local value = dumpApi("getupvalue", fn, i)
			if value == nil then
				break
			end
			pushDumpString(into, seen, value)
		end
	end
	if depth < 2 then
		local protos = dumpApi("getprotos", fn)
		if type(protos) == "table" then
			local n = 0
			for _, proto in pairs(protos) do
				n = n + 1
				if n > 8 then
					break
				end
				collectFromFunction(proto, into, seen, depth + 1)
			end
		end
	end
end

local function dumpScriptBlob(scriptInstance, maxChars, opts)
	if typeof(scriptInstance) ~= "Instance" then
		return nil
	end
	opts = opts or {}
	maxChars = maxChars or CONFIG.MAX_DECOMPILE_CHARS
	local cacheKey = scriptInstance:GetFullName()
	local cached = dumpCache[cacheKey]
	if type(cached) == "string" then
		return truncateText(cached, maxChars)
	end
	if cached == false and not opts.gc then
		return nil
	end

	local into = {}
	local seen = {}
	pushDumpString(into, seen, scriptInstance.Name)

	local closure = dumpApi("getscriptclosure", scriptInstance)
		or dumpApi("getscriptfunction", scriptInstance)
		or dumpApi("get_script_function", scriptInstance)
	if type(closure) == "function" then
		collectFromFunction(closure, into, seen, 0)
	end

	local env = dumpApi("getsenv", scriptInstance) or dumpApi("getmenv", scriptInstance)
	if type(env) == "table" then
		local n = 0
		for key, value in pairs(env) do
			n = n + 1
			if n > 80 then
				break
			end
			if type(key) == "string" then
				pushDumpString(into, seen, key)
			end
			pushDumpString(into, seen, value)
			if type(value) == "function" then
				collectFromFunction(value, into, seen, 0)
			end
		end
	end

	if #into < 6 and opts.gc then
		local getgc = safeGlobal("getgc") or safeGlobal("get_gc_objects")
		if type(getgc) == "function" then
			local ok, objs = pcall(getgc, true)
			if not ok or type(objs) ~= "table" then
				ok, objs = pcall(getgc)
			end
			if ok and type(objs) == "table" then
				local scanned = 0
				local t0 = tick()
				for _, obj in ipairs(objs) do
					if tick() - t0 > 0.18 or scanned > 2200 or #into >= 80 then
						break
					end
					if type(obj) == "function" then
						scanned = scanned + 1
						local match = false
						pcall(function()
							local fenv = getfenv(obj)
							match = fenv and fenv.script == scriptInstance
						end)
						if match then
							collectFromFunction(obj, into, seen, 0)
						end
					end
				end
			end
		end
	end

	if #into == 0 then
		dumpCache[cacheKey] = false
		return nil
	end
	local blob = table.concat(into, "\n")
	dumpCache[cacheKey] = blob
	return truncateText(blob, maxChars)
end

local function tryDecompile(scriptInstance, maxChars)
	if not scriptInstance then
		return nil, "Not a script"
	end
	local isScript = scriptInstance:IsA("LocalScript") or scriptInstance:IsA("ModuleScript") or scriptInstance:IsA("Script")
	if not isScript then
		return nil, "Not a script"
	end
	maxChars = maxChars or CONFIG.MAX_DECOMPILE_CHARS
	local cacheKey = scriptInstance:GetFullName()
	local cached = decompileCache[cacheKey]
	if type(cached) == "string" then
		return truncateText(cached, maxChars), nil
	end
	if cached == false then
		return nil, "Decompile not available (executor may not support it)"
	end

	local attempts = {}
	local decompileFn = safeGlobal("decompile")
	if type(decompileFn) == "function" then
		table.insert(attempts, decompileFn)
	end

	local getgenvFn = safeGlobal("getgenv")
	if type(getgenvFn) == "function" then
		local ok, env = pcall(getgenvFn)
		if ok and type(env) == "table" and type(env.decompile) == "function" then
			table.insert(attempts, env.decompile)
		end
	end

	local syn = safeGlobal("syn")
	if type(syn) == "table" and type(syn.decompile) == "function" then
		table.insert(attempts, syn.decompile)
	end

	for _, attempt in ipairs(attempts) do
		local ok, source = pcall(attempt, scriptInstance)
		if ok and type(source) == "string" and source ~= "" then
			decompileCache[cacheKey] = source
			return truncateText(source, maxChars), nil
		end
	end

	decompileCache[cacheKey] = false
	return nil, "Decompile not available (executor may not support it)"
end

inspectScript = function(scriptInstance, maxChars, opts)
	local source = tryDecompile(scriptInstance, maxChars)
	if type(source) == "string" and #source > 20 then
		return source, "decompile"
	end
	local dump = dumpScriptBlob(scriptInstance, maxChars, opts)
	if type(dump) == "string" and #dump > 12 then
		return dump, "dump"
	end
	return nil, "No decompile and no constants/env strings"
end

indexSources = function(query, opts)
	if indexInProgress then
		return
	end
	opts = opts or {}
	local hunt = opts.focus == "economy"
	local maxDocs = tonumber(opts.maxDocs) or (hunt and CONFIG.MAX_SOURCE_DOCS_HUNT or CONFIG.MAX_SOURCE_DOCS)
	local poolCap = tonumber(opts.maxCandidates) or CONFIG.MAX_SOURCE_POOL or 800
	local silent = opts.silent == true
	local extraHints = type(opts.extraHints) == "table" and opts.extraHints or nil
	local hintBag = SOURCE_NAME_HINTS
	if extraHints and #extraHints > 0 then
		hintBag = mergeArrays(SOURCE_NAME_HINTS, extraHints)
	end
	indexInProgress = true
	if indexStatusLabel then
		indexStatusLabel.Text = hunt and "Reading client scripts for money/shop..." or "Dumping script strings..."
	end
	task.spawn(function()
		local decompiled, dumped = 0, 0
		local okDump, dumpErr = pcall(function()
			sourceIndex = {}
			local seen = {}
			local candidates = {}
			local function skipDumpInstance(inst)
				return inst.Name == "GameAnalysisAI"
			end
			local function addCandidate(inst, why)
				if typeof(inst) ~= "Instance" then
					return
				end
				if skipDumpInstance(inst) then
					return
				end
				local className = inst.ClassName
				if className ~= "LocalScript" and className ~= "ModuleScript" then
					return
				end
				local okPath, path = pcall(function()
					return inst:GetFullName()
				end)
				if not okPath or type(path) ~= "string" then
					return
				end
				if string.find(path, "GameAnalysisAI", 1, true) then
					return
				end
				if seen[path] then
					return
				end
				seen[path] = true
				table.insert(candidates, { Instance = inst, Path = path, Name = inst.Name, Why = why })
			end

			local loaded = safeGlobal("getloadedmodules")
			if type(loaded) == "function" then
				local ok, mods = pcall(loaded)
				if ok then
					forEachInstance(mods, function(mod)
						addCandidate(mod, "loaded")
					end)
				end
			end
			for _, key in ipairs({ "getscripts", "getnilinstances" }) do
				local fn = safeGlobal(key)
				if type(fn) == "function" then
					local ok, list = pcall(fn)
					if ok then
						forEachInstance(list, function(inst)
							addCandidate(inst, key)
						end)
					end
				end
			end
			for _, entry in ipairs(antiScriptRegistry) do
				addCandidate(entry.Instance, "anti")
			end
			for _, entry in ipairs(remoteRegistry) do
				local inst = entry.Instance
				if inst and inst.Parent then
					local okKids, kids = pcall(function()
						return inst.Parent:GetChildren()
					end)
					if okKids then
						forEachInstance(kids, function(sibling)
							addCandidate(sibling, "near remote")
						end)
					end
				end
			end
			local roots = { player, ReplicatedStorage }
			if player.Character then
				table.insert(roots, player.Character)
			end
			for _, name in ipairs({ "StarterGui", "StarterPlayer", "ReplicatedFirst", "StarterPack" }) do
				local ok, svc = pcall(function()
					return game:GetService(name)
				end)
				if ok then
					table.insert(roots, svc)
				end
			end
			for _, root in ipairs(roots) do
				if root then
					local ok, desc = pcall(function()
						return root:GetDescendants()
					end)
					if ok then
						local t0 = os.clock()
						local len = type(desc) == "table" and #desc or 0
						local function considerScript(inst)
							if typeof(inst) ~= "Instance" then
								return
							end
							if os.clock() - t0 > 0.012 then
								task.wait()
								t0 = os.clock()
							end
							local className = inst.ClassName
							if className ~= "LocalScript" and className ~= "ModuleScript" then
								return
							end
							local blob = inst.Name
							pcall(function()
								blob = inst.Name .. " " .. inst:GetFullName()
							end)
							if stringContainsKeyword(blob, hintBag) then
								addCandidate(inst, "name")
							end
						end
						if len > 0 then
							for i = 1, len do
								considerScript(desc[i])
							end
						else
							forEachInstance(desc, considerScript)
						end
					end
				end
			end

			local function candidateScore(cand)
				local blob = string.lower(tostring(cand.Name) .. " " .. tostring(cand.Path))
				if extraHints and #extraHints > 0 and stringContainsKeyword(blob, extraHints) then
					return 4
				end
				if stringContainsKeyword(blob, ECONOMY_KEYWORDS) then
					return 3
				end
				if cand.Why == "name" or cand.Why == "near remote" then
					return 2
				end
				if cand.Why == "anti" then
					return 1
				end
				return 0
			end
			for _, cand in ipairs(candidates) do
				cand.Score = candidateScore(cand)
			end
			table.sort(candidates, function(a, b)
				return a.Score > b.Score
			end)
			if #candidates > poolCap then
				for i = #candidates, poolCap + 1, -1 do
					candidates[i] = nil
				end
			end

			local inspectAt = os.clock()
			for i, cand in ipairs(candidates) do
				if #sourceIndex >= maxDocs then
					break
				end
				if indexStatusLabel then
					indexStatusLabel.Text = "Dumping " .. i .. "/" .. math.min(#candidates, maxDocs)
				end
				local source, kind
				local okIns, a, b = pcall(inspectScript, cand.Instance, CONFIG.MAX_SOURCE_CHARS)
				if okIns then
					source, kind = a, b
				end
				if type(source) == "string" and #source > 12 then
					if kind == "decompile" then
						decompiled = decompiled + 1
					else
						dumped = dumped + 1
					end
					table.insert(sourceIndex, {
						Name = cand.Name,
						Path = cand.Path,
						Why = cand.Why .. (kind == "dump" and " dump" or ""),
						Source = source,
						Kind = kind,
						Lower = string.lower(cand.Name .. " " .. cand.Path .. " " .. source),
					})
				end
				if os.clock() - inspectAt > 0.012 then
					task.wait()
					inspectAt = os.clock()
				end
			end
		end)
		indexInProgress = false
		local status
		if not okDump then
			status = "Dump failed: " .. tostring(dumpErr)
		elseif #sourceIndex == 0 then
			status = "Dump found no searchable strings (needs getconstants, getsenv, or decompile)."
		else
			status = "Dumped "
				.. #sourceIndex
				.. " scripts ("
				.. decompiled
				.. " decompiled, "
				.. dumped
				.. " constants/env)."
		end
		if indexStatusLabel then
			indexStatusLabel.Text = status .. " Search in Remotes."
		end
		if not silent and addMessage then
			addMessage(status .. (okDump and " Search an item id or remote name in Remotes." or ""), false)
		end
		if okDump and not silent and query and query ~= "" and runSourceSearch then
			runSourceSearch(query)
		end
	end)
end

runSourceSearch = function(query)
	query = string.gsub(tostring(query or ""), "^%s*(.-)%s*$", "%1")
	lastSourceHits = {}
	if query == "" then
		if rebuildCaptureList then
			rebuildCaptureList()
		end
		return
	end
	if #sourceIndex == 0 then
		if indexInProgress then
			if remotesHint then
				remotesHint.Text = "Dump still running — search when it finishes."
			end
			return
		end
		indexSources(query)
		return
	end
	local needle = string.lower(query)
	for _, doc in ipairs(sourceIndex) do
		if string.find(doc.Lower, needle, 1, true) then
			local snippet
			if type(doc.Source) == "string" and doc.Source ~= "" then
				snippet = extractSnippet(doc.Source, query) or truncateText(doc.Source, CONFIG.MAX_SNIPPET_CHARS)
			else
				snippet = "(empty dump) " .. doc.Path
			end
			table.insert(lastSourceHits, {
				Name = doc.Name,
				Path = doc.Path,
				Why = doc.Why,
				Snippet = snippet,
			})
			if #lastSourceHits >= 10 then
				break
			end
		end
	end
	if remotesHint then
		if #lastSourceHits == 0 then
			remotesHint.Text = "No dump hits for \"" .. query .. "\". Turn Spy on and use the item, or Dump scripts first."
		else
			remotesHint.Text = #lastSourceHits .. " source hits for \"" .. query .. "\""
		end
	end
	if rebuildCaptureList then
		rebuildCaptureList()
	end
end

fillSourceHitsFromNeedles = function(needles, cap)
	lastSourceHits = {}
	needles = needles or ECONOMY_SOURCE_NEEDLES
	cap = cap or 10
	for _, doc in ipairs(sourceIndex) do
		local low = doc.Lower or ""
		local matched
		for _, needle in ipairs(needles) do
			if needle ~= "" and string.find(low, needle, 1, true) then
				matched = needle
				break
			end
		end
		if matched then
			local snippet
			if type(doc.Source) == "string" and doc.Source ~= "" then
				snippet = extractSnippet(doc.Source, matched) or truncateText(doc.Source, CONFIG.MAX_SNIPPET_CHARS)
			else
				snippet = "(empty dump) " .. doc.Path
			end
			table.insert(lastSourceHits, {
				Name = doc.Name,
				Path = doc.Path,
				Why = doc.Why,
				Snippet = snippet,
			})
			if #lastSourceHits >= cap then
				break
			end
		end
	end
end

local function sourceLooksLikeAnti(source)
	if type(source) ~= "string" or source == "" then
		return false
	end
	local lower = string.lower(source)
	local hits = 0
	for _, marker in ipairs(AC_SOURCE_MARKERS) do
		if string.find(lower, marker, 1, true) then
			hits = hits + 1
		end
	end
	return hits >= 2
end

local function connectionScript(conn)
	if conn == nil then
		return nil
	end
	local ok, scriptInst = pcall(function()
		return conn.Script or conn.script
	end)
	if ok and typeof(scriptInst) == "Instance" then
		return scriptInst
	end
	return nil
end

local function connectionFunction(conn)
	if conn == nil then
		return nil
	end
	local ok, fn = pcall(function()
		return conn.Function or conn.fn or conn.Callback or conn.Function
	end)
	if ok and type(fn) == "function" then
		return fn
	end
	return nil
end

dumpSelectedInstance = function()
	local inst = explorerSelected
	if typeof(inst) ~= "Instance" then
		addMessage("Select something in Explorer first.", false)
		return
	end
	local okType, isScript = pcall(function()
		return inst:IsA("LocalScript") or inst:IsA("ModuleScript") or inst:IsA("Script")
	end)
	if not okType or not isScript then
		addMessage("Dump is for a LocalScript or ModuleScript. For a button or value, use Links.", false)
		return
	end
	local path = inst:GetFullName()
	local source, kind = inspectScript(inst, CONFIG.MAX_SOURCE_CHARS)
	if type(source) ~= "string" or #source < 12 then
		addMessage("No strings from " .. path .. " (needs getconstants, getsenv, or decompile).", false)
		return
	end
	table.insert(sourceIndex, 1, {
		Name = inst.Name,
		Path = path,
		Why = "explorer " .. tostring(kind),
		Source = source,
		Kind = kind,
		Lower = string.lower(inst.Name .. " " .. path .. " " .. source),
	})
	while #sourceIndex > (CONFIG.MAX_SOURCE_DOCS_HUNT or 48) do
		table.remove(sourceIndex)
	end
	addMessage("Dumped " .. path .. " (" .. tostring(kind) .. "). Search Remotes or Ask AI about this script.", false)
end

inspectSelectedConnections = function()
	local inst = explorerSelected
	if typeof(inst) ~= "Instance" then
		addMessage("Select something in Explorer first.", false)
		return
	end
	local getconnections = safeGlobal("getconnections")
	if type(getconnections) ~= "function" then
		addMessage("This executor has no getconnections — Links cannot see button/value handlers.", false)
		return
	end
	local names = {}
	local function consider(name)
		local ok, sig = pcall(function()
			return inst[name]
		end)
		if ok and typeof(sig) == "RBXScriptSignal" then
			names[#names + 1] = name
		end
	end
	if inst:IsA("GuiButton") then
		consider("Activated")
		consider("MouseButton1Click")
		consider("MouseButton2Click")
	elseif inst:IsA("ClickDetector") then
		consider("MouseClick")
		consider("MouseHoverEnter")
	elseif inst:IsA("ProximityPrompt") then
		consider("Triggered")
	elseif inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent") then
		consider("OnClientEvent")
	elseif inst:IsA("ValueBase") then
		consider("Changed")
	elseif inst:IsA("Humanoid") then
		consider("StateChanged")
		consider("Died")
		consider("HealthChanged")
	elseif inst:IsA("BasePart") then
		consider("Touched")
	else
		consider("Activated")
		consider("Changed")
		consider("Triggered")
		consider("MouseButton1Click")
	end
	if #names == 0 then
		addMessage("No client signals on this " .. inst.ClassName .. " to list.", false)
		return
	end
	local lines = { "Links on " .. inst:GetFullName() .. ":" }
	for _, name in ipairs(names) do
		local ok, sig = pcall(function()
			return inst[name]
		end)
		if ok and typeof(sig) == "RBXScriptSignal" then
			local okConns, conns = pcall(getconnections, sig)
			if not okConns or type(conns) ~= "table" then
				table.insert(lines, name .. " — could not read connections")
			else
				local n = 0
				for _, conn in pairs(conns) do
					n = n + 1
					if n > 8 then
						break
					end
					local scriptInst = connectionScript(conn)
					local fn = connectionFunction(conn)
					local who = "?"
					if typeof(scriptInst) == "Instance" then
						local okName, full = pcall(function()
							return scriptInst:GetFullName()
						end)
						who = okName and full or scriptInst.Name
					end
					local into, seen = {}, {}
					if type(fn) == "function" then
						collectFromFunction(fn, into, seen, 0)
					end
					local extra = #into > 0 and (" | " .. table.concat(into, ", ")) or " (no constants/upvalues)"
					table.insert(lines, name .. " → " .. who .. extra)
				end
				if n == 0 then
					table.insert(lines, name .. " — 0 listeners on this client")
				end
			end
		end
	end
	addMessage(table.concat(lines, "\n"), false)
	if switchMainTab then
		switchMainTab("Chat")
	end
end

local function findWriters(signal)
	local getconnections = safeGlobal("getconnections")
	if type(getconnections) ~= "function" or signal == nil then
		return nil
	end
	local ok, conns = pcall(getconnections, signal)
	if not ok or type(conns) ~= "table" then
		return nil
	end
	local names = {}
	local seen = {}
	for _, conn in ipairs(conns) do
		local scriptInst = connectionScript(conn)
		local label
		if typeof(scriptInst) == "Instance" then
			label = scriptInst.Name
		else
			local fn = connectionFunction(conn)
			if type(fn) == "function" then
				local okInfo, source = pcall(function()
					return debug.info(fn, "s")
				end)
				if (not okInfo or type(source) ~= "string") and debug.getinfo then
					okInfo, source = pcall(function()
						local info = debug.getinfo(fn)
						return info and (info.short_src or info.source)
					end)
				end
				if (not okInfo or type(source) ~= "string" or source == "" or source == "[C]") then
					okInfo, source = pcall(function()
						local env = getfenv(fn)
						local scr = env and env.script
						if typeof(scr) == "Instance" then
							return scr.Name
						end
						return nil
					end)
				end
				if okInfo and type(source) == "string" and source ~= "" and source ~= "[C]" then
					label = source
				end
			end
		end
		if label and not seen[label] then
			seen[label] = true
			table.insert(names, label)
		end
		if #names >= 4 then
			break
		end
	end
	if #names == 0 then
		return nil
	end
	return table.concat(names, ", ")
end

local function placeMemoryFile()
	return "GAI_place_" .. tostring(game.PlaceId) .. ".json"
end

local function placeMemoryBag()
	local env
	local getgenvFn = safeGlobal("getgenv")
	if type(getgenvFn) == "function" then
		local ok, bag = pcall(getgenvFn)
		if ok and type(bag) == "table" then
			env = bag
		end
	end
	if type(env) ~= "table" then
		_G.GAI_PlaceMemory = _G.GAI_PlaceMemory or {}
		return _G.GAI_PlaceMemory
	end
	env.GAI_PlaceMemory = env.GAI_PlaceMemory or {}
	return env.GAI_PlaceMemory
end

local function applyPlaceMemory(data)
	if type(data) ~= "table" then
		return false
	end
	local applied = false
	if type(data.starred) == "table" then
		for _, path in ipairs(data.starred) do
			if type(path) == "string" then
				starredPaths[path] = true
				applied = true
			end
		end
	end
	if type(data.ownership) == "table" then
		for path, owner in pairs(data.ownership) do
			ownershipByPath[path] = owner
			applied = true
		end
	end
	return applied
end

local function placeMemoryPayload()
	local starred = {}
	for path in pairs(starredPaths) do
		table.insert(starred, path)
	end
	local captures = {}
	for i = 1, math.min(8, #captureLog) do
		local cap = captureLog[i]
		table.insert(captures, {
			Method = cap.Method,
			Name = cap.Name,
			Path = cap.Path,
			IdBlob = cap.IdBlob,
			Summary = truncateText(cap.Summary, 180),
			Time = cap.Time,
		})
	end
	return {
		PlaceId = game.PlaceId,
		starred = starred,
		ownership = ownershipByPath,
		captures = captures,
	}
end

local function loadPlaceMemory()
	if not rememberPlace then
		return
	end
	local key = tostring(game.PlaceId)
	if applyPlaceMemory(placeMemoryBag()[key]) then
		if addMessage then
			addMessage("Loaded notes for this place.", false)
		end
		return
	end
	local readfile = safeGlobal("readfile")
	local isfile = safeGlobal("isfile")
	if type(readfile) ~= "function" then
		return
	end
	local name = placeMemoryFile()
	if type(isfile) == "function" then
		local ok, exists = pcall(isfile, name)
		if not ok or not exists then
			return
		end
	end
	local ok, raw = pcall(readfile, name)
	if not ok or type(raw) ~= "string" or raw == "" then
		return
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not decodeOk or type(data) ~= "table" then
		return
	end
	if applyPlaceMemory(data) then
		placeMemoryBag()[key] = data
		if addMessage then
			addMessage("Loaded notes for this place.", false)
		end
	end
end

local function savePlaceMemory()
	if not rememberPlace then
		return
	end
	local data = placeMemoryPayload()
	placeMemoryBag()[tostring(game.PlaceId)] = data
	local writefile = safeGlobal("writefile")
	if type(writefile) == "function" then
		local encodeOk, payload = pcall(function()
			return HttpService:JSONEncode(data)
		end)
		if encodeOk and type(payload) == "string" then
			pcall(writefile, placeMemoryFile(), payload)
		end
	end
end

scheduleMemorySave = function()
	if memorySaveQueued or not rememberPlace then
		return
	end
	memorySaveQueued = true
	task.delay(1, function()
		memorySaveQueued = false
		savePlaceMemory()
	end)
end

-- Find client listeners on WalkSpeed / PlatformStand / StateChanged / HRP.ChildAdded
local MOVEMENT_DUMP_NEEDLES = { "WalkSpeed", "JumpPower", "JumpHeight", "PlatformStand", "ChangeState", "HipHeight" }

local function scriptsMentioningMovement(limit)
	limit = limit or 8
	local found = {}
	local seen = {}
	local considered = 0
	local function consider(inst)
		if #found >= limit or considered >= 40 then
			return
		end
		if typeof(inst) ~= "Instance" then
			return
		end
		local okScript, isScript = pcall(function()
			return inst:IsA("LocalScript") or inst:IsA("ModuleScript")
		end)
		if not okScript or not isScript then
			return
		end
		local okPath, path = pcall(function()
			return inst:GetFullName()
		end)
		if not okPath or type(path) ~= "string" or seen[path] then
			return
		end
		seen[path] = true
		considered = considered + 1
		local blob = dumpScriptBlob(inst, 2500) or ""
		local nameBlob = inst.Name .. " " .. path
		local hits = {}
		for _, needle in ipairs(MOVEMENT_DUMP_NEEDLES) do
			if string.find(blob, needle, 1, true) or string.find(nameBlob, needle, 1, true) then
				table.insert(hits, needle)
			end
		end
		if #hits == 0 then
			return
		end
		table.insert(found, {
			Name = inst.Name,
			ClassName = inst.ClassName,
			Path = path,
			Why = "mentions " .. table.concat(hits, ", "),
			Instance = inst,
			DecompilePreview = blob ~= "" and truncateText(blob, 400) or nil,
		})
	end

	local loaded = safeGlobal("getloadedmodules")
	if type(loaded) == "function" then
		local ok, mods = pcall(loaded)
		if ok and type(mods) == "table" then
			for _, mod in ipairs(mods) do
				consider(mod)
				if #found >= limit then
					return found
				end
			end
		end
	end
	local getscripts = safeGlobal("getscripts")
	if type(getscripts) == "function" then
		local ok, list = pcall(getscripts)
		if ok and type(list) == "table" then
			for _, inst in ipairs(list) do
				consider(inst)
				if #found >= limit then
					return found
				end
			end
		end
	end
	local roots = { player:FindFirstChild("PlayerScripts"), player.Character, game:FindFirstChild("ReplicatedFirst") }
	local nameKeywords = mergeArrays(MOVEMENT_KEYWORDS, ANTI_KEYWORDS)
	for _, root in ipairs(roots) do
		if root then
			local ok, desc = pcall(function()
				return root:GetDescendants()
			end)
			if ok then
				for _, inst in ipairs(desc) do
					if inst:IsA("LocalScript") or inst:IsA("ModuleScript") then
						if stringContainsKeyword(inst.Name .. " " .. inst:GetFullName(), nameKeywords) then
							consider(inst)
							if #found >= limit then
								return found
							end
						end
					end
				end
			end
		end
	end
	return found
end

local function listKeywordRemotes(keywords, cap)
	local names = {}
	for _, entry in ipairs(remoteRegistry) do
		local blob = string.lower((entry.Name or "") .. " " .. (entry.Path or ""))
		if stringContainsKeyword(blob, keywords) then
			table.insert(names, entry.Name)
			if #names >= (cap or 6) then
				break
			end
		end
	end
	return names
end

local function scanBehavioralAnti()
	local found = {}
	local seen = {}
	local note
	local getconnections = safeGlobal("getconnections")
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if type(getconnections) == "function" then
		local probes = {}
		if hum then
			table.insert(probes, { hum:GetPropertyChangedSignal("WalkSpeed"), "WalkSpeed" })
			table.insert(probes, { hum:GetPropertyChangedSignal("JumpPower"), "JumpPower" })
			table.insert(probes, { hum:GetPropertyChangedSignal("PlatformStand"), "PlatformStand" })
			table.insert(probes, { hum.StateChanged, "StateChanged" })
		end
		if root then
			table.insert(probes, { root.ChildAdded, "RootChildAdded" })
			table.insert(probes, { root:GetPropertyChangedSignal("CFrame"), "RootCFrame" })
		end

		for _, probe in ipairs(probes) do
			local ok, conns = pcall(getconnections, probe[1])
			if ok and type(conns) == "table" then
				for _, conn in ipairs(conns) do
					local scriptInst = connectionScript(conn)
					local path = (typeof(scriptInst) == "Instance" and scriptInst:GetFullName()) or "anonymous"
					if not seen[path .. probe[2]] then
						seen[path .. probe[2]] = true
						table.insert(found, {
							Name = (typeof(scriptInst) == "Instance" and scriptInst.Name) or "anonymous",
							ClassName = (typeof(scriptInst) == "Instance" and scriptInst.ClassName) or "Function",
							Path = path,
							Why = "listens to " .. probe[2],
							Instance = typeof(scriptInst) == "Instance" and scriptInst or nil,
						})
					end
				end
			end
		end
	else
		note = "No getconnections — listed scripts that mention WalkSpeed/JumpPower instead."
	end

	if #found == 0 then
		for _, item in ipairs(scriptsMentioningMovement(8)) do
			if not seen[item.Path] then
				seen[item.Path] = true
				table.insert(found, item)
			end
		end
		if #found > 0 and not note then
			note = "No live listeners found — listed scripts whose strings mention movement properties."
		end
	end

	return found, note
end

safeGetAttributes = function(instance)
	local attrs = {}
	local ok, attributeList = pcall(function()
		return instance:GetAttributes()
	end)
	if ok and attributeList then
		for name, value in pairs(attributeList) do
			attrs[name] = tostring(value)
		end
	end
	return attrs
end

local function parseValueInput(className, text)
	text = string.gsub(text, "^%s*(.-)%s*$", "%1")
	if className == "BoolValue" then
		local lower = string.lower(text)
		if lower == "true" or lower == "1" or lower == "yes" then
			return true
		end
		if lower == "false" or lower == "0" or lower == "no" then
			return false
		end
		error("BoolValue expects true/false")
	elseif className == "IntValue" then
		local n = tonumber(text)
		if not n then
			error("Invalid integer")
		end
		return math.floor(n)
	elseif className == "NumberValue" or className == "DoubleConstrainedValue" then
		return tonumber(text) or error("Invalid number")
	elseif className == "StringValue" then
		return text
	elseif className == "Vector3Value" then
		local x, y, z = string.match(text, "([^,]+),([^,]+),([^,]+)")
		if not x then
			error("Vector3 format: x,y,z")
		end
		x, y, z = tonumber(x), tonumber(y), tonumber(z)
		if not x or not y or not z then
			error("Vector3 format: x,y,z")
		end
		return Vector3.new(x, y, z)
	elseif className == "Color3Value" then
		local r, g, b = string.match(text, "([^,]+),([^,]+),([^,]+)")
		if not r then
			error("Color3 format: r,g,b (0-255 or 0-1)")
		end
		r, g, b = tonumber(r), tonumber(g), tonumber(b)
		if not r or not g or not b then
			error("Color3 format: r,g,b")
		end
		if r > 1 or g > 1 or b > 1 then
			return Color3.fromRGB(r, g, b)
		end
		return Color3.new(r, g, b)
	elseif className == "Attribute" then
		local lower = string.lower(text)
		if lower == "true" then
			return true
		end
		if lower == "false" then
			return false
		end
		local n = tonumber(text)
		if n then
			return n
		end
		return text
	end
	return text
end

local function applyValueToInstance(instance, newValue)
	if not instance or not instance.Parent then
		return false, "Instance missing"
	end
	local ok, err = pcall(function()
		instance.Value = newValue
	end)
	if ok then
		return true, "Updated"
	end
	return false, tostring(err)
end

local function historyText()
	if #valueHistory == 0 then
		return "No changes yet. Set a value or move — server reverts show up here."
	end
	local parts = {}
	for i = 1, math.min(6, #valueHistory) do
		local h = valueHistory[i]
		table.insert(parts, h.Time .. "  " .. h.Path .. "  " .. h.From .. " → " .. h.To .. "  (" .. h.Why .. ")")
	end
	return table.concat(parts, "\n")
end

local function recordValueHistory(path, fromV, toV, why)
	if tostring(fromV) == tostring(toV) then
		return
	end
	table.insert(valueHistory, 1, {
		Path = path,
		From = tostring(fromV),
		To = tostring(toV),
		Why = why or "changed",
		Time = os.date("%H:%M:%S"),
	})
	while #valueHistory > 20 do
		table.remove(valueHistory)
	end
	if historySummaryLabel then
		historySummaryLabel.Text = historyText()
	end
end

local function watchHumanoidHistory()
	for _, conn in ipairs(humWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	humWatchConns = {}
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight" }) do
		local last = hum[prop]
		local conn = hum:GetPropertyChangedSignal(prop):Connect(function()
			local now = hum[prop]
			local writers = findWriters(hum:GetPropertyChangedSignal(prop))
			local why = writers and ("changed by " .. writers) or "changed"
			recordValueHistory("Humanoid." .. prop, last, now, why)
			last = now
		end)
		table.insert(humWatchConns, conn)
	end
end

local function stripForJson(value, depth)
	depth = depth or 0
	if depth > 6 then
		return nil
	end
	local t = typeof(value)
	if t == "Instance" then
		return nil
	end
	if t == "table" then
		local out = {}
		for k, v in pairs(value) do
			if k ~= "Instance" then
				out[k] = stripForJson(v, depth + 1)
			end
		end
		return out
	end
	if t == "Vector3" then
		return tostring(value)
	end
	if t == "CFrame" or t == "Color3" or t == "UDim2" then
		return tostring(value)
	end
	if t == "string" or t == "number" or t == "boolean" or t == "nil" then
		return value
	end
	return tostring(value)
end

local function setupDragFrame(dragHandle, targetFrame)
	local function isDragInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end
	bindSharedInput()
	dragHandle.InputBegan:Connect(function(input)
		if isDragInput(input) then
			activeFrameDrag = {
				target = targetFrame,
				start = input.Position,
				pos = targetFrame.Position,
			}
		end
	end)
end

local function updateMessageContainerSize()
	if messageLayout then
		messageContainer.CanvasSize = UDim2.new(0, 0, 0, messageLayout.AbsoluteContentSize.Y + 8)
	end
end

addMessage = function(text, isUser)
	if not messageContainer then
		return
	end
	text = truncateText(text)
	local messageFrame = Instance.new("Frame")
	messageFrame.AutomaticSize = Enum.AutomaticSize.Y
	messageFrame.Size = UDim2.new(1, -8, 0, 0)
	messageFrame.BackgroundTransparency = 1
	messageFrame.LayoutOrder = #messages + 1
	messageFrame.Parent = messageContainer

	local bubble = Instance.new("Frame")
	bubble.AutomaticSize = Enum.AutomaticSize.Y
	bubble.Size = UDim2.new(isUser and 0.92 or 1, 0, 0, 0)
	bubble.Position = UDim2.new(isUser and 0.08 or 0, 0, 0, 0)
	bubble.BackgroundColor3 = isUser and CONFIG.THEME.SECONDARY or CONFIG.THEME.PANEL
	bubble.BackgroundTransparency = isUser and 0 or 1
	bubble.BorderSizePixel = 0
	bubble.Parent = messageFrame
	if isUser then
		addCorner(bubble, 10)
	end

	local messageLabel = Instance.new("TextLabel")
	messageLabel.AutomaticSize = Enum.AutomaticSize.Y
	messageLabel.BackgroundTransparency = 1
	messageLabel.Font = Enum.Font.Gotham
	messageLabel.Text = text
	messageLabel.TextColor3 = isUser and CONFIG.THEME.ACCENT or CONFIG.THEME.TEXT
	messageLabel.TextSize = 13
	messageLabel.TextXAlignment = isUser and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	messageLabel.TextWrapped = true
	messageLabel.TextTransparency = 1
	messageLabel.Size = UDim2.new(1, isUser and -16 or 0, 0, 0)
	if isUser then
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 8)
		pad.PaddingBottom = UDim.new(0, 8)
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		pad.Parent = bubble
	end
	if isUser then
		bubble.BackgroundTransparency = 1
	end
	messageLabel.Parent = bubble
	local bubbleLayout = Instance.new("UIListLayout")
	bubbleLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bubbleLayout.Parent = bubble
	local stack = Instance.new("UIListLayout")
	stack.Parent = messageFrame

	table.insert(messages, { text = text, isUser = isUser })
	local scale = Instance.new("UIScale")
	scale.Scale = 0.94
	scale.Parent = messageFrame
	tween(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	tween(messageLabel, TWEEN_SOFT, { TextTransparency = 0 })
	if isUser then
		tween(bubble, TWEEN_SOFT, { BackgroundTransparency = 0 })
	end
	task.defer(function()
		updateMessageContainerSize()
		if messageContainer then
			messageContainer.CanvasPosition = Vector2.new(0, messageContainer.AbsoluteCanvasSize.Y)
		end
	end)
end

local function createValueRow(parent, layoutOrder, entry)
	local row = Instance.new("Frame")
	row.Name = "ValueRow"
	row.Size = UDim2.new(1, -4, 0, 86)
	row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -96, 0, 16),
		Position = UDim2.new(0, 8, 0, 4),
		Text = entry.Name .. "  (" .. entry.ClassName .. ")  [" .. (entry.Ownership or "unknown") .. "]",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
	})

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 22, 0, 16),
		Position = UDim2.new(1, -72, 0, 4),
		BackgroundColor3 = starredPaths[entry.Path] and CONFIG.THEME.WARNING or CONFIG.THEME.SECONDARY,
		Text = starredPaths[entry.Path] and "★" or "☆",
		TextSize = 10,
		Tip = {
			does = "Pins this value on the Star filter.",
			risk = "Quiet.",
		},
	}).MouseButton1Click:Connect(function()
		if starredPaths[entry.Path] then
			starredPaths[entry.Path] = nil
		else
			starredPaths[entry.Path] = true
		end
		scheduleMemorySave()
		rebuildValueExplorer()
	end)

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 40, 0, 16),
		Position = UDim2.new(1, -48, 0, 4),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "Copy",
		TextSize = 10,
	}).MouseButton1Click:Connect(function()
		copyPath(entry.Path)
	end)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -16, 0, 14),
		Position = UDim2.new(0, 8, 0, 20),
		Text = entry.Path,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local valueBox = Instance.new("TextBox")
	valueBox.Size = UDim2.new(1, -68, 0, 24)
	valueBox.Position = UDim2.new(0, 8, 0, 36)
	valueBox.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	valueBox.BorderSizePixel = 0
	valueBox.Font = Enum.Font.Gotham
	valueBox.Text = tostring(entry.Value)
	valueBox.TextColor3 = CONFIG.THEME.TEXT
	valueBox.TextSize = 12
	valueBox.ClearTextOnFocus = false
	valueBox.Parent = row
	addCorner(valueBox, 6)

	local applyBtn = makeButton({
		Parent = row,
		Size = UDim2.new(0, 52, 0, 24),
		Position = UDim2.new(1, -60, 0, 36),
		BackgroundColor3 = CONFIG.THEME.SUCCESS,
		Text = "Set",
		TextSize = 11,
		Tip = {
			does = "One local write to see if the server reverts it.",
			risk = "Medium — a single change. Stop if it snaps back; never loop it.",
		},
	})

	local status = makeLabel({
		Parent = row,
		Size = UDim2.new(1, -16, 0, 18),
		Position = UDim2.new(0, 8, 0, 64),
		Text = "One local write to test ownership. If it snaps back, stop — fighting the server is what gets flagged.",
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})

	local function getInstance()
		local inst = entry.Instance
		if inst and inst.Parent then
			return inst
		end
		local hostPath = entry.ClassName == "Attribute" and string.match(entry.Path, "^(.*)@[^@]+$") or entry.Path
		inst = resolvePath(hostPath or entry.Path)
		if inst then
			entry.Instance = inst
			return inst
		end
		return nil
	end

	local function refreshFromInstance()
		local inst = getInstance()
		if not inst then
			return
		end
		if entry.ClassName == "Attribute" then
			valueBox.Text = tostring(inst:GetAttribute(entry.AttributeName))
		else
			valueBox.Text = tostring(inst.Value)
		end
	end

	local function parseCurrent()
		local parseOk, parsed = pcall(parseValueInput, entry.ClassName, valueBox.Text)
		if not parseOk then
			return nil, parsed
		end
		return parsed, nil
	end

	applyBtn.MouseButton1Click:Connect(function()
		local inst = getInstance()
		if not inst then
			status.Text = "Not found"
			status.TextColor3 = CONFIG.THEME.ERROR
			return
		end
		if inst:IsA("Humanoid") then
			status.Text = "Humanoid is read-only here. Probe it instead."
			status.TextColor3 = CONFIG.THEME.WARNING
			return
		end
		local parsed, parseErr = parseCurrent()
		if parseErr then
			status.Text = tostring(parseErr)
			status.TextColor3 = CONFIG.THEME.ERROR
			return
		end
		local isAttr = entry.ClassName == "Attribute"
		local before = isAttr and inst:GetAttribute(entry.AttributeName) or inst.Value
		local applyOk, msg
		if isAttr then
			applyOk, msg = pcall(function()
				inst:SetAttribute(entry.AttributeName, parsed)
			end)
			if applyOk then
				msg = "Updated"
			else
				applyOk = false
				msg = tostring(msg)
			end
		else
			applyOk, msg = applyValueToInstance(inst, parsed)
		end
		if not applyOk then
			status.Text = msg
			status.TextColor3 = CONFIG.THEME.ERROR
			return
		end
		recordValueHistory(entry.Path, before, parsed, "set")
		status.Text = "Wrote locally. Checking if the server reverts..."
		status.TextColor3 = CONFIG.THEME.WARNING
		task.delay(0.35, function()
			if not inst.Parent then
				return
			end
			local still = isAttr and inst:GetAttribute(entry.AttributeName) or inst.Value
			local same = still == parsed or tostring(still) == tostring(parsed)
			if same then
				entry.Ownership = "client"
				ownershipByPath[entry.Path] = "client"
				lastBrief = ""
				scheduleMemorySave()
				status.Text = "Sticks on client — this one you can edit here."
				status.TextColor3 = CONFIG.THEME.SUCCESS
			else
				entry.Ownership = "server"
				ownershipByPath[entry.Path] = "server"
				lastBrief = ""
				local writers
				if isAttr then
					writers = findWriters(inst:GetAttributeChangedSignal(entry.AttributeName))
				else
					writers = findWriters(inst.Changed)
				end
				local why = writers and ("server revert by " .. writers) or "server revert"
				recordValueHistory(entry.Path, parsed, still, why)
				scheduleMemorySave()
				if not spyEnabled then
					setSpyEnabled(true, "Server reverted that value — listening for the remote that corrected it.")
				end
				if starredPaths[entry.Path] then
					showToast("Starred value reverted", entry.Name .. " → " .. tostring(still), "value")
				end
				status.Text = "Server reverted it. Spy/Listen is on — do the same action again to catch the remote. Do not rewrite it in a loop."
				status.TextColor3 = CONFIG.THEME.ERROR
				valueBox.Text = tostring(still)
			end
		end)
	end)

	if entry.ClassName == "Attribute" then
		status.Text = "Attribute Set is one local write. If it snaps back, the server owns it."
	end

	local inst = getInstance()
	local changedConn
	if inst then
		if entry.ClassName == "Attribute" then
			changedConn = inst:GetAttributeChangedSignal(entry.AttributeName):Connect(function()
				if inst.Parent then
					valueBox.Text = tostring(inst:GetAttribute(entry.AttributeName))
				end
			end)
		else
			changedConn = inst.Changed:Connect(function()
				if inst.Parent then
					valueBox.Text = tostring(inst.Value)
				end
			end)
		end
	end
	row.Destroying:Connect(function()
		if changedConn then
			changedConn:Disconnect()
		end
	end)

	refreshFromInstance()
	return row
end

local function createAntiScriptRow(parent, layoutOrder, entry)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 96)
	row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -10, 0, 18),
		Position = UDim2.new(0, 8, 0, 4),
		Text = entry.Name .. " (" .. entry.ClassName .. ")" .. (entry.Why and (" — " .. entry.Why) or ""),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
	})

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 40, 0, 16),
		Position = UDim2.new(1, -48, 0, 4),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "Copy",
		TextSize = 10,
	}).MouseButton1Click:Connect(function()
		copyPath(entry.Path)
	end)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -10, 0, 28),
		Position = UDim2.new(0, 8, 0, 22),
		Text = entry.Path,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})

	local preview = entry.DecompilePreview or entry.DecompileError
	if not preview or preview == "" then
		preview = "No strings dumped yet — Ask AI will dump this script."
	end
	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -10, 0, 22),
		Position = UDim2.new(0, 8, 0, 48),
		Text = truncateText(preview, 120),
		TextColor3 = CONFIG.THEME.WARNING,
		TextSize = 10,
	})

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 72, 0, 22),
		Position = UDim2.new(0, 8, 1, -28),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "Ask AI",
		TextSize = 11,
	}).MouseButton1Click:Connect(function()
		if not handleQuery then
			return
		end
		if (not entry.DecompilePreview or entry.DecompilePreview == "") and entry.Instance then
			local source = inspectScript(entry.Instance, CONFIG.MAX_DECOMPILE_CHARS, { gc = true })
			if source then
				entry.DecompilePreview = source
			end
		end
		inputBox.Text = "Explain what this anti-cheat script checks. Do not suggest bypasses, speed edits, fly, or disabling it.\nScript: "
			.. entry.Path
			.. "\nPreview: "
			.. truncateText(entry.DecompilePreview or preview, 400)
		handleQuery()
	end)
end

local function makeArgBox(parent, text)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -8, 0, 22)
	box.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	box.BorderSizePixel = 0
	box.Font = Enum.Font.Gotham
	box.Text = text or ""
	box.TextColor3 = CONFIG.THEME.TEXT
	box.TextSize = 11
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.Parent = parent
	addCorner(box, 4)
	return box
end

local function addSnapEditors(parent, snap, label, layoutOrder)
	layoutOrder = layoutOrder or 0
	if snap.kind == "table" then
		makeLabel({
			Parent = parent,
			Size = UDim2.new(1, -8, 0, 16),
			Text = label .. "  {table}",
			TextColor3 = CONFIG.THEME.TEXT_DIM,
			TextSize = 10,
			LayoutOrder = layoutOrder,
		}).LayoutOrder = layoutOrder
		local nextOrder = layoutOrder + 1
		for _, child in ipairs(snap.children or {}) do
			nextOrder = addSnapEditors(parent, child.value, label .. "." .. child.key, nextOrder)
		end
		return nextOrder
	end

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 40)
	row.BackgroundTransparency = 1
	row.LayoutOrder = layoutOrder
	row.Parent = parent

	local tag = snap.idTag and ("  [" .. snap.idTag .. " guess]") or ""
	makeLabel({
		Parent = row,
		Size = UDim2.new(1, 0, 0, 14),
		Text = label .. "  (" .. snap.kind .. ")" .. tag,
		TextColor3 = snap.idTag and CONFIG.THEME.WARNING or CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})

	local box = makeArgBox(row, snap.editText or snap.text)
	box.Position = UDim2.new(0, 0, 0, 16)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		snap.editText = box.Text
	end)
	return layoutOrder + 1
end

local function searchFromText(text)
	if remotesSearchBox then
		remotesSearchBox.Text = text
	end
	if remotesView ~= "Captures" then
		remotesView = "Captures"
		if remotesCaptures then
			remotesCaptures.Visible = true
		end
		if remotesKnown then
			remotesKnown.Visible = false
		end
		if remotesCapturesBtn then
			remotesCapturesBtn.BackgroundColor3 = CONFIG.THEME.PRIMARY
		end
		if remotesKnownBtn then
			remotesKnownBtn.BackgroundColor3 = CONFIG.THEME.SECONDARY
		end
	end
	runSourceSearch(text)
end

local function createHeldItemsCard(parent, layoutOrder)
	local items = collectHeldItems()
	local row = Instance.new("Frame")
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.Size = UDim2.new(1, -4, 0, 40)
	row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	local inner = Instance.new("Frame")
	inner.Size = UDim2.new(1, -12, 0, 0)
	inner.Position = UDim2.new(0, 6, 0, 4)
	inner.AutomaticSize = Enum.AutomaticSize.Y
	inner.BackgroundTransparency = 1
	inner.Parent = row

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = inner

	makeLabel({
		Parent = inner,
		Size = UDim2.new(1, 0, 0, 16),
		Text = "Held items / attributes",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		LayoutOrder = 0,
	}).LayoutOrder = 0

	if #items == 0 then
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 28),
			Text = "Nothing with ids in Backpack/Character yet. Pick something up with Spy on.",
			TextColor3 = CONFIG.THEME.TEXT_DIM,
			TextSize = 10,
			LayoutOrder = 1,
		}).LayoutOrder = 1
		return
	end

	for i, item in ipairs(items) do
		local idText = #item.Ids > 0 and table.concat(item.Ids, " | ") or table.concat(item.Values, " | ")
		if idText == "" then
			idText = "(no id attributes)"
		end
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 28),
			Text = item.Scope .. " / " .. item.Name .. "  " .. idText,
			TextSize = 10,
			LayoutOrder = i,
		}).LayoutOrder = i
		if item.Ids[1] then
			local idValue = string.match(item.Ids[1], "=(%S+)")
			if idValue then
				makeButton({
					Parent = inner,
					Size = UDim2.new(0, 90, 0, 18),
					BackgroundColor3 = CONFIG.THEME.PRIMARY,
					Text = "Search id",
					TextSize = 10,
					LayoutOrder = i + 50,
				}).MouseButton1Click:Connect(function()
					searchFromText(idValue)
				end)
			end
		end
	end
end

local function createSourceHitRow(parent, layoutOrder, hit)
	local row = Instance.new("Frame")
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.Size = UDim2.new(1, -4, 0, 70)
	row.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -12, 0, 16),
		Position = UDim2.new(0, 6, 0, 4),
		Text = "Source  " .. hit.Name .. "  (" .. (hit.Why or "") .. ")",
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
	})
	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -12, 0, 48),
		Position = UDim2.new(0, 6, 0, 22),
		Text = hit.Snippet or "",
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})
	makeButton({
		Parent = row,
		Size = UDim2.new(0, 56, 0, 18),
		Position = UDim2.new(1, -64, 0, 4),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "Ask AI",
		TextSize = 10,
	}).MouseButton1Click:Connect(function()
		if not handleQuery then
			return
		end
		inputBox.Text = "Explain this source snippet. If it sends remotes for items/inventory, say which args are instance UUIDs vs item type ids.\n"
			.. hit.Path
			.. "\n"
			.. (hit.Snippet or "")
		handleQuery()
	end)
end

local function createCaptureRow(parent, layoutOrder, cap)
	local row = Instance.new("Frame")
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.Size = UDim2.new(1, -4, 0, 80)
	row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	local inner = Instance.new("Frame")
	inner.Size = UDim2.new(1, -12, 0, 0)
	inner.Position = UDim2.new(0, 6, 0, 4)
	inner.AutomaticSize = Enum.AutomaticSize.Y
	inner.BackgroundTransparency = 1
	inner.Parent = row

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 3)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = inner

	makeLabel({
		Parent = inner,
		Size = UDim2.new(1, 0, 0, 16),
		Text = cap.Method .. "  " .. cap.Name .. "  " .. (cap.Time or ""),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		LayoutOrder = 0,
	}).LayoutOrder = 0

	makeLabel({
		Parent = inner,
		Size = UDim2.new(1, 0, 0, 14),
		Text = cap.Path,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	}).LayoutOrder = 1

	if cap.From then
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 14),
			Text = "from: " .. cap.From,
			TextColor3 = CONFIG.THEME.TEXT_DIM,
			TextSize = 10,
			LayoutOrder = 2,
		}).LayoutOrder = 2
	end

	if cap.Pair then
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 14),
			Text = "pair: " .. cap.Pair,
			TextColor3 = CONFIG.THEME.SUCCESS,
			TextSize = 10,
			LayoutOrder = 2,
			Tip = {
				does = "Guesses this inbound event followed that FireServer (within 0.55s).",
				risk = "Quiet — timing only, nothing is sent.",
			},
		}).LayoutOrder = 2
	end

	if cap.StatDelta then
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 14),
			Text = "stats: " .. cap.StatDelta,
			TextColor3 = CONFIG.THEME.ACCENT,
			TextSize = 10,
			LayoutOrder = 2,
			Tip = {
				does = "leaderstats that changed around this capture.",
				risk = "Quiet — watches .Changed, does not Set.",
			},
		}).LayoutOrder = 2
	end

	if cap.IdBlob ~= "" then
		makeLabel({
			Parent = inner,
			Size = UDim2.new(1, 0, 0, 28),
			Text = "IDs: " .. cap.IdBlob,
			TextColor3 = CONFIG.THEME.WARNING,
			TextSize = 10,
			LayoutOrder = 3,
		}).LayoutOrder = 3
	end

	local detail
	local function ensureArgEditors()
		if detail then
			return
		end
		detail = Instance.new("Frame")
		detail.Name = "ArgEditors"
		detail.AutomaticSize = Enum.AutomaticSize.Y
		detail.Size = UDim2.new(1, 0, 0, 0)
		detail.BackgroundTransparency = 1
		detail.LayoutOrder = 50
		detail.Parent = inner
		local dLayout = Instance.new("UIListLayout")
		dLayout.Padding = UDim.new(0, 2)
		dLayout.SortOrder = Enum.SortOrder.LayoutOrder
		dLayout.Parent = detail
		local order = 10
		for i, snap in ipairs(cap.ArgSnaps) do
			order = addSnapEditors(detail, snap, "arg" .. i, order)
		end
	end

	local actions = Instance.new("Frame")
	actions.Size = UDim2.new(1, 0, 0, 22)
	actions.BackgroundTransparency = 1
	actions.LayoutOrder = 200
	actions.Parent = inner

	local canReplay = cap.Method == "FireServer" or cap.Method == "InvokeServer"
	local xOff = 0
	local expandBtn = makeButton({
		Parent = actions,
		Size = UDim2.new(0, 44, 0, 20),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = cap.Expanded and "Hide" or "Args",
		TextSize = 10,
		Tip = {
			does = "Shows captured args so you can read them.",
			risk = "Quiet — display only.",
		},
	})
	expandBtn.MouseButton1Click:Connect(function()
		cap.Expanded = not cap.Expanded
		expandBtn.Text = cap.Expanded and "Hide" or "Args"
		if cap.Expanded then
			ensureArgEditors()
		elseif detail then
			detail:Destroy()
			detail = nil
		end
	end)
	xOff = 48
	if cap.Expanded then
		ensureArgEditors()
	end
	if canReplay then
		makeButton({
			Parent = actions,
			Size = UDim2.new(0, 56, 0, 20),
			Position = UDim2.new(0, xOff, 0, 0),
			BackgroundColor3 = CONFIG.THEME.PRIMARY,
			Text = "Replay",
			TextSize = 10,
			Tip = {
				does = "Resends this FireServer/InvokeServer with the captured args.",
				risk = "Loud — the server sees a real call. Easy ban if it's shop/combat.",
			},
		}).MouseButton1Click:Connect(function()
			replayCapture(cap)
		end)
		xOff = xOff + 60
	end

	makeButton({
		Parent = actions,
		Size = UDim2.new(0, 56, 0, 20),
		Position = UDim2.new(0, xOff, 0, 0),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "Ask AI",
		TextSize = 10,
		Tip = {
			does = "Sends this capture to chat for an explanation.",
			risk = "Quiet unless AI tools are ON (then it may Spy/Dump).",
		},
	}).MouseButton1Click:Connect(function()
		if not handleQuery then
			return
		end
		inputBox.Text = "This remote captured in-game. Explain the args. Tag instance-uuid vs catalog/type-id. What is the remote for?"
			.. (cap.Pair and ("\nPair: " .. cap.Pair) or "")
			.. (cap.StatDelta and ("\nStats: " .. cap.StatDelta) or "")
			.. "\n"
			.. cap.Summary
			.. (cap.IdBlob ~= "" and ("\nIDs: " .. cap.IdBlob) or "")
			.. (cap.From and ("\nFrom: " .. cap.From) or "")
		handleQuery()
	end)

	makeButton({
		Parent = actions,
		Size = UDim2.new(0, 56, 0, 20),
		Position = UDim2.new(0, xOff + 60, 0, 0),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "Search",
		TextSize = 10,
		Tip = {
			does = "Searches captures and dumped script strings for this id/name.",
			risk = "Quiet unless it triggers Dump.",
		},
	}).MouseButton1Click:Connect(function()
		local q = cap.Name
		if cap.Ids[1] then
			local idValue = string.match(cap.Ids[1], "=(%S+)")
			q = idValue or cap.Name
		end
		searchFromText(q)
	end)

	makeButton({
		Parent = actions,
		Size = UDim2.new(0, 40, 0, 20),
		Position = UDim2.new(0, xOff + 120, 0, 0),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "Copy",
		TextSize = 10,
		Tip = {
			does = "Copies the remote path.",
			risk = "Quiet.",
		},
	}).MouseButton1Click:Connect(function()
		copyPath(cap.Path)
	end)

	makeButton({
		Parent = actions,
		Size = UDim2.new(0, 40, 0, 20),
		Position = UDim2.new(0, xOff + 164, 0, 0),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "Diff",
		TextSize = 10,
		Tip = {
			does = "Compares args to the last capture of this same remote.",
			risk = "Quiet — local compare.",
		},
	}).MouseButton1Click:Connect(function()
		local prev = previousCaptureSamePath(cap)
		if not prev then
			if remotesHint then
				remotesHint.Text = "No earlier capture of " .. cap.Name .. " to diff against."
			end
			addMessage("Diff: no earlier " .. cap.Method .. " " .. cap.Name .. ".", false)
			return
		end
		local text = diffCaptureArgs(cap, prev)
		if remotesHint then
			remotesHint.Text = "Diff vs " .. (prev.Time or "previous") .. " — see chat."
		end
		addMessage("Diff " .. cap.Name .. " vs " .. (prev.Time or "previous") .. ":\n" .. text, false)
	end)
	cap.Row = row
end

pushCaptureRow = function(cap)
	if not remotesCaptures then
		capturesStale = true
		return
	end
	if not capturesVisible() then
		capturesStale = true
		return
	end
	local q = remotesSearchBox and string.lower(remotesSearchBox.Text or "") or ""
	if #lastSourceHits > 0 then
		capturesStale = true
		return
	end
	if not captureMatches(cap, q) then
		return
	end
	nextCaptureLayout = nextCaptureLayout - 1
	createCaptureRow(remotesCaptures, nextCaptureLayout, cap)
end

rebuildCaptureList = function()
	if not remotesCaptures then
		return
	end
	for _, cap in ipairs(captureLog) do
		cap.Row = nil
	end
	for _, child in ipairs(remotesCaptures:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	nextCaptureLayout = 10000
	capturesStale = false

	local order = 0
	createHeldItemsCard(remotesCaptures, order)
	order = order + 1

	for _, hit in ipairs(lastSourceHits) do
		createSourceHitRow(remotesCaptures, order, hit)
		order = order + 1
	end

	local q = remotesSearchBox and string.lower(remotesSearchBox.Text or "") or ""
	local shown = 0
	for _, cap in ipairs(captureLog) do
		if captureMatches(cap, q) then
			createCaptureRow(remotesCaptures, 10000 + shown, cap)
			shown = shown + 1
			if shown >= CONFIG.MAX_CAPTURES then
				break
			end
		end
	end

	if remotesHint and q == "" and not indexInProgress then
		refreshRemotesIdleHint()
	end
end

local function setRemotesView(view)
	remotesView = view
	if remotesCaptures then
		remotesCaptures.Visible = view == "Captures"
		if view == "Captures" then
			slideReveal(remotesCaptures, 8)
		end
	end
	if remotesKnown then
		remotesKnown.Visible = view == "Known"
		if view == "Known" then
			slideReveal(remotesKnown, 8)
		end
	end
	if remotesCapturesBtn then
		remotesCapturesBtn.BackgroundColor3 = view == "Captures" and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY
	end
	if remotesKnownBtn then
		remotesKnownBtn.BackgroundColor3 = view == "Known" and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY
	end
	if view == "Captures" and capturesStale then
		rebuildCaptureList()
	end
end

local function setCaptureMethodFilter(mode)
	captureMethodFilter = mode
	for name, btn in pairs(remotesFilterBtns) do
		btn.BackgroundColor3 = name == mode and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY
	end
	rebuildCaptureList()
end

local function stopRemoteWatch()
	for _, conn in ipairs(remoteWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	remoteWatchConns = {}
end

local function createRemoteRow(parent, layoutOrder, entry)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 78)
	row.BackgroundColor3 = CONFIG.THEME.SECONDARY
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder
	row.Parent = parent
	entry.Row = row
	addCorner(row, 8)
	addStroke(row, 1, 0.62)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -36, 0, 16),
		Position = UDim2.new(0, 8, 0, 4),
		Text = entry.Name
			.. " ("
			.. entry.ClassName
			.. ")"
			.. ((entry.Hits and entry.Hits > 0) and ("  ×" .. entry.Hits) or ""),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		Tip = {
			does = "Times this remote was captured this session (hot count).",
			risk = "Quiet — a counter only.",
		},
	})

	local starBtn = makeButton({
		Parent = row,
		Size = UDim2.new(0, 22, 0, 16),
		Position = UDim2.new(1, -28, 0, 4),
		BackgroundColor3 = starredPaths[entry.Path] and CONFIG.THEME.WARNING or CONFIG.THEME.SECONDARY,
		Text = starredPaths[entry.Path] and "★" or "☆",
		TextSize = 10,
		Tip = {
			does = "Pins this remote to the top of Known.",
			risk = "Quiet.",
		},
	})
	starBtn.MouseButton1Click:Connect(function()
		if starredPaths[entry.Path] then
			starredPaths[entry.Path] = nil
		else
			starredPaths[entry.Path] = true
		end
		starBtn.Text = starredPaths[entry.Path] and "★" or "☆"
		starBtn.BackgroundColor3 = starredPaths[entry.Path] and CONFIG.THEME.WARNING or CONFIG.THEME.SECONDARY
		scheduleMemorySave()
		if refreshRemoteSort then
			refreshRemoteSort()
		end
	end)

	makeLabel({
		Parent = row,
		Size = UDim2.new(1, -10, 0, 14),
		Position = UDim2.new(0, 8, 0, 20),
		Text = entry.Path,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local logLabel = makeLabel({
		Parent = row,
		Size = UDim2.new(1, -16, 0, 14),
		Position = UDim2.new(0, 8, 0, 36),
		Text = entry.LastLog or entry.LastOut or "Watch logs incoming OnClientEvent",
		TextColor3 = CONFIG.THEME.WARNING,
		TextSize = 10,
	})

	local watchBtn = makeButton({
		Parent = row,
		Size = UDim2.new(0, 56, 0, 20),
		Position = UDim2.new(0, 8, 1, -24),
		BackgroundColor3 = entry.Watching and CONFIG.THEME.WARNING or CONFIG.THEME.PRIMARY,
		Text = entry.Watching and "Watching" or "Watch",
		TextSize = 10,
		Tip = {
			does = "Logs this remote's OnClientEvent without Spy's namecall hook.",
			risk = "Quiet-medium — extra listener on that remote only.",
		},
	})

	watchBtn.MouseButton1Click:Connect(function()
		local inst = entry.Instance or resolvePath(entry.Path)
		if not inst or not (inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent")) then
			logLabel.Text = "Watch is for RemoteEvent incoming only."
			return
		end
		if entry.Watching then
			return
		end
		local ok, conn = pcall(function()
			return inst.OnClientEvent:Connect(function(...)
				entry.ClientFires = (entry.ClientFires or 0) + 1
				local parts = {}
				local n = select("#", ...)
				for i = 1, math.min(n, 3) do
					table.insert(parts, truncateText(tostring(select(i, ...)), 32))
				end
				entry.LastLog = string.format("#%d  %s", entry.ClientFires, table.concat(parts, ", "))
				logLabel.Text = entry.LastLog
				if not spyEnabled then
					showToast("Watched " .. (entry.Name or "remote"), entry.LastLog, "remote")
				end
			end)
		end)
		if not ok or not conn then
			logLabel.Text = "Could not watch: " .. tostring(conn)
			return
		end
		entry.Watching = true
		entry.ClientFires = 0
		watchBtn.Text = "Watching"
		watchBtn.BackgroundColor3 = CONFIG.THEME.WARNING
		table.insert(remoteWatchConns, conn)
	end)

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 56, 0, 20),
		Position = UDim2.new(0, 70, 1, -24),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "Ask AI",
		TextSize = 10,
	}).MouseButton1Click:Connect(function()
		if not handleQuery then
			return
		end
		inputBox.Text = "What is this remote for, and is it how the client asks the server to change speed/stats/movement?\n"
			.. entry.ClassName
			.. ": "
			.. entry.Path
			.. (entry.LastLog and ("\nLast client event: " .. entry.LastLog) or "")
			.. (entry.LastOut and ("\nLast FireServer: " .. entry.LastOut) or "")
		handleQuery()
	end)

	makeButton({
		Parent = row,
		Size = UDim2.new(0, 40, 0, 20),
		Position = UDim2.new(0, 132, 1, -24),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "Copy",
		TextSize = 10,
	}).MouseButton1Click:Connect(function()
		copyPath(entry.Path)
	end)
end

local function fillPage(page)
	if not page then
		return
	end
	page.Size = UDim2.new(1, 0, 1, 0)
	page.Position = UDim2.new(0, 0, 0, 0)
end

local function pageForTab(tabName)
	if tabName == "Dashboard" then
		return dashboardPage
	elseif tabName == "Chat" then
		return chatFrame
	elseif tabName == "Values" or tabName == "Humanoid" then
		return explorerPanel
	elseif tabName == "Remotes" then
		return remotesShell
	elseif tabName == "Explorer" then
		return explorerPage
	elseif tabName == "Anti" then
		return antiPanel
	elseif tabName == "Settings" then
		return settingsFrame
	end
	return nil
end

switchMainTab = function(tabName)
	cancelHotkeyWait()
	if tabName == "Humanoid" then
		tabName = "Dashboard"
	end
	local prevTab = activeMainTab
	activeMainTab = tabName
	if isAuthenticated and tabName ~= "Settings" then
		CONFIG.LAST_TAB = tabName
		savePrefs()
	end
	if tabName == "Values" or tabName == "Remotes" or tabName == "Anti" then
		activeExplorerTab = tabName
	end
	local pages = { dashboardPage, chatFrame, explorerPanel, explorerPage, remotesShell, antiPanel, settingsFrame }
	for _, page in ipairs(pages) do
		if page then
			page.Visible = false
		end
	end
	local shown = pageForTab(tabName)
	if shown then
		fillPage(shown)
		shown.Visible = true
		slideReveal(shown)
		if prevTab ~= tabName and mainFrame and mainFrame.Visible then
			playThemeSound("tab")
		end
	end
	if valueSearchBox then
		valueSearchBox.Visible = tabName == "Values"
	end
	if valueFilterLabel then
		valueFilterLabel.Visible = tabName == "Values"
	end
	if valueFilterRow then
		valueFilterRow.Visible = tabName == "Values"
	end
	if explorerSearchBox then
		explorerSearchBox.Visible = tabName == "Explorer"
	end
	if tabName == "Explorer" and rebuildExplorerTree then
		rebuildExplorerTree()
	end
	if tabName == "Remotes" then
		setRemotesView(remotesView)
	end
	if tabName == "Settings" and settingsKeyInput then
		settingsKeyInput.Text = apiKey
	end
	for name, btn in pairs(mainTabButtons) do
		btn.BackgroundTransparency = 1
		btn.TextColor3 = name == tabName and CONFIG.THEME.TEXT or CONFIG.THEME.TEXT_DIM
		btn.Font = name == tabName and Enum.Font.GothamMedium or Enum.Font.Gotham
	end
	local activeBtn = mainTabButtons[tabName]
	if tabUnderline and activeBtn then
		tween(tabUnderline, TWEEN_SLIDE, {
			Position = UDim2.new(0, activeBtn.Position.X.Offset, 1, -2),
			Size = UDim2.new(0, (activeBtn.AbsoluteSize.X > 0 and activeBtn.AbsoluteSize.X or activeBtn.Size.X.Offset), 0, 2),
		})
	end
	if tabName == "Dashboard" and refreshDashboard then
		refreshDashboard()
	end
end

local function switchExplorerTab(tabName)
	local mapped = tabName
	if tabName == "Humanoid" then
		mapped = "Dashboard"
	end
	switchMainTab(mapped)
end

rebuildValueExplorer = function()
	for _, child in ipairs(valueScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	historySummaryLabel = nil

	local historyCard = Instance.new("Frame")
	historyCard.AutomaticSize = Enum.AutomaticSize.Y
	historyCard.Size = UDim2.new(1, -4, 0, 40)
	historyCard.BackgroundColor3 = CONFIG.THEME.SECONDARY
	historyCard.BorderSizePixel = 0
	historyCard.LayoutOrder = 0
	historyCard.Parent = valueScroll
	addCorner(historyCard, 8)
	addStroke(historyCard, 1, 0.62)
	historySummaryLabel = makeLabel({
		Parent = historyCard,
		Size = UDim2.new(1, -12, 0, 72),
		Position = UDim2.new(0, 6, 0, 4),
		Text = historyText(),
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})

	local search = string.lower(valueSearchBox.Text or "")
	local count = 0

	for _, entry in ipairs(valueRegistry) do
		if count >= CONFIG.MAX_VALUE_ROWS then
			break
		end

		local include = false
		if valueFilterMode == "All" then
			include = true
		elseif valueFilterMode == "Star" then
			include = starredPaths[entry.Path] == true
		elseif valueFilterMode == "Character" then
			include = entry.Scope == "Character" or entry.Scope == "Player"
		elseif valueFilterMode == "Player" then
			include = entry.Scope == "Player"
		end

		if include and search ~= "" then
			local blob = string.lower(entry.Name .. " " .. entry.Path)
			include = string.find(blob, search, 1, true) ~= nil
		end

		if include then
			count = count + 1
			createValueRow(valueScroll, count + 1, entry)
		end
	end

	local layout = valueScroll:FindFirstChildOfClass("UIListLayout")
	if layout then
		valueScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end

	valueFilterLabel.Text = string.format("Showing %d values (%s)", count, valueFilterMode)
	if recentStatDeltas[1] then
		local d = recentStatDeltas[1]
		valueFilterLabel.Text = valueFilterLabel.Text
			.. "  Last: "
			.. tostring(d.Name)
			.. " "
			.. tostring(d.From)
			.. "→"
			.. tostring(d.To)
	end
end

rebuildAntiPanel = function()
	for _, child in ipairs(antiPanel:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local modFrame = Instance.new("Frame")
	modFrame.Size = UDim2.new(1, -4, 0, 72)
	modFrame.BackgroundColor3 = CONFIG.THEME.SECONDARY
	modFrame.BorderSizePixel = 0
	modFrame.LayoutOrder = 0
	modFrame.Parent = antiPanel
	addCorner(modFrame, 8)
	addStroke(modFrame, 1, 0.62)

	local modText = "Loaded modules: "
	if #loadedModuleNames == 0 then
		modText = modText .. "none (getloadedmodules not available)"
	else
		local names = {}
		for i = 1, math.min(#loadedModuleNames, 10) do
			table.insert(names, loadedModuleNames[i])
		end
		modText = modText .. table.concat(names, " | ")
	end
	makeLabel({
		Parent = modFrame,
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.new(0, 8, 0, 4),
		Text = modText,
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 11,
	})

	for i, entry in ipairs(antiScriptRegistry) do
		createAntiScriptRow(antiPanel, i + 1, entry)
	end
	local layout = antiPanel:FindFirstChildOfClass("UIListLayout")
	if layout then
		antiPanel.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end
end

local function sortedRemoteEntries()
	local list = {}
	for _, entry in ipairs(remoteRegistry) do
		table.insert(list, entry)
	end
	table.sort(list, function(a, b)
		local as = starredPaths[a.Path] and 1 or 0
		local bs = starredPaths[b.Path] and 1 or 0
		if as ~= bs then
			return as > bs
		end
		local ah = a.Hits or 0
		local bh = b.Hits or 0
		if ah ~= bh then
			return ah > bh
		end
		return (a.Name or "") < (b.Name or "")
	end)
	return list
end

refreshRemoteSort = function()
	local shown = 0
	for _, entry in ipairs(sortedRemoteEntries()) do
		shown = shown + 1
		if entry.Row then
			entry.Row.LayoutOrder = shown
		end
	end
end

rebuildRemotePanel = function()
	if not remotesKnown then
		return
	end
	for _, child in ipairs(remotesKnown:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local shown = 0
	for _, entry in ipairs(sortedRemoteEntries()) do
		shown = shown + 1
		if shown > 50 then
			break
		end
		createRemoteRow(remotesKnown, shown, entry)
	end
	local layout = remotesKnown:FindFirstChildOfClass("UIListLayout")
	if layout then
		remotesKnown.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end
	if spyEnabled then
		startIncomingSpy()
	end
end

refreshHumanoidPanel = function()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight" }) do
		local label = dashMoveLabels[prop]
		if label then
			label.Text = hum and tostring(hum[prop]) or "—"
		end
	end
end

local function layoutPanels(animate)
	if not sidebarFrame or not contentHost or not topBar then
		return
	end
	if isMinimized then
		return
	end
	local motion = animate and TWEEN_SLIDE or nil
	local function place(inst, props)
		if motion then
			tween(inst, motion, props)
		else
			for key, value in pairs(props) do
				inst[key] = value
			end
		end
	end
	local sideW = toolsMinimized and 36 or CONFIG.SIDEBAR_WIDTH
	place(sidebarFrame, {
		Size = UDim2.new(0, sideW, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
	})
	place(topBar, {
		Size = UDim2.new(1, -sideW, 0, 48),
		Position = UDim2.new(0, sideW, 0, 0),
	})
	place(contentHost, {
		Size = UDim2.new(1, -(sideW + 8), 1, -56),
		Position = UDim2.new(0, sideW + 8, 0, 48),
	})
	if toolsBody then
		toolsBody.Visible = not toolsMinimized
	end
	if toolsTitle then
		toolsTitle.Visible = not toolsMinimized
	end
	if toolsFoldBtn then
		toolsFoldBtn.Text = toolsMinimized and ">" or "<"
		place(toolsFoldBtn, {
			Position = toolsMinimized and UDim2.new(0, 6, 0, 10) or UDim2.new(1, -28, 0, 10),
		})
	end
end

local function copyBrief()
	if not gameData.structure then
		scanGameStructure()
	end
	lastBrief = buildGameBrief()
	local clip = safeGlobal("setclipboard") or safeGlobal("toclipboard")
	if type(clip) == "function" then
		pcall(clip, lastBrief)
		addMessage("Copied brief (" .. #lastBrief .. " chars).", false)
	else
		addMessage("No clipboard. Brief starts:", false)
		addMessage(truncateText(lastBrief, 400), false)
	end
end

local function runProbe()
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hum then
		local msg = "Probe: no Humanoid yet."
		lastProbeResult = msg
		if probeStatusLabel then
			probeStatusLabel.Text = msg
		end
		addMessage(msg, false)
		return
	end

	local lines = {
		string.format(
			"Read-only: WalkSpeed=%s JumpPower=%s JumpHeight=%s. Nothing was written.",
			tostring(hum.WalkSpeed),
			tostring(hum.JumpPower),
			tostring(hum.JumpHeight)
		),
	}
	local anyWriters = false
	for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight" }) do
		local writers = findWriters(hum:GetPropertyChangedSignal(prop))
		if writers then
			anyWriters = true
			table.insert(lines, prop .. " listeners: " .. writers)
		end
	end
	if not anyWriters then
		local mentions = scriptsMentioningMovement(5)
		if #mentions > 0 then
			local names = {}
			for _, item in ipairs(mentions) do
				table.insert(names, item.Name .. " (" .. (item.Why or "strings") .. ")")
			end
			table.insert(lines, "Scripts mentioning movement: " .. table.concat(names, "; "))
		else
			table.insert(lines, "No WalkSpeed listeners and no dumped movement strings.")
		end
	end
	local moveRemotes = listKeywordRemotes(MOVEMENT_KEYWORDS, 5)
	if #moveRemotes > 0 then
		table.insert(lines, "Movement-named remotes: " .. table.concat(moveRemotes, ", "))
	end
	if spyEnabled and lastOutgoingLogs[1] then
		table.insert(lines, "Last captured FireServer: " .. lastOutgoingLogs[1])
	elseif spyEnabled then
		if spyInstalled then
			table.insert(lines, "Spy is on, no FireServer captured yet.")
		else
			table.insert(lines, "Listening to incoming remotes only (no FireServer hook on this executor).")
		end
	else
		table.insert(lines, "Spy is off (Probe does not turn it on).")
	end
	local msg = table.concat(lines, " ")
	lastProbeResult = msg
	if probeStatusLabel then
		probeStatusLabel.Text = msg
	end
	addMessage("Probe: " .. msg, false)
	lastBrief = ""
end

local function formatUptime()
	if not sessionStarted then
		return "00:00:00"
	end
	local sec = math.max(0, math.floor(tick() - sessionStarted))
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function barWidth(count, cap)
	cap = cap or 16
	if cap <= 0 then
		return 0.04
	end
	local n = count / cap
	if n < 0.04 then
		return 0.04
	end
	if n > 1 then
		return 1
	end
	return n
end

local function reuseListLabels(parent, store, items, height, textSize)
	if not parent then
		return
	end
	height = height or 22
	textSize = textSize or 12
	for i, item in ipairs(items) do
		local label = store[i]
		if not label or not label.Parent then
			label = makeLabel({
				Parent = parent,
				Size = UDim2.new(1, -8, 0, height),
				LayoutOrder = i,
				Text = "",
				TextSize = textSize,
			})
			store[i] = label
		end
		label.Text = item.Text
		label.TextColor3 = item.Color or CONFIG.THEME.TEXT
		label.Visible = true
	end
	for i = #items + 1, #store do
		if store[i] then
			store[i].Visible = false
		end
	end
end

refreshDashboard = function()
	if activeMainTab and activeMainTab ~= "Dashboard" then
		return
	end
	local s = gameData.structure
	local scriptCount = s and (#(s.Scripts or {}) + #(s.ModuleScripts or {})) or 0
	local remoteCount = s and #(s.Remotes or {}) or #remoteRegistry
	local valueCount = s and #(s.Values or {}) or #valueRegistry
	if valueCount == 0 then
		valueCount = #valueRegistry
	end
	local captureCount = #captureLog
	local antiCount = s and #(s.AntiCheatScripts or {}) or #antiScriptRegistry
	local moveCount = s and #(s.MovementRelated or {}) or 0
	local itemCount = s and #(s.ItemRelated or {}) or 0

	local function setStat(key, n)
		local label = dashStatLabels[key]
		if label then
			label.Text = tostring(n)
		end
	end
	setStat("Scripts", scriptCount)
	setStat("Remotes", remoteCount)
	setStat("Values", valueCount)
	setStat("Captures", captureCount)

	if gameNameLabel then
		gameNameLabel.Text = "Game: " .. (s and tostring(s.GameName) or game.Name)
	end
	if placeIdLabel then
		placeIdLabel.Text = "Place ID: " .. tostring(game.PlaceId)
	end
	if apiStatusLabel then
		apiStatusLabel.Text = isAuthenticated and "API Connected" or "API locked"
		apiStatusLabel.TextColor3 = isAuthenticated and CONFIG.THEME.SUCCESS or CONFIG.THEME.WARNING
	end

	local topics = {
		{ Key = "Movement", Count = moveCount, Cap = 14 },
		{ Key = "Anti-Cheat", Count = antiCount, Cap = 10 },
		{ Key = "Items", Count = itemCount, Cap = 12 },
		{ Key = "Values", Count = valueCount, Cap = 40 },
		{ Key = "Remotes", Count = remoteCount, Cap = 30 },
	}
	for _, topic in ipairs(topics) do
		local row = dashTopicBars[topic.Key]
		if row then
			if row.Count then
				row.Count.Text = tostring(topic.Count) .. " hits"
			end
			if row.Fill then
				local w = barWidth(topic.Count, topic.Cap)
				if math.abs(row.Fill.Size.X.Scale - w) > 0.012 then
					tween(row.Fill, TWEEN_SLIDE, { Size = UDim2.new(w, 0, 1, 0) })
				end
			end
		end
	end

	if dashScanList then
		reuseListLabels(dashScanList, dashScanLabels, {
			{ Text = "Scripts / modules  —  " .. scriptCount .. " found" },
			{ Text = "Remotes  —  " .. remoteCount .. " found" },
			{ Text = "Values & attributes  —  " .. valueCount .. " found" },
			{ Text = "Anti suspects  —  " .. antiCount .. " name/listener matches" },
			{ Text = "Movement-related  —  " .. moveCount .. " hits" },
			{ Text = "Item-related  —  " .. itemCount .. " hits" },
		}, 22, 12)
	end

	if dashCaptureList then
		local capItems = {}
		if #captureLog == 0 then
			capItems[1] = {
				Text = "No captures yet. Turn Spy on from the sidebar, do something in-game, then come back.",
				Color = CONFIG.THEME.TEXT_DIM,
			}
		else
			for i = 1, math.min(6, #captureLog) do
				local cap = captureLog[i]
				capItems[i] = {
					Text = (cap.Time or "") .. "  " .. cap.Method .. "  " .. cap.Name,
				}
			end
		end
		reuseListLabels(dashCaptureList, dashCaptureLabels, capItems, #captureLog == 0 and 36 or 20, 12)
	end

	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight" }) do
		local label = dashMoveLabels[prop]
		if label then
			label.Text = hum and tostring(hum[prop]) or "—"
		end
	end
end

