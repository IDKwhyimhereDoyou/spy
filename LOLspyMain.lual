		TextSize = 11,
		Tip = {
			does = "Asks Chat what this instance is for.",
			risk = "Quiet unless AI tools are ON.",
		},
	}).MouseButton1Click:Connect(function()
		if typeof(explorerSelected) ~= "Instance" then
			addMessage("Select something in Explorer first.", false)
			return
		end
		if not handleQuery or not inputBox then
			return
		end
		inputBox.Text = "What is this instance for in this game? Class "
			.. explorerSelected.ClassName
			.. ", path "
			.. explorerSelected:GetFullName()
			.. ". Explain the client flow. Do not invent FireServer args."
		handleQuery()
	end)

	local searchQueued = false
	explorerSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if searchQueued then
			return
		end
		searchQueued = true
		task.delay(0.14, function()
			searchQueued = false
			rebuildExplorerTree()
		end)
	end)
end

local function createExplorerPanel()
	explorerPanel = Instance.new("Frame")
