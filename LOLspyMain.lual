	local valueFilterTips = {
		Character = { does = "Player + character values/attributes.", risk = "Quiet." },
		Player = { does = "Values on the player only.", risk = "Quiet." },
		All = { does = "Every scanned value.", risk = "Quiet." },
		Star = { does = "Only starred values.", risk = "Quiet." },
	}
	for _, mode in ipairs({ "Character", "Player", "All", "Star" }) do
		makeButton({
			Parent = filterRow,
			Size = UDim2.new(0, 72, 0, 22),
			BackgroundColor3 = CONFIG.THEME.SECONDARY,
			Text = mode,
			TextSize = 10,
			Tip = valueFilterTips[mode],
		}).MouseButton1Click:Connect(function()
			valueFilterMode = mode
			rebuildValueExplorer()
		end)
	end

	valueScroll = Instance.new("ScrollingFrame")
	valueScroll.Name = "ValueScroll"
	valueScroll.Size = UDim2.new(1, -8, 1, -114)
	valueScroll.Position = UDim2.new(0, 4, 0, 108)
	valueScroll.BackgroundTransparency = 1
	valueScroll.BorderSizePixel = 0
	valueScroll.ScrollBarThickness = 4
	valueScroll.ScrollBarImageTransparency = 0.35
	valueScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	valueScroll.Parent = explorerPanel

	local valueLayout = Instance.new("UIListLayout")
	valueLayout.Padding = UDim.new(0, 4)
	valueLayout.SortOrder = Enum.SortOrder.LayoutOrder
	valueLayout.Parent = valueScroll

	remotesShell = Instance.new("Frame")
	remotesShell.Name = "RemotesShell"
	remotesShell.Size = UDim2.new(1, 0, 1, 0)
	remotesShell.Position = UDim2.new(0, 0, 0, 0)
	remotesShell.BackgroundTransparency = 1
	remotesShell.Visible = false
	remotesShell.Parent = contentHost

	local remotesHeader = Instance.new("Frame")
	remotesHeader.Size = UDim2.new(1, -8, 0, 26)
	remotesHeader.Position = UDim2.new(0, 4, 0, 0)
	remotesHeader.BackgroundTransparency = 1
	remotesHeader.Parent = remotesShell

	remotesSpyButton = makeButton({
		Parent = remotesHeader,
		Size = UDim2.new(0, 72, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = spyEnabled and CONFIG.THEME.WARNING or CONFIG.THEME.PRIMARY,
		Text = spyEnabled and "Spy ON" or "Spy",
		TextSize = 11,
		Tip = {
			does = "Captures FireServer if this executor can hook it. Otherwise listens to incoming OnClientEvent.",
			risk = "Loud if hooks exist. Incoming listen is quieter.",
		},
	})
	remotesSpyButton.MouseButton1Click:Connect(function()
		if spyEnabled then
			setSpyEnabled(false, "Spy paused.")
			return
		end
		setSpyEnabled(true, "Spy on. Buy, pickup, or equip something, then read Captures.")
	end)

	remotesCapturesBtn = makeButton({
		Parent = remotesHeader,
		Size = UDim2.new(0, 70, 1, 0),
		Position = UDim2.new(0, 76, 0, 0),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "Captures",
		TextSize = 11,
		Tip = {
			does = "Logged remotes: pairs, ids, hot counts, stats deltas.",
			risk = "Quiet — viewing logs only.",
		},
	})
	remotesCapturesBtn.MouseButton1Click:Connect(function()
		setRemotesView("Captures")
	end)

	remotesKnownBtn = makeButton({
		Parent = remotesHeader,
		Size = UDim2.new(0, 56, 1, 0),
		Position = UDim2.new(0, 150, 0, 0),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "Known",
		TextSize = 11,
		Tip = {
			does = "Remotes found in the scan, with how often they fired.",
			risk = "Quiet — a list.",
		},
	})
	remotesKnownBtn.MouseButton1Click:Connect(function()
		setRemotesView("Known")
	end)

	makeButton({
		Parent = remotesHeader,
		Size = UDim2.new(0, 48, 1, 0),
		Position = UDim2.new(1, -96, 0, 0),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "Dump",
		TextSize = 11,
		Tip = {
			does = "Pulls searchable strings from client scripts (constants/env). Uses decompile if this executor has it.",
			risk = "Quiet-medium — reading script constants. Use once per session.",
		},
	}).MouseButton1Click:Connect(function()
		indexSources(remotesSearchBox and remotesSearchBox.Text or "")
	end)

	makeButton({
		Parent = remotesHeader,
		Size = UDim2.new(0, 44, 1, 0),
		Position = UDim2.new(1, -44, 0, 0),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "UI",
		TextSize = 11,
		Tip = {
			does = "Scans PlayerGui for remotes/values (skips this window).",
			risk = "Quiet-medium — a one-shot walk of your GUI.",
		},
	}).MouseButton1Click:Connect(function()
		task.spawn(function()
			local result = scanPlayerGui()
			if result and addMessage then
				addMessage(result, false)
			end
		end)
	end)

	remotesSearchBox = Instance.new("TextBox")
	remotesSearchBox.Size = UDim2.new(1, -120, 0, 24)
	remotesSearchBox.Position = UDim2.new(0, 4, 0, 30)
	remotesSearchBox.BackgroundColor3 = CONFIG.THEME.SECONDARY
	remotesSearchBox.BorderSizePixel = 0
	remotesSearchBox.Font = Enum.Font.Gotham
	remotesSearchBox.PlaceholderText = "Search captures, ids, source..."
	remotesSearchBox.PlaceholderColor3 = CONFIG.THEME.TEXT_DIM
	remotesSearchBox.Text = ""
	remotesSearchBox.TextColor3 = CONFIG.THEME.TEXT
	remotesSearchBox.TextSize = 12
	remotesSearchBox.ClearTextOnFocus = false
	remotesSearchBox.Parent = remotesShell
	addCorner(remotesSearchBox, 8)
	bindFocusStroke(remotesSearchBox)
	local captureFilterTips = {
		All = { does = "Show every capture.", risk = "Quiet." },
		Out = { does = "Only FireServer / InvokeServer.", risk = "Quiet." },
		In = { does = "Only OnClientEvent (server → you).", risk = "Quiet." },
	}
	local filterModes = { "All", "Out", "In" }
	for i, mode in ipairs(filterModes) do
		local btn = makeButton({
			Parent = remotesShell,
			Size = UDim2.new(0, 34, 0, 24),
			Position = UDim2.new(1, -112 + (i - 1) * 36, 0, 30),
			BackgroundColor3 = mode == captureMethodFilter and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY,
			Text = mode,
			TextSize = 10,
			Tip = captureFilterTips[mode],
		})
		remotesFilterBtns[mode] = btn
		btn.MouseButton1Click:Connect(function()
			setCaptureMethodFilter(mode)
		end)
	end
	remotesSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		lastSourceHits = {}
		if remotesView ~= "Captures" then
			return
		end
		if searchRebuildQueued then
			return
		end
		searchRebuildQueued = true
		task.delay(0.12, function()
			searchRebuildQueued = false
			rebuildCaptureList()
		end)
	end)
	remotesSearchBox.FocusLost:Connect(function(enter)
		if enter and remotesSearchBox.Text ~= "" then
			runSourceSearch(remotesSearchBox.Text)
		end
	end)

	remotesHint = makeLabel({
		Parent = remotesShell,
		Size = UDim2.new(1, -8, 0, 32),
		Position = UDim2.new(0, 4, 0, 56),
		Text = "Hover buttons for what they do. Spy is loud. Diff / pair / hot counts are quiet.",
		TextColor3 = CONFIG.THEME.TEXT_DIM,
		TextSize = 10,
	})
	indexStatusLabel = remotesHint

	remotesCaptures = Instance.new("ScrollingFrame")
	remotesCaptures.Name = "Captures"
	remotesCaptures.Size = UDim2.new(1, -4, 1, -92)
	remotesCaptures.Position = UDim2.new(0, 2, 0, 90)
	remotesCaptures.BackgroundTransparency = 1
	remotesCaptures.BorderSizePixel = 0
	remotesCaptures.ScrollBarThickness = 6
	remotesCaptures.CanvasSize = UDim2.new(0, 0, 0, 0)
	remotesCaptures.AutomaticCanvasSize = Enum.AutomaticSize.Y
	remotesCaptures.Parent = remotesShell

	local captureLayout = Instance.new("UIListLayout")
	captureLayout.Padding = UDim.new(0, 4)
	captureLayout.SortOrder = Enum.SortOrder.LayoutOrder
	captureLayout.Parent = remotesCaptures
	local capturePad = Instance.new("UIPadding")
	capturePad.PaddingBottom = UDim.new(0, 8)
	capturePad.Parent = remotesCaptures

	remotesKnown = Instance.new("ScrollingFrame")
	remotesKnown.Name = "Known"
	remotesKnown.Size = remotesCaptures.Size
	remotesKnown.Position = remotesCaptures.Position
	remotesKnown.BackgroundTransparency = 1
	remotesKnown.BorderSizePixel = 0
	remotesKnown.ScrollBarThickness = 6
	remotesKnown.Visible = false
	remotesKnown.CanvasSize = UDim2.new(0, 0, 0, 0)
	remotesKnown.Parent = remotesShell

	local knownLayout = Instance.new("UIListLayout")
	knownLayout.Padding = UDim.new(0, 4)
	knownLayout.SortOrder = Enum.SortOrder.LayoutOrder
	knownLayout.Parent = remotesKnown

	remotesPanel = remotesKnown

	antiPanel = Instance.new("ScrollingFrame")
	antiPanel.Name = "AntiPanel"
	antiPanel.Size = UDim2.new(1, 0, 1, 0)
	antiPanel.Position = UDim2.new(0, 0, 0, 0)
	antiPanel.BackgroundTransparency = 1
	antiPanel.BorderSizePixel = 0
	antiPanel.ScrollBarThickness = 6
	antiPanel.Visible = false
	antiPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
	antiPanel.Parent = contentHost

	local antiLayout = Instance.new("UIListLayout")
	antiLayout.Padding = UDim.new(0, 4)
	antiLayout.SortOrder = Enum.SortOrder.LayoutOrder
	antiLayout.Parent = antiPanel

	valueSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if valueRebuildQueued then
			return
		end
		valueRebuildQueued = true
		task.delay(0.12, function()
			valueRebuildQueued = false
			rebuildValueExplorer()
		end)
	end)
end

local function createMainUI()
	mainFrame = Instance.new("Frame")
	mainFrame.Size = CONFIG.WINDOW_SIZE
	mainFrame.Position = CONFIG.WINDOW_POSITION
	mainFrame.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	mainFrame.BorderSizePixel = 0
	mainFrame.Visible = false
	mainFrame.ClipsDescendants = true
	mainFrame.Parent = screenGui
	addCorner(mainFrame, 12)
	addStroke(mainFrame, 1, 0.32)

	overlayDim = Instance.new("TextButton")
	overlayDim.Name = "OverlayDim"
	overlayDim.Size = UDim2.fromScale(1, 1)
	overlayDim.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlayDim.BackgroundTransparency = 1
	overlayDim.BorderSizePixel = 0
	overlayDim.Text = ""
	overlayDim.AutoButtonColor = false
	overlayDim.Visible = false
	overlayDim.ZIndex = 14
	overlayDim.Parent = screenGui
	overlayDim.MouseButton1Click:Connect(function()
		if helpFrame and helpFrame.Visible then
			hideModal(helpFrame, 440, 340)
		end
	end)

	createSidebar()

	contentHost = Instance.new("Frame")
	contentHost.Name = "ContentHost"
	contentHost.BackgroundTransparency = 1
	contentHost.ClipsDescendants = true
	contentHost.Parent = mainFrame

	topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, -CONFIG.SIDEBAR_WIDTH, 0, 48)
	topBar.Position = UDim2.new(0, CONFIG.SIDEBAR_WIDTH, 0, 0)
	topBar.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	topBar.BorderSizePixel = 0
	topBar.Parent = mainFrame

	local tabSpecs = {
		{ Name = "Dashboard", Width = 92, Tip = { does = "Scan stats, topics, recent remotes.", risk = "Quiet — numbers only." } },
		{ Name = "Chat", Width = 56, Tip = { does = "Ask the model about this game.", risk = "Quiet unless AI tools are ON." } },
		{ Name = "Values", Width = 62, Tip = { does = "Live values. Set is one write to test ownership.", risk = "Viewing is quiet. Set is medium." } },
		{ Name = "Explorer", Width = 78, Tip = { does = "Studio-style tree of the live game. Search names, expand folders, copy paths.", risk = "Quiet — reading instances only." } },
		{ Name = "Remotes", Width = 78, Tip = { does = "Captures, Dump, Scan UI.", risk = "Viewing is quiet. Spy is loud if hooks exist." } },
		{ Name = "Anti", Width = 48, Tip = { does = "Name-match, listeners, or dumped movement strings.", risk = "Quiet — listing, not disabling." } },
		{ Name = "Settings", Width = 72, Tip = { does = "General settings and a Hotkeys tab to rebind keys.", risk = "Quiet." } },
	}
	local tabX = 10
	for _, spec in ipairs(tabSpecs) do
		local w = spec.Width or 88
		local btn = makeButton({
			Parent = topBar,
			Name = spec.Name,
			Size = UDim2.new(0, w, 0, 28),
			Position = UDim2.new(0, tabX, 0, 10),
			BackgroundColor3 = CONFIG.THEME.BACKGROUND,
			BackgroundTransparency = 1,
			Text = spec.Name,
			TextSize = 13,
			Tip = spec.Tip,
		})
		btn.BackgroundTransparency = 1
		mainTabButtons[spec.Name] = btn
		btn.MouseButton1Click:Connect(function()
			switchMainTab(spec.Name)
		end)
		tabX = tabX + w + 6
	end
	tabUnderline = Instance.new("Frame")
	tabUnderline.Name = "TabUnderline"
	tabUnderline.Size = UDim2.new(0, 92, 0, 2)
	tabUnderline.Position = UDim2.new(0, 10, 1, -2)
	tabUnderline.BackgroundColor3 = CONFIG.THEME.PRIMARY
	tabUnderline.BorderSizePixel = 0
	tabUnderline.Parent = topBar

	settingsButton = makeButton({
		Parent = topBar,
		Size = UDim2.new(0, 30, 0, 30),
		Position = UDim2.new(1, -158, 0, 9),
		BackgroundColor3 = CONFIG.THEME.ACCENT,
		Text = "⚙",
		TextSize = 16,
		Tip = {
			does = "Opens the Settings tab.",
			risk = "Quiet.",
		},
	})

	makeButton({
		Parent = topBar,
		Size = UDim2.new(0, 30, 0, 30),
		Position = UDim2.new(1, -124, 0, 9),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "?",
		TextSize = 16,
		Tip = {
			does = "Short how-to. Hover other buttons for detectability.",
			risk = "Quiet.",
		},
	}).MouseButton1Click:Connect(function()
		if helpFrame.Visible then
			hideModal(helpFrame, 440, 340)
		else
			showModal(helpFrame, 440, 340)
		end
	end)

	minimizeButton = makeButton({
		Parent = topBar,
		Size = UDim2.new(0, 36, 0, 30),
		Position = UDim2.new(1, -86, 0, 9),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "—",
		TextSize = 18,
	})

	closeButton = makeButton({
		Parent = topBar,
		Size = UDim2.new(0, 36, 0, 30),
		Position = UDim2.new(1, -46, 0, 9),
		BackgroundColor3 = CONFIG.THEME.ERROR,
		Text = "×",
		TextSize = 18,
	})

	titleBar = makeLabel({
		Parent = topBar,
		Size = UDim2.new(0, 1, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		Text = "",
		TextTransparency = 1,
	})

	chatFrame = Instance.new("Frame")
	chatFrame.Size = UDim2.new(1, 0, 1, 0)
	chatFrame.Position = UDim2.new(0, 0, 0, 0)
	chatFrame.BackgroundTransparency = 1
	chatFrame.Visible = false
	chatFrame.Parent = contentHost

	messageContainer = Instance.new("ScrollingFrame")
	messageContainer.Size = UDim2.new(1, 0, 1, -48)
	messageContainer.BackgroundTransparency = 1
	messageContainer.BorderSizePixel = 0
	messageContainer.ScrollBarThickness = 4
	messageContainer.ScrollBarImageTransparency = 0.35
	messageContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y
	messageContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
	messageContainer.Parent = chatFrame

	messageLayout = Instance.new("UIListLayout")
	messageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	messageLayout.Padding = UDim.new(0, 6)
	messageLayout.Parent = messageContainer

	inputFrame = Instance.new("Frame")
	inputFrame.Size = UDim2.new(1, 0, 0, 40)
	inputFrame.Position = UDim2.new(0, 0, 1, -40)
	inputFrame.BackgroundColor3 = CONFIG.THEME.SECONDARY
	inputFrame.Parent = chatFrame
	addCorner(inputFrame, 10)
	addStroke(inputFrame, 1, 0.5)

	inputBox = Instance.new("TextBox")
	inputBox.Size = UDim2.new(1, -50, 1, 0)
	inputBox.Position = UDim2.new(0, 8, 0, 0)
	inputBox.BackgroundTransparency = 1
	inputBox.BorderSizePixel = 0
	inputBox.Font = Enum.Font.Gotham
	inputBox.PlaceholderText = "Ask how something works — money, a button, a remote…"
	inputBox.PlaceholderColor3 = CONFIG.THEME.TEXT_DIM
	inputBox.TextColor3 = CONFIG.THEME.TEXT
	inputBox.TextSize = 13
	inputBox.ClearTextOnFocus = false
	inputBox.Parent = inputFrame

	sendButton = makeButton({
		Parent = inputFrame,
		Size = UDim2.new(0, 40, 0, 30),
		Position = UDim2.new(1, -45, 0, 5),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "→",
		TextSize = 18,
	})

	createExplorerPanel()
	createStudioExplorer()
	createDashboard()
	layoutPanels()
	switchMainTab("Dashboard")

	settingsFrame = Instance.new("Frame")
	settingsFrame.Size = UDim2.new(0, 420, 0, 360)
	settingsFrame.Position = UDim2.new(0.5, -210, 0.5, -180)
	settingsFrame.BackgroundColor3 = CONFIG.THEME.BACKGROUND
	settingsFrame.Visible = false
	settingsFrame.ZIndex = 2
	settingsFrame.BorderSizePixel = 0
	settingsFrame.Parent = contentHost
	fillPage(settingsFrame)
	addCorner(settingsFrame, 12)
	addStroke(settingsFrame, 1, 0.35)

	makeLabel({
		Parent = settingsFrame,
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.new(0, 10, 0, 8),
		Text = "Settings",
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
	})

	local settingsTabBtns = {}
	local settingsGeneral
	local settingsHotkeys
	local function switchSettingsTab(name)
		cancelHotkeyWait()
		if settingsGeneral then
			settingsGeneral.Visible = name == "General"
		end
		if settingsHotkeys then
			settingsHotkeys.Visible = name == "Hotkeys"
		end
		for tabName, btn in pairs(settingsTabBtns) do
			btn.BackgroundColor3 = tabName == name and CONFIG.THEME.PRIMARY or CONFIG.THEME.SECONDARY
		end
		playThemeSound("tab")
	end

	settingsTabBtns.General = makeButton({
		Parent = settingsFrame,
		Size = UDim2.new(0, 100, 0, 26),
		Position = UDim2.new(0, 10, 0, 36),
		BackgroundColor3 = CONFIG.THEME.PRIMARY,
		Text = "General",
		TextSize = 12,
		Tip = {
			does = "API key, remember, theme, sounds, scale.",
			risk = "Quiet.",
		},
	})
	settingsTabBtns.General.MouseButton1Click:Connect(function()
		switchSettingsTab("General")
	end)

	settingsTabBtns.Hotkeys = makeButton({
		Parent = settingsFrame,
		Size = UDim2.new(0, 100, 0, 26),
		Position = UDim2.new(0, 116, 0, 36),
		BackgroundColor3 = CONFIG.THEME.SECONDARY,
		Text = "Hotkeys",
		TextSize = 12,
		Tip = {
			does = "Change the key for each action. Click a bind, then press a key.",
			risk = "Quiet — local binds only.",
		},
	})
	settingsTabBtns.Hotkeys.MouseButton1Click:Connect(function()
		switchSettingsTab("Hotkeys")
	end)

	makeButton({
		Parent = settingsFrame,
		Name = "CloseSettingsButton",
		Size = UDim2.new(0, 100, 0, 32),
		Position = UDim2.new(1, -110, 1, -42),
		BackgroundColor3 = CONFIG.THEME.ERROR,
		Text = "Close",
	})

	settingsGeneral = Instance.new("ScrollingFrame")
	settingsGeneral.Name = "GeneralPage"
	settingsGeneral.Size = UDim2.new(1, -16, 1, -118)
	settingsGeneral.Position = UDim2.new(0, 8, 0, 70)
	settingsGeneral.BackgroundTransparency = 1
	settingsGeneral.BorderSizePixel = 0
	settingsGeneral.ScrollBarThickness = 5
	settingsGeneral.CanvasSize = UDim2.new(0, 0, 0, 580)
	settingsGeneral.Visible = true
	settingsGeneral.Parent = settingsFrame
	local generalPad = Instance.new("UIPadding")
	generalPad.PaddingBottom = UDim.new(0, 8)
	generalPad.Parent = settingsGeneral

	settingsHotkeys = Instance.new("ScrollingFrame")
	settingsHotkeys.Name = "HotkeysPage"
	settingsHotkeys.Size = settingsGeneral.Size
	settingsHotkeys.Position = settingsGeneral.Position
	settingsHotkeys.BackgroundTransparency = 1
	settingsHotkeys.BorderSizePixel = 0
	settingsHotkeys.ScrollBarThickness = 5
	settingsHotkeys.CanvasSize = UDim2.new(0, 0, 0, 420)
	settingsHotkeys.Visible = false
	settingsHotkeys.Parent = settingsFrame

