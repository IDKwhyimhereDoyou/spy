-- Built-in client clips only. Play() does not fail on a missing SoundId, so
-- rbxassetid fallbacks never ran and some themes sounded identical.
local SOUND_CLIPS = {
	button = "rbxasset://sounds/button.wav",
	switch = "rbxasset://sounds/switch.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	swoosh = "rbxasset://sounds/action_jump.mp3",
	snap = "rbxasset://sounds/action_jump_land.mp3",
	water = "rbxasset://sounds/impact_water.mp3",
}

CONFIG.THEME = THEMES.Dark

local function currentFx()
	return THEME_FX[CONFIG.THEME_NAME] or THEME_FX.Dark
end

local function motionAmount()
	local m = tonumber(CONFIG.MOTION) or 1
	if m < 0 then
		return 0
	end
	if m > 1 then
		return 1
	end
	return m
end

local function scaledHover()
	local s = currentFx().hoverScale or 1.03
	return 1 + (s - 1) * motionAmount()
end

local function scaledClick()
	local s = currentFx().clickScale or 0.97
	return 1 + (s - 1) * motionAmount()
end

local function themeLook(name)
	local fx = THEME_FX[name or CONFIG.THEME_NAME]
	return fx and fx.look
end

