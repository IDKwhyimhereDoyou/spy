-- ONE script to Execute.
-- Pastebin Private pastes cannot be fetched (no login). If Pastebin forces Private,
-- upload GameAnalysisAI.lua as a GitHub Secret Gist instead, then put the Gist URL below.
-- Page URL or raw URL both work.

local url = "https://gist.github.com/IDKwhyimhereDoyou/6fe07e2d99254bc68453ae057fc57b4e"

local UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

local function looksLikeHtml(s)
	if type(s) ~= "string" then
		return true
	end
	local t = string.gsub(s, "^%s+", "")
	t = string.sub(string.lower(t), 1, 800)
	if string.sub(t, 1, 1) == "<" then
		return true
	end
	if string.find(t, "<!doctype", 1, true) then
		return true
	end
	if string.find(t, "<html", 1, true) then
		return true
	end
	if string.find(t, "<head", 1, true) then
		return true
	end
	if string.find(t, "just a moment", 1, true) then
		return true
	end
	if string.find(t, "sign in", 1, true) and string.find(t, "pastebin", 1, true) then
		return true
	end
	return false
end

local function looksLikeLua(s)
	if type(s) ~= "string" or #s < 40 then
		return false
	end
	if looksLikeHtml(s) then
		return false
	end
	local t = string.gsub(s, "^%s+", "")
	if string.sub(t, 1, 2) == "--" then
		return true
	end
	if string.sub(t, 1, 5) == "local" then
		return true
	end
	if string.sub(t, 1, 5) == "pcall" then
		return true
	end
	if string.find(t, "Game Analysis AI", 1, true) then
		return true
	end
	return false
end

local function getRequest()
	return (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or (krnl and krnl.request)
		or request
end

local function tryGet(u)
	local req = getRequest()
	if type(req) == "function" then
		local ok, res = pcall(req, {
			Url = u,
			Method = "GET",
			Headers = {
				["User-Agent"] = UA,
				["Accept"] = "text/plain,*/*",
			},
		})
		if ok then
			if type(res) == "string" then
				return res
			end
			if type(res) == "table" then
				return res.Body or res.body
			end
		end
	end
	local ok, body = pcall(function()
		return game:HttpGet(u)
	end)
	if ok and type(body) == "string" then
		return body
	end
	ok, body = pcall(function()
		return game:HttpGet(u, true)
	end)
	if ok and type(body) == "string" then
		return body
	end
	ok, body = pcall(function()
		return game:HttpGetAsync(u)
	end)
	if ok and type(body) == "string" then
		return body
	end
	return nil
end

local function pasteIdFrom(u)
	u = tostring(u or "")
	u = string.gsub(u, "%s+", "")
	if string.find(u, "gist.", 1, true) or string.find(u, "github", 1, true) then
		return nil
	end
	return string.match(u, "pastebin%.com/raw%.php%?i=([%w]+)")
		or string.match(u, "pastebin%.com/raw/([%w]+)")
		or string.match(u, "pastebin%.com/dl/([%w]+)")
		or string.match(u, "pastebin%.com/([%w]+)")
		or string.match(u, "^([%w]+)$")
end

local function gistRawFrom(u)
	u = tostring(u or "")
	u = string.gsub(u, "%s+", "")
	u = string.gsub(u, "/%?.*$", "")
	if string.find(u, "gist.githubusercontent.com", 1, true) then
		if not string.find(u, "/raw", 1, true) then
			return u .. "/raw"
		end
		return u
	end
	local user, id = string.match(u, "gist%.github%.com/([%w%-_]+)/([%w]+)")
	if user and id then
		return "https://gist.githubusercontent.com/" .. user .. "/" .. id .. "/raw"
	end
	return nil
end

local function withCacheBust(u)
	if type(u) ~= "string" or u == "" then
		return u
	end
	if string.find(u, "?", 1, true) then
		return u
	end
	return u .. "?t=" .. tostring(os.time())
end

if string.find(tostring(url), "YOURUSER", 1, true) or string.find(tostring(url), "YOURID", 1, true) or string.find(tostring(url), "YOURGISTID", 1, true) then
	error("Pastebin Private will not load. Create a GitHub Secret Gist of GameAnalysisAI.lua, then put that Gist URL here. Example: https://gist.github.com/yourname/abc123")
end

local candidates = {}
local gistRaw = gistRawFrom(url)
local id = pasteIdFrom(url)
if gistRaw then
	candidates = { withCacheBust(gistRaw), gistRaw, url }
elseif id then
	candidates = {
		"https://pastebin.com/raw/" .. id,
		"https://pastebin.com/raw.php?i=" .. id,
		"https://pastebin.com/dl/" .. id,
	}
else
	candidates = { url }
end

print("GameAnalysisAI: fetching script...")

local src, used, lastPreview
for i = 1, #candidates do
	local u = candidates[i]
	print("  try " .. u)
	local body = tryGet(u)
	if type(body) == "string" then
		lastPreview = string.sub(string.gsub(body, "%s+", " "), 1, 80)
		if looksLikeLua(body) then
			src = body
			used = u
			break
		end
	end
end

if not src then
	warn("Preview of what came back: " .. tostring(lastPreview))
	if id then
		error("Pastebin did not return Lua. Private pastes cannot be fetched. Upload GameAnalysisAI.lua as a GitHub Secret Gist and put that URL in this loader.")
	end
	error("Did not get Lua from that URL. Open it in a browser and confirm it starts with -- Game Analysis AI, then use the RAW link.")
end

	print("GameAnalysisAI: got Lua from " .. used .. " (" .. tostring(#src) .. " bytes)")
	if string.find(src, "GAI_FILE_REV=", 1, true) then
		local rev = string.match(src, "GAI_FILE_REV=([%w%.%-]+)")
		print("GameAnalysisAI: file rev " .. tostring(rev))
	end

if string.find(src, "then = true", 1, true) then
	src = string.gsub(src, "([,{%s])then%s*=", '%1["then"] =')
	print("GameAnalysisAI: patched old paste (then = true)")
end
if string.find(src, "end = {", 1, true) then
	src = string.gsub(src, "([,{%s])end%s*=%s*%{", '%1["end"] = {')
	print("GameAnalysisAI: patched old paste (end = {)")
end

local compile = loadstring or load
if type(compile) ~= "function" then
	error("This executor has no loadstring/load")
end

local fn, err = compile(src)
if not fn then
	err = tostring(err)
	if string.find(err, "local registers", 1, true) or string.find(err, "exceeded limit 200", 1, true) then
		error("Lua hit the 200-local limit compiling this file. You already have the new upload if this message mentions bootErr — that is a size bug, not a stale gist. If the file is an older copy, re-upload GameAnalysisAI.lua. Details: " .. err)
	end
	error("Downloaded file is not valid Lua: " .. err)
end

fn()
